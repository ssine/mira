+use super::InputPolicy;
+use super::InputRecovery;
+use codex_rollout::RolloutItem;
+use pretty_assertions::assert_eq;
+use serde_json::json;
+
+#[test]
+fn recovery_preserves_canonical_history_and_new_reasoning() {
+    let values = vec![
+        json!({"type":"response_item","payload":{"type":"message","role":"user","content":[{"type":"input_text","text":"original request"}]}}),
+        json!({"type":"response_item","payload":{"type":"reasoning","summary":[],"encrypted_content":"old"}}),
+        json!({"type":"compacted","payload":{"message":"","replacement_history":[{"type":"compaction","encrypted_content":"old-compact"}]}}),
+        json!({"type":"response_item","payload":{"type":"message","role":"assistant","content":[{"type":"output_text","text":"original answer"}]}}),
+        json!({"type":"response_item","payload":{"type":"reasoning","summary":[],"encrypted_content":"new"}}),
+    ];
+    let canonical: Vec<RolloutItem> = serde_json::from_value(json!(values)).unwrap();
+    let before = serde_json::to_value(&canonical).unwrap();
+    let mut projected = canonical.clone();
+    InputRecovery {
+        through_item_seq: 4,
+        policy: InputPolicy::RebuildContext,
+    }
+    .project(&mut projected)
+    .unwrap();
+    let expected = vec![
+        canonical[0].clone(),
+        canonical[3].clone(),
+        canonical[4].clone(),
+    ];
+    assert_eq!(
+        serde_json::to_value(projected).unwrap(),
+        serde_json::to_value(expected).unwrap()
+    );
+    assert_eq!(serde_json::to_value(canonical).unwrap(), before);
+}
+
+#[test]
+fn stale_prefix_is_rejected_before_changing_input() {
+    let mut items = Vec::new();
+    let result = InputRecovery {
+        through_item_seq: 1,
+        policy: InputPolicy::OmitReasoning,
+    }
+    .project(&mut items);
+    assert!(result.is_err());
+    assert_eq!(items.len(), 0);
+}
