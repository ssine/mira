+#[tokio::test]
+async fn cancelled_write_is_acknowledged_before_flush_and_child_write() {
+    let head = |version| {
+        Some((
+            200,
+            json!({"version": version, "state": {}, "historyManifest": {}}).to_string(),
+        ))
+    };
+    let commit = |version| {
+        Some((
+            200,
+            json!({"version": version, "historyManifest": {}}).to_string(),
+        ))
+    };
+    let (url, mut requests, handle) =
+        server(vec![head(0), None, commit(1), head(1), commit(2)]).await;
+    let store = Arc::new(RemoteHttpThreadStore::new(url, "test", "test-token"));
+    let parent = ThreadId::new();
+    let writer = {
+        let store = Arc::clone(&store);
+        tokio::spawn(async move { store.create_thread(create(parent, None)).await })
+    };
+    let _head = requests.recv().await.unwrap();
+    let first_commit = requests.recv().await.unwrap();
+    writer.abort();
+    assert!(
+        tokio::time::timeout(Duration::from_millis(50), store.flush_thread(parent))
+            .await
+            .is_err()
+    );
+    let child = ThreadId::new();
+    tokio::time::timeout(
+        Duration::from_secs(10),
+        store.create_thread(create(child, Some(parent))),
+    )
+    .await
+    .unwrap()
+    .unwrap();
+    store.flush_thread(child).await.unwrap();
+    assert_eq!(requests.recv().await.unwrap(), first_commit);
+    let _head = requests.recv().await.unwrap();
