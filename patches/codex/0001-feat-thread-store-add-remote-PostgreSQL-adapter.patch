+use super::*;
+use codex_app_server_protocol::MiraThreadResidencyParams;
+use codex_app_server_protocol::MiraThreadResidencyResponse;
+
+impl ThreadRequestProcessor {
+    #[expect(
+        clippy::await_holding_invalid_type,
+        reason = "serialize residency eviction against resume and subscriptions"
+    )]
+    pub(crate) async fn mira_thread_residency(
+        &self,
+        params: MiraThreadResidencyParams,
+    ) -> Result<MiraThreadResidencyResponse, JSONRPCErrorError> {
+        self.thread_state_manager.residency.renew();
+        let _permit = if params.evict.is_some() {
+            Some(self.acquire_thread_list_state_permit().await?)
+        } else {
+            None
+        };
+        let mut pending = self.pending_thread_unloads.lock().await;
+        // Only inspect loaded runtimes. Periodic residency accounting must never read history
+        // or walk the durable agent graph over the network.
+        let mut parents = HashMap::new();
+        let mut protected = HashSet::new();
+        for id in self.thread_manager.list_thread_ids().await {
+            let Ok(thread) = self.thread_manager.get_thread(id).await else {
+                continue;
+            };
+            parents.insert(id, thread.config_snapshot().await.parent_thread_id);
+            if pending.contains(&id)
+                || !self
+                    .thread_state_manager
+                    .subscribed_connection_ids(id)
+                    .await
+                    .is_empty()
+                || matches!(
+                    self.thread_watch_manager
+                        .loaded_status_for_thread(&id.to_string())
+                        .await,
+                    ThreadStatus::Active { .. }
+                )
+                || matches!(thread.agent_status().await, AgentStatus::Running)
+            {
+                protected.insert(id);
+            }
+        }
+        // Protect the whole loaded family while any member is observed or executing. This also
+        // prevents shutting down an idle parent that owns a running child.
+        let mut roots = HashMap::new();
+        for id in parents.keys() {
+            let mut root = *id;
+            let mut seen = HashSet::new();
+            while seen.insert(root) {
+                match parents.get(&root).copied().flatten() {
+                    Some(parent) => root = parent,
+                    None => break,
+                }
+            }
+            roots.insert(*id, root);
+        }
+        let protected_roots: HashSet<_> = protected.iter().filter_map(|id| roots.get(id)).collect();
+        for candidate in self.thread_state_manager.residency.candidates() {
+            let id = ThreadId::from_string(&candidate.thread_id)
+                .map_err(|err| internal_error(err.to_string()))?;
+            if !parents.contains_key(&id)
+                || roots
+                    .get(&id)
+                    .is_some_and(|root| protected_roots.contains(root))
+            {
+                continue;
+            }
+            // Unload leaves first: parent shutdown owns descendant lifecycle.
+            if parents.values().any(|parent| *parent == Some(id)) {
+                continue;
+            }
+            if let Some(requested) = &params.evict {
+                if requested != &candidate {
+                    continue;
+                }
+                let Ok(thread) = self.thread_manager.get_thread(id).await else {
+                    continue;
+                };
+                let reserved_thread_ids: Vec<_> = roots
+                    .iter()
+                    .filter_map(|(member, root)| (Some(root) == roots.get(&id)).then_some(*member))
+                    .collect();
+                pending.extend(reserved_thread_ids.iter().copied());
+                drop(pending);
+                super::thread_lifecycle::unload_thread_without_subscribers(
+                    Arc::clone(&self.thread_manager),
+                    Arc::clone(&self.outgoing),
+                    Arc::clone(&self.pending_thread_unloads),
+                    self.thread_state_manager.clone(),
+                    self.thread_watch_manager.clone(),
+                    id,
+                    thread,
+                    reserved_thread_ids,
+                )
+                .await;
+                return Ok(MiraThreadResidencyResponse {
+                    oldest: None,
+                    eviction_scheduled: true,
+                });
+            }
+            return Ok(MiraThreadResidencyResponse {
+                oldest: Some(candidate),
+                eviction_scheduled: false,
+            });
+        }
+        Ok(MiraThreadResidencyResponse {
+            oldest: None,
+            eviction_scheduled: false,
+        })
+    }
+}
