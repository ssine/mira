+use chrono::Utc;
+use codex_protocol::ThreadId;
+use codex_protocol::protocol::SessionSource;
+use codex_utils_absolute_path::test_support::PathExt;
+use pretty_assertions::assert_eq;
+use serde_json::json;
+
+use super::RemoteHttpThreadStore;
+use super::retry::tests::create;
+use super::retry::tests::server;
+use crate::DeleteThreadParams;
+use crate::InMemoryThreadStore;
+use crate::ThreadStore;
+
+#[tokio::test]
+async fn cancelled_delete_cleans_local_projection_only_after_remote_acknowledgement() {
+    let directory = tempfile::tempdir().unwrap();
+    let state_db = codex_state::StateRuntime::init(
+        codex_state::SqliteConfig::new_for_testing(directory.path().abs()),
+        "test".to_string(),
+    )
+    .await
+    .unwrap();
+    let thread_id = ThreadId::new();
+    let metadata = codex_state::ThreadMetadataBuilder::new(
+        thread_id,
+        directory.path().join("thread.jsonl"),
+        Utc::now(),
+        SessionSource::Cli,
+    )
+    .build("test");
+    state_db.upsert_thread(&metadata).await.unwrap();
+    let persisted = state_db.get_thread(thread_id).await.unwrap();
+    let memory = InMemoryThreadStore::default();
+    memory.create_thread(create(thread_id, None)).await.unwrap();
+    let snapshot = memory
+        .snapshot_for_threads(&[thread_id].into_iter().collect())
+        .await
+        .unwrap();
+    let (state, histories) = super::split_snapshot(snapshot).unwrap();
+    let items = &histories[&thread_id.to_string()];
+    let (url, mut requests, handle) = server(vec![
+        Some((
+            200,
+            json!({"version":1,"state":state,"historyManifest":{
+                (thread_id.to_string()): {"generation":1,"itemCount":items.len()}
+            }})
+            .to_string(),
+        )),
+        Some((
+            200,
+            json!({"generation":1,"itemCount":items.len(),"items":items}).to_string(),
+        )),
+        None,
+        Some((200, json!({"version":2,"historyManifest":{}}).to_string())),
+    ])
+    .await;
+    let store =
+        RemoteHttpThreadStore::new(url, "test", "test-token").with_state_db(Some(state_db.clone()));
+    let writer = store.clone();
+    let caller =
+        tokio::spawn(async move { writer.delete_thread(DeleteThreadParams { thread_id }).await });
+    assert!(requests.recv().await.unwrap().starts_with("GET "));
+    assert!(requests.recv().await.unwrap().starts_with("GET "));
+    let commit = requests.recv().await.unwrap();
+    assert!(commit.starts_with("POST "));
+    assert_eq!(state_db.get_thread(thread_id).await.unwrap(), persisted);
+    caller.abort();
+    assert!(caller.await.unwrap_err().is_cancelled());
+    store.flush_thread(thread_id).await.unwrap();
+    assert_eq!(requests.recv().await.unwrap(), commit);
+    assert_eq!(state_db.get_thread(thread_id).await.unwrap(), None);
+    handle.await.unwrap();
+}
+
+#[tokio::test]
+async fn rejected_remote_delete_keeps_local_projection() {
+    let directory = tempfile::tempdir().unwrap();
+    let state_db = codex_state::StateRuntime::init(
+        codex_state::SqliteConfig::new_for_testing(directory.path().abs()),
+        "test".to_string(),
+    )
+    .await
+    .unwrap();
+    let thread_id = ThreadId::new();
+    let metadata = codex_state::ThreadMetadataBuilder::new(
+        thread_id,
+        directory.path().join("thread.jsonl"),
+        Utc::now(),
+        SessionSource::Cli,
+    )
+    .build("test");
+    state_db.upsert_thread(&metadata).await.unwrap();
+    let persisted = state_db.get_thread(thread_id).await.unwrap();
+    let (url, _requests, handle) = server(vec![Some((403, String::new()))]).await;
+    let store =
+        RemoteHttpThreadStore::new(url, "test", "test-token").with_state_db(Some(state_db.clone()));
+    assert!(
+        store
+            .delete_thread(DeleteThreadParams { thread_id })
+            .await
+            .is_err()
+    );
+    assert_eq!(state_db.get_thread(thread_id).await.unwrap(), persisted);
+    handle.await.unwrap();
+}
