+#[tokio::test]
+async fn memory_lease_keeps_idle_thread_and_rechecks_resubscribed_candidate() -> Result<()> {
+    let server = create_mock_responses_server_repeating_assistant("Done").await;
+    let home = TempDir::new()?;
+    MockResponsesConfig::new(&server.uri())
+        .with_sandbox_mode("danger-full-access")
+        .with_root_config("thread_unload_delay_secs = 1")
+        .with_extra_config(
+            "[experimental_thread_store]\ntype = \"in_memory\"\nid = \"residency-test\"",
+        )
+        .write(home.path())?;
+    let mut client = TestAppServer::builder()
+        .with_codex_home(home.path())
+        .build_initialized()
+        .await?;
+    let started = client
+        .start_thread(ThreadStartParams {
+            developer_instructions: Some("Residency test instructions".into()),
+            ..Default::default()
+        })
+        .await?;
+    let id = started.thread.id;
+    assert_eq!(residency(&mut client, None).await?.oldest, None);
+    let _: ThreadUnsubscribeResponse = client
+        .request(|request_id| ClientRequest::ThreadUnsubscribe {
+            request_id,
+            params: ThreadUnsubscribeParams {
+                thread_id: id.clone(),
+            },
+        })
+        .await?;
+    tokio::time::sleep(Duration::from_millis(1200)).await;
+    let candidate = residency(&mut client, None)
+        .await?
+        .oldest
+        .expect("idle thread retained past timeout");
+    assert_eq!(candidate.thread_id, id);
+    let loaded: ThreadLoadedListResponse = client
+        .request(|request_id| ClientRequest::ThreadLoadedList {
+            request_id,
