diff --git a/codex-rs/thread-store/src/remote_http/spawn_edges.rs b/codex-rs/thread-store/src/remote_http/spawn_edges.rs
new file mode 100644
index 0000000000..37d6208b92
--- /dev/null
+++ b/codex-rs/thread-store/src/remote_http/spawn_edges.rs
@@ -0,0 +1,84 @@
+//! Mira Server accepts a spawn edge only after both threads exist. Upstream publishes the
+//! edge before it creates the child, so an edge for a child this store has neither created
+//! nor resumed is held until that creation commits, then written by the same ordered writer.
+//! Durable `parent_thread_id` metadata still records the relationship if the edge is lost.
+
+use std::collections::HashMap;
+use std::collections::HashSet;
+use std::sync::PoisonError;
+
+use codex_protocol::ThreadId;
+
+use super::RemoteHttpThreadStore;
+use crate::ThreadStoreResult;
+
+#[derive(Default)]
+pub(super) struct SpawnEdges {
+    /// Threads created or resumed through this store, so they exist remotely.
+    opened: HashSet<ThreadId>,
+    /// Child thread ID -> (parent thread ID, upsert body) awaiting the child's creation.
+    pending: HashMap<ThreadId, (ThreadId, serde_json::Value)>,
+}
+
+impl RemoteHttpThreadStore {
+    /// Opens a spawn edge now, or as soon as this store creates its child.
+    pub async fn write_thread_spawn_edge(
+        &self,
+        parent_thread_id: ThreadId,
+        child_thread_id: ThreadId,
+        body: serde_json::Value,
+    ) -> ThreadStoreResult<()> {
+        {
+            let mut edges = self
+                .spawn_edges
+                .lock()
+                .unwrap_or_else(PoisonError::into_inner);
+            if !edges.opened.contains(&child_thread_id) {
+                edges
+                    .pending
+                    .insert(child_thread_id, (parent_thread_id, body));
+                return Ok(());
+            }
+        }
+        self.write_agent_graph(vec![parent_thread_id, child_thread_id], body)
+            .await
+    }
+
+    /// Changes the status of a still-pending edge locally; otherwise writes it.
+    pub async fn write_thread_spawn_edge_status(
+        &self,
+        child_thread_id: ThreadId,
+        body: serde_json::Value,
+    ) -> ThreadStoreResult<()> {
+        {
+            let mut edges = self
+                .spawn_edges
+                .lock()
+                .unwrap_or_else(PoisonError::into_inner);
+            if let Some((_, pending)) = edges.pending.get_mut(&child_thread_id) {
+                pending["status"] = body["status"].clone();
+                return Ok(());
+            }
+        }
+        self.write_agent_graph(vec![child_thread_id], body).await
+    }
+
+    /// Records that a thread exists remotely and publishes an edge waiting for it.
+    pub(super) async fn thread_opened(&self, thread_id: ThreadId) -> ThreadStoreResult<()> {
+        let pending = {
+            let mut edges = self
+                .spawn_edges
+                .lock()
+                .unwrap_or_else(PoisonError::into_inner);
+            edges.opened.insert(thread_id);
+            edges.pending.remove(&thread_id)
+        };
+        match pending {
+            Some((parent_thread_id, body)) => {
+                self.write_agent_graph(vec![parent_thread_id, thread_id], body)
+                    .await
+            }
+            None => Ok(()),
+        }
+    }
+}
diff --git a/codex-rs/thread-store/src/remote_http/uploads.rs b/codex-rs/thread-store/src/remote_http/uploads.rs
new file mode 100644
index 0000000000..2bca717789
--- /dev/null
+++ b/codex-rs/thread-store/src/remote_http/uploads.rs
@@ -0,0 +1,146 @@
+use super::CommitRequest;
+use super::RemoteHttpThreadStore;
+use super::request_json;
+use crate::ThreadStoreError;
+use crate::ThreadStoreResult;
+use serde::Serialize;
+use std::io::Write;
+use std::sync::OnceLock;
+use std::time::Duration;
+use tokio::sync::broadcast;
+
+const CHUNK_BYTES: usize = 4 * 1024 * 1024;
+const STAGE_THRESHOLD: u64 = 8 * 1024 * 1024;
+
+/// Ephemeral transport telemetry; never part of canonical conversation history.
+#[derive(Clone, Debug, Serialize)]
+#[serde(rename_all = "camelCase")]
+pub struct RemoteHistoryProgress {
+    pub thread_id: String,
+    pub upload_id: String,
+    pub phase: String,
+    pub completed_bytes: u64,
+    pub total_bytes: u64,
+}
+fn progress_bus() -> &'static broadcast::Sender<RemoteHistoryProgress> {
+    static BUS: OnceLock<broadcast::Sender<RemoteHistoryProgress>> = OnceLock::new();
+    BUS.get_or_init(|| broadcast::channel(64).0)
+}
+pub fn subscribe_remote_history_progress() -> broadcast::Receiver<RemoteHistoryProgress> {
+    progress_bus().subscribe()
+}
+fn report(value: &RemoteHistoryProgress) {
+    let _ = progress_bus().send(value.clone());
+}
+
+#[derive(Default)]
+struct ByteCount(u64);
+impl Write for ByteCount {
+    fn write(&mut self, buf: &[u8]) -> std::io::Result<usize> {
+        self.0 += buf.len() as u64;
+        Ok(buf.len())
+    }
+    fn flush(&mut self) -> std::io::Result<()> {
+        Ok(())
+    }
+}
+fn serialization_error(error: serde_json::Error) -> ThreadStoreError {
+    ThreadStoreError::Internal {
+        message: error.to_string(),
+    }
+}
+impl RemoteHttpThreadStore {
+    pub(super) async fn stage_large_histories(
+        &self,
+        request: &mut CommitRequest,
+    ) -> ThreadStoreResult<()> {
+        let mut size = ByteCount::default();
+        serde_json::to_writer(&mut size, &request).map_err(serialization_error)?;
+        if size.0 <= STAGE_THRESHOLD {
+            return Ok(());
+        }
+        for change in &mut request.history_changes {
+            let Some(items) = change.items.as_ref() else {
+                continue;
+            };
+            if items.is_empty() {
+                continue;
+            }
+            let mut size = ByteCount::default();
+            for item in items {
+                serde_json::to_writer(&mut size, item).map_err(serialization_error)?;
+                size.0 += 1; // newline between independent JSON records
+            }
+            let upload_id = codex_protocol::ThreadId::new().to_string();
+            let url = format!("{}/history-uploads/{upload_id}", self.store_url);
+            let mut progress = RemoteHistoryProgress {
+                thread_id: change.thread_id.clone(),
+                upload_id: upload_id.clone(),
+                phase: "uploading".into(),
+                completed_bytes: 0,
+                total_bytes: size.0,
+            };
+            let _: serde_json::Value = request_json(self.client.post(&url).headers(self.account_headers.clone()).bearer_auth(&self.bearer_token)
+                .timeout(Duration::from_secs(30)).json(&serde_json::json!({"threadId": change.thread_id, "itemCount": items.len(), "totalBytes": size.0}))).await?;
+            report(&progress);
+            let mut chunk = Vec::with_capacity(CHUNK_BYTES);
+            for item in items {
+                // The store already owns these records. Serialize one at a time,
+                // including records larger than a transport chunk.
+                let mut raw = serde_json::to_vec(item).map_err(serialization_error)?;
+                raw.push(b'\n');
+                let mut remaining = raw.as_slice();
+                while !remaining.is_empty() {
+                    let count = (CHUNK_BYTES - chunk.len()).min(remaining.len());
+                    chunk.extend_from_slice(&remaining[..count]);
+                    remaining = &remaining[count..];
+                    if chunk.len() == CHUNK_BYTES {
+                        self.send_history_chunk(&url, &mut chunk, &mut progress)
+                            .await?;
+                    }
+                }
+            }
+            if !chunk.is_empty() {
+                self.send_history_chunk(&url, &mut chunk, &mut progress)
+                    .await?;
+            }
+            progress.phase = "verifying".into();
+            report(&progress);
+            let _: serde_json::Value = request_json(
+                self.client
+                    .post(format!("{url}/seal"))
+                    .headers(self.account_headers.clone())
+                    .bearer_auth(&self.bearer_token)
+                    .timeout(Duration::from_secs(120)),
+            )
+            .await?;
+            change.items = None;
+            change.items_upload_id = Some(upload_id);
+            progress.phase = "committing".into();
+            report(&progress);
+        }
+        Ok(())
+    }
+    async fn send_history_chunk(
+        &self,
+        url: &str,
+        chunk: &mut Vec<u8>,
+        progress: &mut RemoteHistoryProgress,
+    ) -> ThreadStoreResult<()> {
+        let count = chunk.len() as u64;
+        let body = std::mem::replace(chunk, Vec::with_capacity(CHUNK_BYTES));
+        let _: serde_json::Value = request_json(
+            self.client
+                .put(format!("{url}?offset={}", progress.completed_bytes))
+                .headers(self.account_headers.clone())
+                .bearer_auth(&self.bearer_token)
+                .timeout(Duration::from_secs(30))
+                .header("content-type", "application/octet-stream")
+                .body(body),
+        )
+        .await?;
+        progress.completed_bytes += count;
+        report(progress);
+        Ok(())
+    }
+}
diff --git a/codex-rs/thread-store/src/remote_http/writer.rs b/codex-rs/thread-store/src/remote_http/writer.rs
new file mode 100644
index 0000000000..79cfd1eaf4
--- /dev/null
+++ b/codex-rs/thread-store/src/remote_http/writer.rs
@@ -0,0 +1,409 @@
+use std::collections::HashSet;
+
+use codex_protocol::ThreadId;
+
+use super::CommitRequest;
+use super::CommitResponse;
+use super::HistoryChange;
+use super::ReadScope;
+use super::RemoteHttpThreadStore;
+use super::cache;
+use super::cache_missing;
+use super::request_json;
+use crate::AppendThreadItemsParams;
+use crate::InMemoryThreadStore;
+use crate::LoadThreadHistoryParams;
+use crate::ThreadStoreError;
+use crate::ThreadStoreFuture;
+use crate::ThreadStoreResult;
+use codex_protocol::protocol::ThreadHistoryMode;
+use codex_rollout::RolloutItem;
+use codex_rollout::persisted_rollout_items;
+use std::time::Duration;
+
+// Per-thread writers outlive cancelled callers, but have no local durable outbox.
+impl RemoteHttpThreadStore {
+    pub(super) async fn delete_records(
+        &self,
+        params: crate::DeleteThreadParams,
+    ) -> ThreadStoreResult<()> {
+        let thread_id = params.thread_id;
+        self.enqueue_write(vec![thread_id], move |store| {
+            Box::pin(async move {
+                let deleted_remote = store
+                    .mutate_inner(vec![thread_id], true, move |memory| {
+                        Box::pin(async move {
+                            match crate::ThreadStore::delete_thread(memory, params).await {
+                                Ok(()) => Ok(true),
+                                Err(ThreadStoreError::ThreadNotFound { .. }) => Ok(false),
+                                Err(error) => Err(error),
+                            }
+                        })
+                    })
+                    .await?;
+                // Canonical acknowledgement must precede projection cleanup. Both
+                // remain in the owned writer even if the requesting client cancels.
+                let deleted_state = if let Some(state_db) = &store.state_db {
+                    state_db
+                        .delete_threads_strict(&[thread_id])
+                        .await
+                        .map_err(|error| ThreadStoreError::Internal {
+                            message: format!(
+                                "failed to clean local thread state after remote deletion: {error}"
+                            ),
+                        })?
+                } else {
+                    0
+                };
+                if deleted_remote || deleted_state > 0 {
+                    Ok(())
+                } else {
+                    Err(ThreadStoreError::ThreadNotFound { thread_id })
+                }
+            })
+        })
+        .await
+    }
+
+    /// Graph mutations share the history writer queue and survive caller cancellation.
+    pub async fn write_agent_graph(
+        &self,
+        thread_ids: Vec<ThreadId>,
+        body: serde_json::Value,
+    ) -> ThreadStoreResult<()> {
+        self.enqueue_write(thread_ids.clone(), move |store| {
+            Box::pin(async move {
+                store
+                    .request_agent_graph(body)
+                    .await
+                    .map(|_| ())
+                    .inspect_err(|error| store.record_write_error(error, &thread_ids))
+            })
+        })
+        .await
+    }
+
+    pub(super) async fn mutate_after<T: Send + 'static>(
+        &self,
+        thread_ids: Vec<ThreadId>,
+        mut dependencies: Vec<ThreadId>,
+        operation: impl for<'a> FnOnce(&'a InMemoryThreadStore) -> ThreadStoreFuture<'a, T>
+        + Send
+        + 'static,
+    ) -> ThreadStoreResult<T> {
+        dependencies.extend_from_slice(&thread_ids);
+        self.enqueue_operation(dependencies, move |store| {
+            Box::pin(async move {
+                // Ordering on a parent does not inherit a parent's scoped fence.
+                store.check_thread_write_errors(&thread_ids)?;
+                store.mutate_inner(thread_ids, true, operation).await
+            })
+        })
+        .await
+    }
+
+    pub(super) async fn mutate_metadata<T: Send + 'static>(
+        &self,
+        thread_id: ThreadId,
+        operation: impl for<'a> FnOnce(&'a InMemoryThreadStore) -> ThreadStoreFuture<'a, T>
+        + Send
+        + 'static,
+    ) -> ThreadStoreResult<T> {
+        self.mutate_scoped(vec![thread_id], false, operation).await
+    }
+
+    async fn mutate_scoped<T: Send + 'static>(
+        &self,
+        thread_ids: Vec<ThreadId>,
+        load_histories: bool,
+        operation: impl for<'a> FnOnce(&'a InMemoryThreadStore) -> ThreadStoreFuture<'a, T>
+        + Send
+        + 'static,
+    ) -> ThreadStoreResult<T> {
+        self.enqueue_write(thread_ids.clone(), move |store| {
+            Box::pin(async move {
+                store
+                    .mutate_inner(thread_ids, load_histories, operation)
+                    .await
+            })
+        })
+        .await
+    }
+
+    async fn enqueue_write<T: Send + 'static>(
+        &self,
+        thread_ids: Vec<ThreadId>,
+        operation: impl FnOnce(Self) -> ThreadStoreFuture<'static, T> + Send + 'static,
+    ) -> ThreadStoreResult<T> {
+        self.enqueue_operation(thread_ids.clone(), move |store| {
+            Box::pin(async move {
+                store.check_thread_write_errors(&thread_ids)?;
+                operation(store.clone()).await
+            })
+        })
+        .await
+    }
+
+    pub(super) async fn append_records(
+        &self,
+        params: AppendThreadItemsParams,
+    ) -> ThreadStoreResult<()> {
+        let thread_id = params.thread_id;
+        self.enqueue_write(vec![thread_id], move |store| {
+            Box::pin(async move {
+                let result = async {
+                    let head = store.head_for_thread(Some(thread_id)).await?;
+                    let key = thread_id.to_string();
+                    let entry = head
+                        .history_manifest
+                        .get(&key)
+                        .ok_or(ThreadStoreError::ThreadNotFound { thread_id })?;
+                    let mode = head
+                        .state
+                        .pointer(&format!("/created_threads/{key}/history_mode"))
+                        .cloned()
+                        .and_then(|value| serde_json::from_value::<ThreadHistoryMode>(value).ok())
+                        .unwrap_or(ThreadHistoryMode::Legacy);
+                    let mut items = persisted_rollout_items(&params.items, mode);
+                    if items.is_empty() {
+                        return Ok(());
+                    }
+                    if items
+                        .iter()
+                        .any(|item| matches!(item, RolloutItem::Compacted(_)))
+                    {
+                        // Like upstream's local and in-memory stores, a checkpoint records the
+                        // next model-facing ID ordinal of the canonical history it follows.
+                        // Stamp before commit so PostgreSQL and the cache hold the same bytes.
+                        let history = store
+                            .read_inner(ReadScope::ThreadWithHistory(thread_id), move |cached| {
+                                crate::ThreadStore::load_history(
+                                    cached,
+                                    LoadThreadHistoryParams {
+                                        thread_id,
+                                        include_archived: true,
+                                    },
+                                )
+                            })
+                            .await?
+                            .items;
+                        codex_rollout::stamp_item_ordinals(
+                            codex_rollout::next_model_id_ordinals(&history).0,
+                            &mut items,
+                        );
+                    }
+                    let values = items
+                        .iter()
+                        .map(serde_json::to_value)
+                        .collect::<Result<Vec<_>, _>>()
+                        .map_err(|error| ThreadStoreError::Internal {
+                            message: error.to_string(),
+                        })?;
+                    let mut request = CommitRequest {
+                        expected_version: head.version,
+                        state_changes: Vec::new(),
+                        history_changes: vec![HistoryChange {
+                            thread_id: key.clone(),
+                            mode: "append",
+                            expected_generation: entry.generation,
+                            expected_item_count: entry.item_count,
+                            items: Some(values),
+                            items_upload_id: None,
+                        }],
+                    };
+                    store.stage_large_histories(&mut request).await?;
+                    let committed: CommitResponse = request_json(
+                        store
+                            .client
+                            .post(format!("{}/commits", store.store_url))
+                            .headers(store.account_headers.clone())
+                            .bearer_auth(&store.bearer_token)
+                            .header("x-codex-operation-id", ThreadId::new().to_string())
+                            .header("x-codex-version", env!("CARGO_PKG_VERSION"))
+                            .header("x-mira-thread-scope", key.clone())
+                            .timeout(Duration::from_secs(120))
+                            .json(&request),
+                    )
+                    .await?;
+                    // Extend only a prefix validated by this scoped head, and
+                    // only after canonical acknowledgement.
+                    let expected = super::HistoryManifestEntry {
+                        generation: entry.generation,
+                        item_count: entry.item_count + items.len(),
+                    };
+                    if let Some(mut cached) = store.take_cache(Some(thread_id))
+                        && cached.loaded_histories.contains(&thread_id)
+                        && cached.history_manifest.get(&key) == Some(entry)
+                        && committed.history_manifest.get(&key) == Some(&expected)
+                    {
+                        let bytes = cache::serialized_size(&items);
+                        crate::ThreadStore::append_items(
+                            &cached.store,
+                            AppendThreadItemsParams { thread_id, items },
+                        )
+                        .await?;
+                        let previous = cached.history_bytes.entry(thread_id).or_default();
+                        *previous = previous.saturating_add(bytes);
+                        // Force metadata validation even if rebase included a
+                        // concurrent metadata change, retaining only this prefix.
+                        cached.version = 0;
+                        cached.history_manifest.insert(key, expected);
+                        store.replace_cache(Some(cached));
+                    }
+                    Ok(())
+                }
+                .await;
+                if let Err(error) = &result {
+                    store.take_cache(Some(thread_id));
+                    store.record_write_error(error, &[thread_id]);
+                }
+                result
+            })
+        })
+        .await
+    }
+
+    pub(super) fn record_write_error(&self, error: &ThreadStoreError, thread_ids: &[ThreadId]) {
+        // A deleted thread can be absent from a successful scoped head response,
+        // producing ThreadNotFound locally instead of an HTTP request rejection.
+        // Fence its writes just like a 404, without poisoning the shared runtime.
+        if matches!(
+            error,
+            ThreadStoreError::Conflict { .. }
+                | ThreadStoreError::InvalidRequest { .. }
+                | ThreadStoreError::ThreadNotFound { .. }
+        ) && !thread_ids.is_empty()
+        {
+            let mut failures = self
+                .thread_write_errors
+                .lock()
+                .unwrap_or_else(std::sync::PoisonError::into_inner);
+            for thread_id in thread_ids {
+                failures
+                    .entry(*thread_id)
+                    .or_insert_with(|| error.to_string());
+            }
+            return;
+        }
+        let mut failure = self
+            .write_error
+            .lock()
+            .unwrap_or_else(std::sync::PoisonError::into_inner);
+        if failure.is_none() {
+            *failure = Some(error.to_string());
+        }
+    }
+
+    pub(super) fn check_write_error(&self) -> ThreadStoreResult<()> {
+        match self
+            .write_error
+            .lock()
+            .unwrap_or_else(std::sync::PoisonError::into_inner)
+            .as_ref()
+        {
+            Some(message) => Err(ThreadStoreError::Internal {
+                message: format!(
+                    "conversation storage failed; fix the connection/permissions and restart the runtime: {message}"
+                ),
+            }),
+            None => Ok(()),
+        }
+    }
+
+    pub(super) fn check_thread_write_errors(
+        &self,
+        thread_ids: &[ThreadId],
+    ) -> ThreadStoreResult<()> {
+        self.check_write_error()?;
+        let failures = self
+            .thread_write_errors
+            .lock()
+            .unwrap_or_else(std::sync::PoisonError::into_inner);
+        for thread_id in thread_ids {
+            if let Some(message) = failures.get(thread_id) {
+                return Err(ThreadStoreError::Conflict {
+                    message: format!(
+                        "conversation {thread_id} storage write failed; this conversation is paused to protect history; resolve the error and restart the runtime: {message}"
+                    ),
+                });
+            }
+        }
+        Ok(())
+    }
+
+    async fn mutate_inner<T: Send>(
+        &self,
+        thread_ids: Vec<ThreadId>,
+        load_histories: bool,
+        operation: impl for<'a> FnOnce(&'a InMemoryThreadStore) -> ThreadStoreFuture<'a, T> + Send,
+    ) -> ThreadStoreResult<T> {
+        let scope = (thread_ids.len() == 1).then(|| thread_ids[0]);
+        let mut cache = self.take_cache(scope);
+        let mut invalidate_cache = false;
+        let result = async {
+            self.refresh_scoped(&mut cache, (thread_ids.len() == 1).then(|| thread_ids[0]))
+                .await
+                .inspect_err(|error| self.record_write_error(error, &thread_ids))?;
+            let cached = cache.as_mut().ok_or_else(cache_missing)?;
+            let selected = if load_histories {
+                thread_ids.iter().copied().collect::<HashSet<_>>()
+            } else {
+                HashSet::new()
+            };
+            for thread_id in &selected {
+                self.ensure_history(cached, *thread_id)
+                    .await
+                    .inspect_err(|error| self.record_write_error(error, &thread_ids))?;
+            }
+            let before = cached.store.snapshot_for_threads(&selected).await?;
+            let output = match operation(&cached.store).await {
+                Ok(output) => output,
+                Err(error) => {
+                    invalidate_cache = true;
+                    return Err(error);
+                }
+            };
+            let after = cached.store.snapshot_for_threads(&selected).await?;
+            for thread_id in &selected {
+                if let Some(history) = after.pointer(&format!("/histories/{thread_id}")) {
+                    cached
+                        .history_bytes
+                        .insert(*thread_id, cache::serialized_size(history));
+                }
+            }
+            match self
+                .save(
+                    cached.version,
+                    cached.scope,
+                    &cached.history_manifest,
+                    &mut cached.canonical_state,
+                    before,
+                    after,
+                )
+                .await
+            {
+                Ok(Some(committed)) => {
+                    cached.version = if committed.rebased {
+                        0
+                    } else {
+                        committed.version
+                    };
+                    cached.history_manifest = committed.history_manifest;
+                }
+                Ok(None) => {}
+                Err(error) => {
+                    invalidate_cache = true;
+                    self.record_write_error(&error, &thread_ids);
+                    return Err(error);
+                }
+            }
+            Ok(output)
+        }
+        .await;
+        if invalidate_cache {
+            cache = None;
+        }
+        self.replace_cache(cache);
+        result
+    }
+}
