+        .and(body_string_contains("residency child work"))
+        .and(|request: &wiremock::Request| {
+            !String::from_utf8_lossy(&request.body).contains("residency-spawn-call")
+        })
+        .respond_with(
+            ResponseTemplate::new(200)
+                .insert_header("content-type", "text/event-stream")
+                .set_body_string(responses::sse(vec![responses::ev_completed("child-done")]))
