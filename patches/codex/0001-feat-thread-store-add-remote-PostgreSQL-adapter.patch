@@ -0,0 +1,77 @@
+use super::*;
+use codex_app_server_protocol::MiraThreadRecoverParams;
+use codex_app_server_protocol::MiraThreadRecoverResponse;
+
+impl TurnRequestProcessor {
+    pub(crate) async fn mira_thread_recover(
+        &self,
+        request_id: ConnectionRequestId,
+        params: MiraThreadRecoverParams,
+    ) -> Result<MiraThreadRecoverResponse, JSONRPCErrorError> {
+        if params.probe {
+            return Ok(MiraThreadRecoverResponse {
+                version: 1,
+                turn: None,
+            });
+        }
+        if params.failure_id.is_empty() || params.expected_turn_id.is_empty() {
+            return Err(invalid_request("failureId and expectedTurnId are required"));
+        }
+        let (thread_id, thread) = self.load_thread(&params.thread_id).await?;
+        {
+            let mut pending = self.pending_thread_unloads.lock().await;
+            if !pending.insert(thread_id) {
+                return Err(invalid_request("thread is closing; retry after resume"));
+            }
+        }
+        // Unlike turn/start this accepts no caller input or setting overrides.
+        // Core validates the durable decision and failed-turn identity in its
+        // submission loop, which also serializes parent-driven child followups.
+        let pending = Arc::clone(&self.pending_thread_unloads);
+        // Keep the selected-thread reservation through the reply even if the
+        // caller disconnects. Other conversations can continue accepting turns.
+        let submission = tokio::spawn(async move {
+            let result = tokio::spawn(async move {
+                thread
+                    .mira_recover_input(params.expected_turn_id, params.failure_id)
+                    .await
+            })
+            .await
+            .unwrap_or_else(|err| {
+                Err(codex_protocol::error::CodexErr::Fatal(format!(
+                    "input recovery task failed: {err}"
+                )))
+            });
+            pending.lock().await.remove(&thread_id);
+            result
+        })
+        .await
+        .map_err(|err| internal_error(format!("input recovery worker failed: {err}")))?
+        .map_err(|err| invalid_request(format!("input recovery rejected: {err}")))?;
+        let turn_id = match submission {
+            TurnInputSubmission::Started { turn_id } => turn_id,
+            TurnInputSubmission::NotSubmitted { reason } => {
+                return Err(invalid_request(format!(
+                    "input recovery not submitted: {reason:?}"
+                )));
+            }
+            TurnInputSubmission::Steered { .. } => unreachable!("input recovery never steers"),
+        };
+        self.outgoing
+            .record_request_turn_id(&request_id, &turn_id)
+            .await;
+        Ok(MiraThreadRecoverResponse {
+            version: 1,
+            turn: Some(Turn {
+                id: turn_id,
+                items: vec![],
+                items_view: TurnItemsView::NotLoaded,
+                error: None,
+                status: TurnStatus::InProgress,
+                started_at: None,
+                completed_at: None,
+                duration_ms: None,
+            }),
+        })
+    }
+}
