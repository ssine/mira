+use super::*;
+use codex_protocol::models::FunctionCallOutputPayload;
+use pretty_assertions::assert_eq;
+use serde_json::json;
+
+fn item(value: serde_json::Value) -> ResponseItem {
+    serde_json::from_value(value).unwrap()
+}
+
+fn image() -> serde_json::Value {
+    json!({"type":"input_image","image_url":"data:image/png;base64,fixture"})
+}
+
+#[test]
+fn retains_new_tool_outputs_and_their_calls_verbatim() {
+    let items: Vec<_> = vec![
+        item(json!({"type":"message","role":"user","content":[image(),image()]})),
+        item(json!({"type":"function_call","call_id":"a","name":"screen","arguments":"{}"})),
+        item(json!({"type":"function_call","call_id":"b","name":"screen","arguments":"{}"})),
+        item(json!({"type":"function_call_output","call_id":"a","output":[image(),{"type":"input_text","text":"result a"}]})),
+        item(json!({"type":"function_call_output","call_id":"b","output":[image()]})),
+    ].into_iter().map(ResponseItemEnvelope::new).collect();
+    let pending = prepare_image_compaction(&items, 3).unwrap();
+    assert_eq!(
+        (pending.prefix, pending.pending),
+        (items[..1].to_vec(), items[1..].to_vec())
+    );
+    assert!(prepare_image_compaction(&items, 0).is_none());
+    assert!(prepare_image_compaction(&items, 5).is_none());
+}
+
+#[test]
+fn oversized_fresh_input_is_not_discarded_and_does_not_loop() {
+    let original = vec![ResponseItemEnvelope::new(item(
+        json!({"type":"message","role":"user","content":[image(),image(),image()]}),
+    ))];
+    let items = original.clone();
+    assert!(prepare_image_compaction(&items, 2).is_none());
+    assert!(prepare_image_compaction(&items, 3).is_none());
+    assert_eq!(items, original);
+}
+
+#[test]
+fn safety_projection_counts_message_and_custom_tool_images_preserving_text_and_metadata() {
+    let mut items = vec![
+        item(
+            json!({"type":"message","id":"old","role":"user","content":[{"type":"input_text","text":"unchanged"},image(),image()],"internal_chat_message_metadata_passthrough":{"content_item_kinds":["user.text","user.image","user.image"]}}),
+        ),
+        item(
+            json!({"type":"custom_tool_call_output","id":"output","call_id":"call","output":[{"type":"input_text","text":"tool text"},image(),image()]}),
+        ),
+    ];
+    let original = items.clone();
+    limit_compaction_images(&mut items, 2);
+    assert_eq!(image_count(items.iter()), 2);
+    assert_eq!(items[1], original[1]);
+    let ResponseItem::Message {
+        content,
+        internal_chat_message_metadata_passthrough,
+        ..
+    } = &items[0]
+    else {
+        panic!("message")
+    };
+    assert_eq!(
+        content,
+        &vec![
+            ContentItem::InputText {
+                text: "unchanged".into()
+            },
+            ContentItem::InputText {
+                text: OMITTED_IMAGE.into()
+            },
+            ContentItem::InputText {
+                text: OMITTED_IMAGE.into()
+            }
+        ]
+    );
+    assert_eq!(
+        internal_chat_message_metadata_passthrough
+            .as_ref()
+            .unwrap()
+            .content_item_kinds
+            .as_ref()
+            .unwrap(),
+        &vec![
+            ContentItemKind("user.text".into()),
+            ContentItemKind("images.compaction_omitted".into()),
+            ContentItemKind("images.compaction_omitted".into())
+        ]
+    );
+    limit_compaction_images(&mut items, 1);
+    let ResponseItem::CustomToolCallOutput { output, .. } = &items[1] else {
+        panic!("tool")
+    };
+    let expected: FunctionCallOutputPayload = serde_json::from_value(json!([{"type":"input_text","text":"tool text"},{"type":"input_text","text":OMITTED_IMAGE},image()])).unwrap();
+    assert_eq!(output, &expected);
+}
+
+#[test]
+fn partial_failed_summary_does_not_mark_fresh_images_as_consumed() {
+    let mut items: Vec<_> = vec![
+        item(json!({"type":"message","role":"user","content":[image(),image()]})),
+        item(json!({"type":"message","role":"assistant","content":[{"type":"output_text","text":"old read"}]})),
+        item(json!({"type":"message","role":"user","content":[image()]})),
+        item(json!({"type":"message","role":"assistant","content":[{"type":"output_text","text":"partial summary"}]})),
+    ].into_iter().map(ResponseItemEnvelope::new).collect();
+    items[3].metadata = Some(codex_history::CodexHarnessMetadata {
+        compaction_output: true,
+        ..Default::default()
+    });
+    let plan = prepare_image_compaction(&items, 3).unwrap();
+    assert_eq!(
+        (plan.prefix, plan.pending),
+        (items[..2].to_vec(), items[2..].to_vec())
+    );
+}
