+    store.stage_large_histories(&mut request).await.unwrap();
+    handle.await.unwrap();
+    let mut received = vec![];
+    while let Some(request) = requests.recv().await {
+        received.push(request);
+    }
+    assert_eq!(received.len(), 6);
+    assert_eq!(
+        received[1], received[2],
+        "a lost chunk response must replay identical bytes and offset"
+    );
+    let body = |index: usize| received[index].split_once("\r\n\r\n").unwrap().1;
+    for index in [1, 3, 4] {
+        assert!(body(index).len() <= 4 * 1024 * 1024);
