diff --git a/codex-rs/codex-api/tests/encrypted_context_retry.rs b/codex-rs/codex-api/tests/encrypted_context_retry.rs
new file mode 100644
index 000000000..060c17163
--- /dev/null
+++ b/codex-rs/codex-api/tests/encrypted_context_retry.rs
@@ -0,0 +1,97 @@
+use codex_client::Request;
+use codex_client::RetryOn;
+use codex_client::RetryPolicy;
+use codex_client::TransportError;
+use codex_client::run_with_retry;
+use http::Method;
+use http::StatusCode;
+use pretty_assertions::assert_eq;
+use std::sync::atomic::AtomicUsize;
+use std::sync::atomic::Ordering;
+use std::time::Duration;
+
+#[tokio::test]
+async fn encrypted_context_500_returns_the_first_error_without_http_retries() {
+    for code in ["invalid_encrypted_content", "unknown_reasoning_pool"] {
+        let attempts = AtomicUsize::new(0);
+        let body = format!(
+            r#"{{"error":{{"code":"{code}","message":"Cannot verify encrypted context."}}}}"#
+        );
+        let result: Result<(), _> = run_with_retry(
+            RetryPolicy {
+                max_attempts: 4,
+                base_delay: Duration::ZERO,
+                retry_on: RetryOn {
+                    retry_429: true,
+                    retry_5xx: true,
+                    retry_transport: true,
+                },
+            },
+            || {
+                Request::new(
+                    Method::POST,
+                    "https://example.test/v1/responses".to_string(),
+                )
+            },
+            |_, _| {
+                attempts.fetch_add(1, Ordering::SeqCst);
+                let body = body.clone();
+                async move {
+                    Err(TransportError::Http {
+                        retry_after: None,
+                        status: StatusCode::INTERNAL_SERVER_ERROR,
+                        url: None,
+                        headers: None,
+                        body: Some(body),
+                    })
+                }
+            },
+        )
+        .await;
+        let Err(TransportError::Http {
+            status,
+            body: Some(actual),
+            ..
+        }) = result
+        else {
+            panic!("expected original HTTP error");
+        };
+        assert_eq!(
+            (attempts.load(Ordering::SeqCst), status, actual),
+            (1, StatusCode::INTERNAL_SERVER_ERROR, body)
+        );
+    }
+}
+
+#[test]
+fn retry_policy_keeps_transient_errors_and_does_not_match_message_text() {
+    let retry = RetryOn {
+        retry_429: true,
+        retry_5xx: true,
+        retry_transport: true,
+    };
+    for status in [
+        StatusCode::TOO_MANY_REQUESTS,
+        StatusCode::INTERNAL_SERVER_ERROR,
+        StatusCode::BAD_GATEWAY,
+        StatusCode::SERVICE_UNAVAILABLE,
+    ] {
+        for body in [
+            None,
+            Some(r#"{"error":{"code":"server_error","message":"invalid_encrypted_content"}}"#),
+            Some(r#"{"code":"invalid_encrypted_content"}"#),
+            Some(r#"{"error":{"code":500}}"#),
+            Some("invalid_encrypted_content"),
+        ] {
+            let err = TransportError::Http {
+                retry_after: None,
+                status,
+                url: None,
+                headers: None,
+                body: body.map(str::to_owned),
+            };
+            assert!(retry.should_retry(&err, /*attempt*/ 0, /*max_attempts*/ 4));
+            assert!(!retry.should_retry(&err, /*attempt*/ 4, /*max_attempts*/ 4));
+        }
+    }
+}
