diff --git a/codex-rs/core/tests/suite/mira_reasoning_recovery.rs b/codex-rs/core/tests/suite/mira_reasoning_recovery.rs
new file mode 100644
index 000000000..c78a5b225
--- /dev/null
+++ b/codex-rs/core/tests/suite/mira_reasoning_recovery.rs
@@ -0,0 +1,239 @@
+use anyhow::Result;
+use codex_protocol::protocol::EventMsg;
+use codex_protocol::protocol::MiraReasoningRecovery;
+use codex_protocol::protocol::Op;
+use core_test_support::responses::*;
+use core_test_support::test_codex::test_codex;
+use core_test_support::wait_for_event;
+use pretty_assertions::assert_eq;
+use serde_json::json;
+
+const REJECTED: &str = "The encrypted content for item rs_bad could not be verified. Reason: Encrypted content could not be decrypted or parsed.";
+
+fn initial_response() -> String {
+    sse(vec![
+        ev_response_created("first"),
+        ev_reasoning_item("rs_good", &[], &["valid reasoning"]),
+        ev_reasoning_item("rs_bad", &[], &["rejected reasoning"]),
+        ev_function_call(
+            "plan_once",
+            "update_plan",
+            &json!({
+                "plan":[{"step":"Verify recovery","status":"completed"}]
+            })
+            .to_string(),
+        ),
+        ev_completed("first"),
+    ])
+}
+
+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+async fn preserves_tools_good_reasoning_and_recovery_across_restart() -> Result<()> {
+    let server = start_mock_server().await;
+    let requests = mount_sse_sequence(
+        &server,
+        vec![
+            initial_response(),
+            sse_failed("rejected", "invalid_encrypted_content", REJECTED),
+            sse(vec![
+                ev_assistant_message("recovered", "Done"),
+                ev_completed("recovered"),
+            ]),
+        ],
+    )
+    .await;
+    let test = test_codex()
+        .with_config(|config| {
+            config.mira_auto_reasoning_recovery = Some(true);
+            config.update_plan_enabled = true;
+        })
+        .build_with_auto_env(&server)
+        .await?;
+    test.submit_turn("Update the plan once, then finish.")
+        .await?;
+    let recorded = requests.requests();
+    assert_eq!(recorded.len(), 3);
+    assert_eq!(recorded[1].inputs_of_type("reasoning").len(), 2);
+    assert_eq!(
+        recorded[2]
+            .inputs_of_type("reasoning")
+            .iter()
+            .map(|item| item["id"].as_str().unwrap())
+            .collect::<Vec<_>>(),
+        vec!["rs_good"]
+    );
+    assert_eq!(
+        recorded[1].inputs_of_type("function_call_output"),
+        recorded[2].inputs_of_type("function_call_output")
+    );
+    assert_eq!(recorded[2].inputs_of_type("function_call_output").len(), 1);
+    assert_eq!(
+        recorded[2].inputs_of_type("function_call_output")[0]["output"],
+        "Plan updated"
+    );
+    assert_eq!(
+        recorded[1].body_json()["client_metadata"]["turn_id"],
+        recorded[2].body_json()["client_metadata"]["turn_id"]
+    );
+    assert_eq!(
+        test.codex
+            .thread_settings_snapshot()
+            .await
+            .mira_reasoning_recovery,
+        Some(MiraReasoningRecovery {
+            enabled: true,
+            rejected_item_ids: vec!["rs_bad".into()]
+        })
+    );
+    let continued = mount_sse_once(
+        &server,
+        sse(vec![
+            ev_assistant_message("after_restart", "Continued"),
+            ev_completed("after_restart"),
+        ]),
+    )
+    .await;
+    let resumed = test_codex().restart(&server, &test).await?;
+    resumed
+        .submit_turn("Continue with the existing plan.")
+        .await?;
+    let input = continued.single_request();
+    assert_eq!(
+        input
+            .inputs_of_type("reasoning")
+            .iter()
+            .map(|item| item["id"].as_str().unwrap())
+            .collect::<Vec<_>>(),
+        vec!["rs_good"]
+    );
+    assert!(
+        resumed
+            .codex
+            .thread_settings_snapshot()
+            .await
+            .mira_reasoning_recovery
+            .unwrap()
+            .enabled
+    );
+    let rollout =
+        std::fs::read_to_string(resumed.session_configured.rollout_path.as_ref().unwrap())?;
+    assert!(rollout.lines().any(|line| {
+        let line: serde_json::Value = serde_json::from_str(line).unwrap();
+        line["type"] == "response_item"
+            && line["payload"]["id"] == "rs_bad"
+            && line["payload"]["encrypted_content"].is_string()
+    }));
+    Ok(())
+}
+
