+#[tokio::test]
+async fn spawn_edge_waits_for_child_creation_and_follows_its_commit() {
+    let (store, mut server) = Server::new().await;
+    let parent = ThreadId::new();
+    let child = ThreadId::new();
+    let writer = {
+        let store = store.clone();
+        tokio::spawn(async move { store.create_thread(create(parent, None)).await })
+    };
+    server.create(parent, 0).await;
+    writer.await.unwrap().unwrap();
+
+    // Upstream publishes the edge before the child exists; Mira Server rejects that.
+    let open = json!({"operation":"upsert", "parentThreadId":parent,
+        "childThreadId":child, "status":"open"});
+    store
+        .write_thread_spawn_edge(parent, child, open)
+        .await
+        .unwrap();
+    store
+        .write_thread_spawn_edge_status(
+            child,
+            json!({"operation":"status", "childThreadId":child, "status":"closed"}),
+        )
+        .await
+        .unwrap();
+    assert!(server.requests.try_recv().is_err());
+
+    let child_writer = {
+        let store = store.clone();
+        tokio::spawn(async move { store.create_thread(create(child, Some(parent))).await })
+    };
+    server.create(child, 2).await;
+    let edge = server.next("POST /v2/stores/test/agent-graph ").await;
+    let body = edge.raw.split("\r\n\r\n").nth(1).unwrap();
+    assert_eq!(
+        serde_json::from_str::<serde_json::Value>(body).unwrap(),
+        json!({"operation":"upsert", "parentThreadId":parent,
+            "childThreadId":child, "status":"closed"})
+    );
+    assert!(!child_writer.is_finished());
+    edge.reply.send(json!({})).unwrap();
+    child_writer.await.unwrap().unwrap();
+
+    // Once the child exists, later status changes are written directly.
+    let status = {
+        let store = store.clone();
+        tokio::spawn(async move {
+            store
+                .write_thread_spawn_edge_status(
+                    child,
+                    json!({"operation":"status", "childThreadId":child, "status":"open"}),
+                )
+                .await
+        })
+    };
+    server
+        .next("POST /v2/stores/test/agent-graph ")
+        .await
+        .reply
+        .send(json!({}))
+        .unwrap();
+    status.await.unwrap().unwrap();
+    assert!(server.requests.try_recv().is_err());
+}
