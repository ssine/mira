+    #[test]
+    fn cas_uses_raw_baseline_and_preserves_unrecognized_fields() {
+        let mut raw = serde_json::json!({"metadata_updates": {"thread": {
+            "updated_at": "2026-01-01T00:00:00+00:00", "future": {"opaque": 7}
+        }}, "future_root": true});
+        let before = serde_json::json!({"metadata_updates": {"thread": {
+            "model": null, "title": null, "updated_at": "2026-01-01T00:00:00Z"
+        }}});
+        let after = serde_json::json!({"metadata_updates": {"thread": {
+            "model": "test-model", "title": "first title", "updated_at": "2026-01-02T00:00:00Z"
+        }}});
+        let changes = canonical_changes(&before, &after, &raw).unwrap();
+        assert_eq!(changes.len(), 3);
+        for change in &changes {
+            if change.path.last().unwrap() == "updated_at" {
+                assert_eq!(
+                    change.expected.value,
+                    Some(serde_json::json!("2026-01-01T00:00:00+00:00"))
+                );
+            } else {
+                assert!(!change.expected.exists);
+                assert!(change.expected.value.is_none());
+                assert_eq!(change.conflict_policy, "compareAndSwap");
+            }
+        }
+        apply_canonical_changes(&mut raw, &changes).unwrap();
+        assert_eq!(raw["metadata_updates"]["thread"]["future"]["opaque"], 7);
+        assert_eq!(raw["future_root"], true);
+        let next = serde_json::json!({"metadata_updates": {"thread": {
+            "model": "next-model", "title": "first title", "updated_at": "2026-01-02T00:00:00Z"
+        }}});
+        let changes = canonical_changes(&after, &next, &raw).unwrap();
+        assert_eq!(changes.len(), 1);
+        assert_eq!(
+            changes[0].expected.value,
+            Some(serde_json::json!("test-model"))
+        );
+    }
+
+    #[test]
+    fn state_diff_uses_leaf_paths_and_server_compatible_policies() {
+        let thread_id = "018f0000-0000-7000-8000-000000000001";
+        let before = serde_json::json!({
+            "metadata_updates": {
+                (thread_id): {
+                    "title": "old",
+                    "updated_at": 1,
+                    "token_usage": {"total_tokens": 10}
+                }
+            }
+        });
+        let after = serde_json::json!({
+            "metadata_updates": {
+                (thread_id): {
+                    "title": "new",
+                    "updated_at": 2,
+                    "token_usage": {"total_tokens": 11}
+                }
+            }
+        });
+
+        let changes = state_changes(&before, &after).expect("diff state");
+        assert_eq!(changes.len(), 3);
+        let find = |field: &str| {
+            changes
+                .iter()
+                .find(|change| change.path.get(2).is_some_and(|part| part == field))
+                .expect("field change")
+        };
+        assert_eq!(find("title").path, ["metadata_updates", thread_id, "title"]);
+        assert_eq!(find("title").conflict_policy, "compareAndSwap");
+        assert_eq!(find("updated_at").conflict_policy, "lastWriteWins");
+        assert_eq!(find("token_usage").conflict_policy, "lastWriteWins");
+        assert_eq!(
+            find("token_usage").path,
+            ["metadata_updates", thread_id, "token_usage", "total_tokens"]
