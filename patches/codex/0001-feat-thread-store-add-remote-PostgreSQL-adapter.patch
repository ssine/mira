diff --git a/codex-rs/core/tests/suite/plaintext_agent_messages.rs b/codex-rs/core/tests/suite/plaintext_agent_messages.rs
new file mode 100644
index 0000000..ece1fee
--- /dev/null
+++ b/codex-rs/core/tests/suite/plaintext_agent_messages.rs
@@ -0,0 +1,228 @@
+use anyhow::Result;
+use codex_features::Feature;
+use codex_protocol::protocol::AgentStatus;
+use core_test_support::responses::*;
+use core_test_support::test_codex::test_codex;
+use pretty_assertions::assert_eq;
+use serde_json::Value;
+use serde_json::json;
+use std::time::Duration;
+use test_case::test_case;
+use wiremock::Mock;
+use wiremock::ResponseTemplate;
+use wiremock::matchers::method;
+use wiremock::matchers::path;
+
+#[derive(Clone, Copy)]
+enum Surface {
+    Direct,
+    CodeMode,
+    Flat,
+}
+
+// Exercise the full sender/receiver path, including providers which omit
+// encrypted_function_args. The second child turn must replay both queued and
+// triggering messages as plaintext, while preserving the original wire calls.
+#[test_case(Surface::Direct; "direct")]
+#[test_case(Surface::CodeMode; "code_mode")]
+#[test_case(Surface::Flat; "flat")]
+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+async fn plaintext_agent_messages_survive_delivery_and_replay(surface: Surface) -> Result<()> {
+    let server = start_mock_server().await;
+    Mock::given(method("POST"))
+        .and(path("/v1/responses"))
+        .respond_with(move |request: &wiremock::Request| {
+            let body: Value = serde_json::from_slice(&request.body).expect("request JSON");
+            let input = body["input"].as_array().expect("input");
+            let child = input
+                .iter()
+                .any(|item| item["type"] == "agent_message" && item["recipient"] == "/root/worker");
+            let prompt = input
+                .iter()
+                .rev()
+                .find(|item| item["role"] == "user")
+                .map(ToString::to_string)
+                .unwrap_or_default();
+            let (name, args) = if prompt.contains("WAKE_WORKER") {
+                (
+                    "followup_task",
+                    json!({"target":"worker", "message":"wake payload"}),
+                )
+            } else if prompt.contains("QUEUE_NOTE") {
+                (
+                    "send_message",
+                    json!({"target":"worker", "message":"queued payload"}),
+                )
+            } else {
+                (
+                    "spawn_agent",
+                    json!({"task_name":"worker", "message":"initial payload", "fork_turns":"none"}),
+                )
+            };
+            let call_id = format!("call-{name}");
+            let called = input.iter().any(|item| item["call_id"] == call_id);
+            let event = if child || called {
+                ev_assistant_message("answer", if child { "worker done" } else { "parent done" })
+            } else {
+                match surface {
+                    Surface::Direct => ev_function_call_with_namespace(
+                        &call_id,
+                        "mira_collaboration",
+                        name,
+                        &args.to_string(),
+                    ),
+                    Surface::Flat => {
+                        ev_function_call(&call_id, &format!("mira_{name}"), &args.to_string())
+                    }
+                    Surface::CodeMode => ev_custom_tool_call(
+                        &call_id,
+                        "exec",
+                        &format!("text(await tools.mira_collaboration__{name}({args}));"),
+                    ),
+                }
+            };
+            ResponseTemplate::new(200)
+                .insert_header("content-type", "text/event-stream")
+                .set_body_string(sse(vec![
+                    ev_response_created("response"),
+                    event,
+                    ev_completed("response"),
+                ]))
+        })
+        .mount(&server)
+        .await;
+
+    let mut builder = test_codex()
+        .with_model_info_override("gpt-5.6-sol", |info| info.use_responses_lite = false)
+        .with_config(move |config| {
+            config.features.enable(Feature::Collab).expect("collab");
+            config.features.enable(Feature::MultiAgentV2).expect("v2");
+            config
+                .features
+                .enable(Feature::MiraPlaintextContext)
+                .expect("plaintext context");
+            if matches!(surface, Surface::Flat) {
+                config.multi_agent_v2.tool_namespace = None;
+            }
+            if matches!(surface, Surface::CodeMode) {
+                config
+                    .features
+                    .enable(Feature::CodeMode)
+                    .expect("code mode");
+                config.multi_agent_v2.non_code_mode_only = false;
+            }
+        });
+    let test = builder.build_with_auto_env(&server).await?;
+    test.submit_turn("SPAWN_WORKER").await?;
+    // Wait for completion notification so send_message exercises an idle child.
+    tokio::time::timeout(Duration::from_secs(10), async {
+        loop {
+            let ids = test.thread_manager.list_thread_ids().await;
+            if let Some(id) = ids
+                .into_iter()
+                .find(|id| *id != test.session_configured.thread_id)
+                && matches!(
+                    test.thread_manager
+                        .get_thread(id)
+                        .await
+                        .expect("child")
+                        .agent_status()
+                        .await,
+                    AgentStatus::Completed(_)
+                )
+            {
+                break;
+            }
+            tokio::time::sleep(Duration::from_millis(10)).await;
+        }
+    })
+    .await?;
+    test.submit_turn("QUEUE_NOTE").await?;
+    test.submit_turn("WAKE_WORKER").await?;
+    let requests = tokio::time::timeout(Duration::from_secs(10), async {
+        loop {
+            let requests = server.received_requests().await.expect("requests");
+            if requests.iter().any(|r| {
+                let body: Value = serde_json::from_slice(&r.body).expect("body");
+                body["input"].as_array().expect("input").iter().any(|item| {
+                    item["type"] == "agent_message"
+                        && item["recipient"] == "/root/worker"
+                        && item.to_string().contains("wake payload")
+                })
+            }) {
+                break requests;
+            }
+            tokio::time::sleep(Duration::from_millis(10)).await;
+        }
+    })
+    .await?;
+    let bodies: Vec<Value> = requests
+        .iter()
+        .map(|r| serde_json::from_slice(&r.body).expect("body"))
+        .collect();
+    let replay = bodies
+        .iter()
+        .find(|body| {
+            body["input"].as_array().expect("input").iter().any(|item| {
+                item["type"] == "agent_message"
+                    && item["recipient"] == "/root/worker"
+                    && item.to_string().contains("wake payload")
+            })
+        })
+        .expect("child followup");
+    let messages: Vec<_> = replay["input"]
+        .as_array()
+        .expect("input")
+        .iter()
+        .filter(|item| item["type"] == "agent_message" && item["recipient"] == "/root/worker")
+        .map(|item| item["content"].clone())
+        .collect();
+    let expected: Vec<_> = [
+        ("NEW_TASK", "initial payload"),
+        ("MESSAGE", "queued payload"),
+        ("NEW_TASK", "wake payload"),
+    ]
+    .into_iter()
+    .map(|(kind, payload)| {
+        json!([{"type":"input_text", "text":format!(
+            "Message Type: {kind}\nTask name: /root/worker\nSender: /root\nPayload:\n{payload}")}])
+    })
+    .collect();
+    assert_eq!(messages, expected);
+    if matches!(surface, Surface::Direct) {
+        let initial = bodies
+            .iter()
+            .find(|body| namespace_child_tool(body, "mira_collaboration", "spawn_agent").is_some())
+            .expect("advertised spawn alias");
+        for name in ["spawn_agent", "send_message", "followup_task"] {
+            assert!(
+                bodies
+                    .iter()
+                    .any(|body| body["input"].as_array().expect("input").iter().any(
+                        |item| item["type"] == "function_call"
+                            && item["namespace"] == "mira_collaboration"
+                            && item["name"] == name
+                            && item["encrypted_function_args"].is_null()
+                    ))
+            );
+            let tool =
+                namespace_child_tool(initial, "mira_collaboration", name).expect("alias tool");
+            assert!(
+                tool["parameters"]["properties"]["message"]
+                    .get("encrypted")
+                    .is_none()
+            );
+        }
+        assert_eq!(
+            namespace_child_tool(initial, "collaboration", "list_agents").expect("list tool")["name"],
+            "list_agents"
+        );
+        // Child receives the same plaintext tools, so it can also send plaintext back.
+        assert_eq!(
+            namespace_child_tool(replay, "mira_collaboration", "send_message")
+                .expect("child alias")["name"],
+            "send_message"
+        );
+    }
+    Ok(())
+}
