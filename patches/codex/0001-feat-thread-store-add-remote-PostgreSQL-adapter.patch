+    foreign["runtime_workspace_roots"] = json!([if cfg!(windows) {
+        "/srv/foreign"
+    } else {
+        "C:\\foreign"
+    }]);
+    let canonical = json!({
+        "created_threads": {(native_id.to_string()): native, (foreign_id.to_string()): foreign},
+        "metadata_updates": {(foreign_id.to_string()): {"title": "foreign thread"}},
+        "future_metadata": {"preserve": true}
