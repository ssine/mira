+use super::*;
+use pretty_assertions::assert_eq;
+use serde_json::json;
+
+fn error(code: &str, id: &str) -> CodexErr {
+    CodexErr::InvalidRequest(json!({"error": {
+        "code": code,
+        "message": format!("The encrypted content for item {id} could not be verified. Reason: Encrypted content could not be decrypted or parsed.")
+    }}).to_string())
+}
+
+#[test]
+fn requires_structured_error_and_one_matching_encrypted_reasoning_item() {
+    let reasoning: ResponseItem = serde_json::from_value(json!({
+        "type":"reasoning", "id":"rs_rejected", "summary":[], "encrypted_content":"opaque"
+    }))
+    .unwrap();
+    let valid = error("invalid_encrypted_content", "rs_rejected");
+    assert_eq!(
+        rejected_reasoning_id(&valid, std::slice::from_ref(&reasoning)),
+        Some("rs_rejected".into())
+    );
+    assert_eq!(rejected_reasoning_id(&valid, &[]), None);
+    assert_eq!(
+        rejected_reasoning_id(&valid, &[reasoning.clone(), reasoning.clone()]),
+        None
+    );
+    assert_eq!(
+        rejected_reasoning_id(
+            &error("invalid_encrypted_content", "rs_absent"),
+            std::slice::from_ref(&reasoning)
+        ),
+        None
+    );
+    assert_eq!(
+        rejected_reasoning_id(
+            &error("server_error", "rs_rejected"),
+            std::slice::from_ref(&reasoning)
+        ),
+        None
+    );
+    assert_eq!(
+        rejected_reasoning_id(
+            &error("unknown_reasoning_pool", "rs_rejected"),
+            &[reasoning]
+        ),
+        None
+    );
+}
+
+#[test]
+fn refuses_compaction_tool_outputs_and_unencrypted_reasoning() {
+    for item in [
+        json!({"type":"compaction","id":"rs_rejected","encrypted_content":"opaque"}),
+        json!({"type":"reasoning","id":"rs_rejected","summary":[]}),
+        json!({"type":"function_call_output","id":"rs_rejected","call_id":"call_1","output":"invalid_encrypted_content"}),
+    ] {
+        let item: ResponseItem = serde_json::from_value(item).unwrap();
+        assert_eq!(
+            rejected_reasoning_id(&error("invalid_encrypted_content", "rs_rejected"), &[item]),
+            None
+        );
+    }
+    let text_only = CodexErr::InvalidRequest("invalid_encrypted_content for rs_rejected".into());
+    assert_eq!(rejected_reasoning_id(&text_only, &[]), None);
+}
+
+#[tokio::test]
+async fn settings_survive_resume_and_explicit_disable_preserves_exclusions() {
+    let configuration = super::super::tests::make_session_configuration_for_tests().await;
+    let mut snapshot = configuration.thread_settings_snapshot(&[]);
+    let owner = ThreadId::new();
+    let other = ThreadId::new();
+    let saved = MiraReasoningRecovery {
+        enabled: true,
+        rejected_item_ids: vec!["rs_bad".into()],
+    };
+    snapshot.mira_reasoning_recovery = Some(saved.clone());
+    let item = RolloutItem::EventMsg(EventMsg::ThreadSettingsApplied(
+        codex_protocol::protocol::ThreadSettingsAppliedEvent {
+            thread_id: Some(owner),
+            thread_settings: snapshot,
+        },
+    ));
+    let history = InitialHistory::Resumed(codex_history::ResumedHistory {
+        conversation_id: owner,
+        history: std::sync::Arc::new(vec![item.clone()]),
+        rollout_path: None,
+    });
+    assert_eq!(restore(&history, None, None).unwrap(), Some(saved));
+    assert_eq!(
+        restore(&history, None, Some(false)).unwrap(),
+        Some(MiraReasoningRecovery {
+            enabled: false,
+            rejected_item_ids: vec!["rs_bad".into()]
+        })
+    );
+    let unrelated = InitialHistory::Resumed(codex_history::ResumedHistory {
+        conversation_id: other,
+        history: std::sync::Arc::new(vec![item]),
+        rollout_path: None,
+    });
+    assert_eq!(restore(&unrelated, None, None).unwrap(), None);
+    assert_eq!(restore(&InitialHistory::New, None, None).unwrap(), None);
+}
