index 0000000000..487d3f5767
--- /dev/null
+++ b/codex-rs/core/src/image_compaction.rs
@@ -0,0 +1,157 @@
+//! Count images at request boundaries and preserve unconsumed input across one
+//! native summary checkpoint. Ordinary sampling never rewrites a cached prefix.
+
+use crate::context_manager::is_model_generated_item;
+use crate::context_manager::is_user_turn_boundary;
+use codex_context_fragments::AnnotatedContent;
+use codex_context_fragments::set_annotated_content;
+use codex_context_fragments::to_annotated_content;
+use codex_extension_api::ExtensionData;
+use codex_history::ResponseItemEnvelope;
+use codex_protocol::models::ContentItem;
+use codex_protocol::models::ContentItemKind;
+use codex_protocol::models::FunctionCallOutputContentItem;
+use codex_protocol::models::ResponseItem;
+use std::sync::Arc;
+
+const OMITTED_IMAGE: &str = "[Earlier image omitted from this compaction request to fit the configured compaction image budget. Original image remains in conversation history.]";
+
+/// Turn-local snapshot consumed by plaintext compaction. These items have not
+/// been read by normal sampling, so retain them verbatim after the summary.
+#[derive(Clone)]
+pub(crate) struct PendingImageCompaction {
+    pub(crate) pending: Vec<ResponseItemEnvelope>,
+    pub(crate) prefix: Vec<ResponseItemEnvelope>,
+}
+
+pub(crate) struct ImageCompactionGuard(pub(crate) Arc<ExtensionData>);
+
+impl Drop for ImageCompactionGuard {
+    fn drop(&mut self) {
+        self.0.remove::<PendingImageCompaction>();
+    }
+}
+
+pub(crate) fn image_count<'a>(items: impl IntoIterator<Item = &'a ResponseItem>) -> usize {
+    items
+        .into_iter()
+        .map(|item| match item {
+            ResponseItem::Message { content, .. } => content
+                .iter()
+                .filter(|part| matches!(part, ContentItem::InputImage { .. }))
+                .count(),
+            ResponseItem::FunctionCallOutput { output, .. }
+            | ResponseItem::CustomToolCallOutput { output, .. } => {
+                output.content_items().map_or(0, |parts| {
+                    parts
+                        .iter()
+                        .filter(|part| {
+                            matches!(part, FunctionCallOutputContentItem::InputImage { .. })
+                        })
+                        .count()
+                })
+            }
+            _ => 0,
+        })
+        .sum()
+}
+
+pub(crate) fn prepare_image_compaction(
+    items: &[ResponseItemEnvelope],
+    limit: usize,
+) -> Option<PendingImageCompaction> {
+    if limit == 0 || image_count(items.iter().map(|entry| &entry.item)) < limit {
+        return None;
+    }
+    let mut prefix_len = items
+        .iter()
+        .rposition(|entry| {
+            is_model_generated_item(&entry.item)
+                && !is_user_turn_boundary(&entry.item)
+                && !entry
+                    .metadata
+                    .as_ref()
+                    .is_some_and(|metadata| metadata.compaction_output)
+        })
+        .map_or(0, |index| index + 1);
+    // Keep the calls paired with newly returned tool outputs; normalization must
+    // not synthesize an aborted result or drop an orphan output after compaction.
+    for (position, entry) in items.iter().enumerate().rev() {
+        if position < prefix_len {
+            break;
+        }
+        let call_id = match &entry.item {
+            ResponseItem::FunctionCallOutput {
+                call_id: Some(call_id),
+                ..
+            }
+            | ResponseItem::CustomToolCallOutput { call_id, .. }
+            | ResponseItem::ToolSearchOutput {
+                call_id: Some(call_id),
+                ..
+            } => call_id,
+            _ => continue,
+        };
+        if let Some(index) = items[..prefix_len].iter().position(|entry| matches!(&entry.item,
+            ResponseItem::FunctionCall { call_id: id, .. } | ResponseItem::CustomToolCall { call_id: id, .. } | ResponseItem::ToolSearchCall { call_id: Some(id), .. } if id == call_id)) {
+            prefix_len = prefix_len.min(index);
+        }
+    }
+    if image_count(items[..prefix_len].iter().map(|entry| &entry.item)) == 0 {
+        return None;
+    }
+    Some(PendingImageCompaction {
+        pending: items[prefix_len..].to_vec(),
+        prefix: items[..prefix_len].to_vec(),
+    })
+}
+
+#[cfg(test)]
+#[path = "image_compaction_tests.rs"]
+mod tests;
+
+/// Only compaction requests need a safety projection for already oversized
+/// restored history. Count actual typed media, preserving all text and call IDs.
+pub(crate) fn limit_compaction_images(items: &mut [ResponseItem], limit: usize) {
+    let mut omitted = image_count(items.iter()).saturating_sub(limit);
+    for item in items {
+        if omitted == 0 {
+            break;
+        }
+        match item {
+            ResponseItem::Message { .. } => {
+                let Some(mut content) = to_annotated_content(item) else {
+                    continue;
+                };
+                for part in &mut content {
+                    if omitted > 0 && matches!(part.content(), ContentItem::InputImage { .. }) {
+                        *part = AnnotatedContent::new(
+                            ContentItem::InputText {
+                                text: OMITTED_IMAGE.to_string(),
+                            },
+                            ContentItemKind("images.compaction_omitted".to_string()),
+                        );
+                        omitted -= 1;
+                    }
+                }
+                set_annotated_content(item, content);
+            }
+            ResponseItem::FunctionCallOutput { output, .. }
+            | ResponseItem::CustomToolCallOutput { output, .. } => {
+                if let Some(parts) = output.content_items_mut() {
+                    for part in parts {
+                        if omitted > 0
+                            && matches!(part, FunctionCallOutputContentItem::InputImage { .. })
+                        {
+                            *part = FunctionCallOutputContentItem::InputText {
+                                text: OMITTED_IMAGE.to_string(),
+                            };
+                            omitted -= 1;
+                        }
+                    }
+                }
+            }
+            _ => {}
+        }
+    }
+}
