+use anyhow::Result;
+use app_test_support::MockResponsesConfig;
+use app_test_support::TestAppServer;
+use app_test_support::create_mock_responses_server_repeating_assistant;
+use codex_app_server_protocol::*;
+use pretty_assertions::assert_eq;
+use std::time::Duration;
+use tempfile::TempDir;
+
+async fn residency(
+    client: &mut TestAppServer,
+    evict: Option<MiraThreadResidencyCandidate>,
+) -> Result<MiraThreadResidencyResponse> {
+    client
+        .request(|request_id| ClientRequest::MiraThreadResidency {
+            request_id,
+            params: MiraThreadResidencyParams { evict },
+        })
+        .await
+}
+
+#[tokio::test]
+async fn memory_lease_keeps_idle_thread_and_rechecks_resubscribed_candidate() -> Result<()> {
+    let server = create_mock_responses_server_repeating_assistant("Done").await;
+    let home = TempDir::new()?;
+    MockResponsesConfig::new(&server.uri())
+        .with_sandbox_mode("danger-full-access")
+        .with_root_config("thread_unload_delay_secs = 1")
+        .with_extra_config(
+            "[experimental_thread_store]\ntype = \"in_memory\"\nid = \"residency-test\"",
+        )
+        .write(home.path())?;
+    let mut client = TestAppServer::builder()
+        .with_codex_home(home.path())
+        .build_initialized()
+        .await?;
+    let started = client
+        .start_thread(ThreadStartParams {
+            developer_instructions: Some("Residency test instructions".into()),
+            ..Default::default()
+        })
+        .await?;
+    let id = started.thread.id;
+    assert_eq!(residency(&mut client, None).await?.oldest, None);
+    let _: ThreadUnsubscribeResponse = client
+        .request(|request_id| ClientRequest::ThreadUnsubscribe {
+            request_id,
+            params: ThreadUnsubscribeParams {
+                thread_id: id.clone(),
+            },
+        })
+        .await?;
+    tokio::time::sleep(Duration::from_millis(1200)).await;
+    let candidate = residency(&mut client, None)
+        .await?
+        .oldest
+        .expect("idle thread retained past timeout");
+    assert_eq!(candidate.thread_id, id);
+    let loaded: ThreadLoadedListResponse = client
+        .request(|request_id| ClientRequest::ThreadLoadedList {
+            request_id,
+            params: ThreadLoadedListParams::default(),
+        })
+        .await?;
+    assert_eq!(loaded.data, vec![id.clone()]);
+    let resumed: ThreadResumeResponse = client
+        .request(|request_id| ClientRequest::ThreadResume {
+            request_id,
+            params: ThreadResumeParams {
+                thread_id: id.clone(),
+                developer_instructions: Some("Residency test instructions".into()),
+                ..Default::default()
+            },
+        })
+        .await?;
+    assert_eq!(resumed.thread.session_id, started.thread.session_id);
+    assert_eq!(
+        residency(&mut client, Some(candidate.clone())).await?,
+        MiraThreadResidencyResponse {
+            oldest: None,
+            eviction_scheduled: false,
+        }
+    );
+    let _: ThreadUnsubscribeResponse = client
+        .request(|request_id| ClientRequest::ThreadUnsubscribe {
+            request_id,
+            params: ThreadUnsubscribeParams {
+                thread_id: id.clone(),
+            },
+        })
+        .await?;
+    // The listener consumes the subscription watch asynchronously.
+    let next = tokio::time::timeout(Duration::from_secs(5), async {
+        loop {
+            if let Some(candidate) = residency(&mut client, None).await?.oldest {
+                break Ok::<_, anyhow::Error>(candidate);
+            }
+            tokio::time::sleep(Duration::from_millis(20)).await;
+        }
+    })
+    .await??;
+    assert_ne!(next.revision, candidate.revision);
+    assert!(
+        !residency(&mut client, Some(candidate))
+            .await?
+            .eviction_scheduled
+    );
+    assert!(residency(&mut client, Some(next)).await?.eviction_scheduled);
+    let closed: ThreadClosedNotification = tokio::time::timeout(
+        Duration::from_secs(10),
+        client.read_notification("thread/closed"),
+    )
+    .await??;
+    assert_eq!(closed.thread_id, id);
+    Ok(())
+}
+
+#[tokio::test]
+async fn memory_eviction_protects_family_with_running_child() -> Result<()> {
+    use core_test_support::responses;
