+#[tokio::test]
+async fn live_input_recovery_revalidates_consent_and_preserves_canonical_cache() {
+    let (store, mut server) = Server::new().await;
+    let id = ThreadId::new();
+    let items = json!([
+        {"type":"response_item","payload":{"type":"reasoning","id":"rs-old","summary":[],"content":null,"encrypted_content":"opaque"}},
+        message("completed tool result is retained")
+    ]);
+    let load = tokio::spawn(read(store.clone(), id));
+    server
+        .next("GET ")
+        .await
+        .reply
+        .send(head(id, 1, 1, 2))
+        .unwrap();
+    server
+        .next("GET ")
+        .await
+        .reply
+        .send(json!({"generation":1,"itemCount":2,"items":items}))
+        .unwrap();
+    assert_eq!(
+        serde_json::to_value(load.await.unwrap().unwrap().items).unwrap(),
+        items
+    );
+    for expected in ["confirmed", "superseded"] {
+        let recovery = {
+            let store = store.clone();
+            tokio::spawn(async move {
+                store
+                    .recover_input(
+                        crate::LoadThreadHistoryParams {
+                            thread_id: id,
+                            include_archived: false,
+                        },
+                        expected.to_string(),
+                    )
+                    .await
+            })
+        };
+        // No canonical version change and no shutdown: refresh must still fetch consent.
+        server
+            .next("GET ")
+            .await
+            .reply
+            .send(head(id, 1, 1, 2))
+            .unwrap();
+        server
+            .next("GET ")
+            .await
+            .reply
+            .send(json!({"generation":1,"itemCount":2,"items":items,
+            "inputRecovery":{"failureId":"confirmed","throughItemSeq":2,"policy":"omitReasoning"}}))
+            .unwrap();
+        let result = recovery.await.unwrap();
+        if expected == "confirmed" {
+            assert_eq!(
+                serde_json::to_value(result.unwrap().items).unwrap(),
+                json!([message("completed tool result is retained")])
+            );
+        } else {
+            assert!(matches!(
