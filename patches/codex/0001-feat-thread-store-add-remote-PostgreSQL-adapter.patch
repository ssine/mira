@@ -0,0 +1,79 @@
+//! Refresh only model-facing input, retaining the native multi-agent session.
+use super::session::Session;
+use codex_history::RolloutItem;
+use codex_protocol::error::CodexErr;
+use codex_protocol::error::Result;
+use codex_protocol::protocol::EventMsg;
+use codex_protocol::turn_input::NotSubmittedReason;
+use codex_protocol::turn_input::TurnInputSubmission;
+use std::sync::Arc;
+
+pub(super) async fn recover(
+    session: &Arc<Session>,
+    expected_turn_id: String,
+    failure_id: String,
+    submission_id: String,
+) -> Result<TurnInputSubmission> {
+    // This runs in the same submission loop as parent followups and user input.
+    // Never stop or steer work that won the race with the recovery request.
+    if session.active_turn.lock().await.is_some() {
+        return Ok(TurnInputSubmission::NotSubmitted {
+            reason: NotSubmittedReason::NotIdle,
+        });
+    }
+    if session.input_queue.has_trigger_turn_mailbox_items().await {
+        return Ok(TurnInputSubmission::NotSubmitted {
+            reason: NotSubmittedReason::PendingTriggerTurn,
+        });
+    }
+    let live = session
+        .live_thread_for_persistence("recover model input")
+        .map_err(|err| CodexErr::InvalidRequest(err.to_string()))?;
+    live.flush()
+        .await
+        .map_err(|err| CodexErr::InvalidRequest(err.to_string()))?;
+    let history = live
+        .recover_input(failure_id)
+        .await
+        .map_err(|err| CodexErr::InvalidRequest(err.to_string()))?;
+    let latest = history.items.iter().rev().find_map(|item| match item {
+        RolloutItem::EventMsg(EventMsg::TurnStarted(event)) => {
+            Some((event.turn_id.as_str(), false))
+        }
+        RolloutItem::EventMsg(EventMsg::TurnComplete(event)) => {
+            Some((event.turn_id.as_str(), true))
+        }
+        RolloutItem::EventMsg(EventMsg::TurnAborted(_)) => Some(("", false)),
+        _ => None,
+    });
+    if latest != Some((expected_turn_id.as_str(), true)) {
+        return Err(CodexErr::InvalidRequest(
+            "failed turn was superseded; input recovery canceled".to_string(),
+        ));
+    }
+    let turn = session.new_default_turn().await;
+    session
+        .apply_rollout_reconstruction(&turn, &history.items)
+        .await;
+    session.recompute_token_usage(turn.as_ref()).await;
+    let root_turn_id = session
+        .reference_context_item()
+        .await
+        .and_then(|context| context.root_turn_id);
+    // The new turn uses the existing thread settings and has no additional input.
+    // Canonical records, completed tools and parent/child ownership are unchanged.
+    super::turn_input::handle_recovery(
+        session,
+        Default::default(),
+        codex_protocol::turn_input::TurnStartOptions {
+            root_turn_id,
+            ..Default::default()
+        },
+        submission_id,
+    )
+    .await
+}
+
+#[cfg(test)]
+#[path = "input_recovery_tests.rs"]
+mod tests;
