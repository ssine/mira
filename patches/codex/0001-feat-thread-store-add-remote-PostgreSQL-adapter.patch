+        .account_headers
+        .insert("x-mira-codex-runtime", "runtime-b".parse().unwrap());
+    let remote = remote.with_execution_provider("provider-b".to_string());
+    let params = crate::ReadThreadParams {
+        thread_id: id,
+        include_archived: true,
+        include_history: false,
+    };
+    let original = memory.read_thread(params.clone()).await.unwrap();
+    let projected = remote.read_thread(params.clone()).await.unwrap();
+    assert_eq!(projected.model_provider, "provider-b");
+    let mut expected = serde_json::to_value(original).unwrap();
+    expected["model_provider"] = json!("provider-b");
+    assert_eq!(serde_json::to_value(projected).unwrap(), expected);
+    let cached = remote.take_cache().unwrap();
+    assert_eq!(cached.canonical_state, state);
+    assert_eq!(
+        cached
+            .store
+            .read_thread(params)
+            .await
+            .unwrap()
+            .model_provider,
