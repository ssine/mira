index 0000000..2345b87
--- /dev/null
+++ b/codex-rs/thread-store/src/remote_http/writer.rs
@@ -0,0 +1,215 @@
+use std::collections::HashSet;
+use std::panic::AssertUnwindSafe;
+
+use codex_protocol::ThreadId;
+use futures::FutureExt;
+
+use super::RemoteHttpThreadStore;
+use super::cache_missing;
+use super::operation_gate_closed;
+use crate::InMemoryThreadStore;
+use crate::ThreadStoreError;
+use crate::ThreadStoreFuture;
+use crate::ThreadStoreResult;
+
+// The serialized writer outlives cancelled callers, but has no local durable outbox.
+impl RemoteHttpThreadStore {
+    pub(super) async fn mutate<T: Send + 'static>(
+        &self,
+        thread_ids: Vec<ThreadId>,
+        operation: impl for<'a> FnOnce(&'a InMemoryThreadStore) -> ThreadStoreFuture<'a, T>
+        + Send
+        + 'static,
+    ) -> ThreadStoreResult<T> {
+        self.mutate_scoped(thread_ids, true, operation).await
+    }
+
+    pub(super) async fn mutate_metadata<T: Send + 'static>(
+        &self,
+        thread_id: ThreadId,
+        operation: impl for<'a> FnOnce(&'a InMemoryThreadStore) -> ThreadStoreFuture<'a, T>
+        + Send
+        + 'static,
+    ) -> ThreadStoreResult<T> {
+        self.mutate_scoped(vec![thread_id], false, operation).await
+    }
+
+    async fn mutate_scoped<T: Send + 'static>(
+        &self,
+        thread_ids: Vec<ThreadId>,
+        load_histories: bool,
+        operation: impl for<'a> FnOnce(&'a InMemoryThreadStore) -> ThreadStoreFuture<'a, T>
+        + Send
+        + 'static,
+    ) -> ThreadStoreResult<T> {
+        let store = self.clone();
+        let (done, receiver) = tokio::sync::watch::channel(false);
+        let previous = store
+            .write_tail
+            .lock()
+            .unwrap_or_else(std::sync::PoisonError::into_inner)
+            .replace(receiver);
+        // Dropping the caller (e.g. turn/interrupt) must not drop a completed tool's result.
+        // Only process shutdown can abandon this in-memory, unacknowledged operation.
+        tokio::spawn(async move {
+            if let Some(mut previous) = previous {
+                let _ = previous.wait_for(|finished| *finished).await;
+            }
+            let _permit = store
+                .operation_gate
+                .acquire()
+                .await
+                .map_err(|_| operation_gate_closed())?;
+            let result = match AssertUnwindSafe(async {
+                store.check_thread_write_errors(&thread_ids)?;
+                store
+                    .mutate_inner(thread_ids, load_histories, operation)
+                    .await
+            })
+            .catch_unwind()
+            .await
+            {
+                Ok(result) => result,
+                Err(_) => {
+                    let error = ThreadStoreError::Internal {
+                        message: "remote thread-store write worker failed".to_string(),
+                    };
+                    store.record_write_error(&error, &[]);
+                    Err(error)
+                }
+            };
+            done.send_replace(true);
+            result
+        })
+        .await
+        .map_err(|_| ThreadStoreError::Internal {
+            message: "remote thread-store write worker failed".to_string(),
+        })?
+    }
+
+    fn record_write_error(&self, error: &ThreadStoreError, thread_ids: &[ThreadId]) {
+        if matches!(error, ThreadStoreError::Conflict { .. }) && !thread_ids.is_empty() {
+            let mut failures = self
+                .thread_write_errors
+                .lock()
+                .unwrap_or_else(std::sync::PoisonError::into_inner);
+            for thread_id in thread_ids {
+                failures
+                    .entry(*thread_id)
+                    .or_insert_with(|| error.to_string());
+            }
+            return;
+        }
+        let mut failure = self
+            .write_error
+            .lock()
+            .unwrap_or_else(std::sync::PoisonError::into_inner);
+        if failure.is_none() {
+            *failure = Some(error.to_string());
+        }
+    }
+
+    pub(super) fn check_write_error(&self) -> ThreadStoreResult<()> {
+        match self
+            .write_error
+            .lock()
+            .unwrap_or_else(std::sync::PoisonError::into_inner)
+            .as_ref()
+        {
+            Some(message) => Err(ThreadStoreError::Internal {
+                message: format!(
+                    "conversation storage failed; fix the connection/permissions and restart the runtime: {message}"
+                ),
+            }),
+            None => Ok(()),
+        }
+    }
+
+    pub(super) fn check_thread_write_errors(
+        &self,
+        thread_ids: &[ThreadId],
+    ) -> ThreadStoreResult<()> {
+        self.check_write_error()?;
+        let failures = self
+            .thread_write_errors
+            .lock()
+            .unwrap_or_else(std::sync::PoisonError::into_inner);
+        for thread_id in thread_ids {
+            if let Some(message) = failures.get(thread_id) {
+                return Err(ThreadStoreError::Conflict {
+                    message: format!(
+                        "conversation {thread_id} storage conflict; this conversation is paused to avoid overwriting history; resolve the conflict and restart the runtime: {message}"
+                    ),
+                });
+            }
+        }
+        Ok(())
+    }
+
+    async fn mutate_inner<T: Send>(
+        &self,
+        thread_ids: Vec<ThreadId>,
+        load_histories: bool,
+        operation: impl for<'a> FnOnce(&'a InMemoryThreadStore) -> ThreadStoreFuture<'a, T> + Send,
+    ) -> ThreadStoreResult<T> {
+        let mut cache = self.take_cache();
+        let mut invalidate_cache = false;
+        let result = async {
+            self.refresh(&mut cache)
+                .await
+                .inspect_err(|error| self.record_write_error(error, &thread_ids))?;
+            let cached = cache.as_mut().ok_or_else(cache_missing)?;
+            let selected = if load_histories {
+                thread_ids.iter().copied().collect::<HashSet<_>>()
+            } else {
+                HashSet::new()
+            };
+            for thread_id in &selected {
+                self.ensure_history(cached, *thread_id)
+                    .await
+                    .inspect_err(|error| self.record_write_error(error, &thread_ids))?;
+            }
+            let before = cached.store.snapshot_for_threads(&selected).await?;
+            let output = match operation(&cached.store).await {
+                Ok(output) => output,
+                Err(error) => {
+                    invalidate_cache = true;
+                    return Err(error);
+                }
+            };
+            let after = cached.store.snapshot_for_threads(&selected).await?;
+            match self
+                .save(
+                    cached.version,
+                    &cached.history_manifest,
+                    &mut cached.canonical_state,
+                    before,
+                    after,
+                )
+                .await
+            {
+                Ok(Some(committed)) => {
+                    if committed.rebased {
+                        invalidate_cache = true;
+                    } else {
+                        cached.version = committed.version;
+                        cached.history_manifest = committed.history_manifest;
+                    }
+                }
+                Ok(None) => {}
+                Err(error) => {
+                    invalidate_cache = true;
+                    self.record_write_error(&error, &thread_ids);
+                    return Err(error);
+                }
+            }
+            Ok(output)
+        }
+        .await;
+        if invalidate_cache {
+            cache = None;
+        }
+        self.replace_cache(cache);
+        result
+    }
+}
