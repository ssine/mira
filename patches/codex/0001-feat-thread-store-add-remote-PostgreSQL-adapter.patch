diff --git a/codex-rs/thread-store/src/remote_http/queue.rs b/codex-rs/thread-store/src/remote_http/queue.rs
new file mode 100644
index 000000000..334696ce6
--- /dev/null
+++ b/codex-rs/thread-store/src/remote_http/queue.rs
@@ -0,0 +1,101 @@
+use std::collections::HashMap;
+use std::panic::AssertUnwindSafe;
+
+use codex_protocol::ThreadId;
+use futures::FutureExt;
+use tokio::sync::watch;
+
+use super::RemoteHttpThreadStore;
+use super::operation_gate_closed;
+use crate::ThreadStoreError;
+use crate::ThreadStoreFuture;
+use crate::ThreadStoreResult;
+
+#[derive(Default)]
+pub(super) struct OperationQueue {
+    store: Option<watch::Receiver<bool>>,
+    threads: HashMap<ThreadId, watch::Receiver<bool>>,
+}
+
+impl OperationQueue {
+    fn enqueue(
+        &mut self,
+        thread_ids: &[ThreadId],
+        tail: watch::Receiver<bool>,
+    ) -> Vec<watch::Receiver<bool>> {
+        // Completed entries are not a durable per-thread registry.
+        self.threads.retain(|_, tail| !*tail.borrow());
+        if self.store.as_ref().is_some_and(|tail| *tail.borrow()) {
+            self.store = None;
+        }
+        let mut previous = self.store.iter().cloned().collect::<Vec<_>>();
+        if thread_ids.is_empty() {
+            // Store-wide operations are barriers for all preceding/following scopes.
+            previous.extend(self.threads.drain().map(|(_, tail)| tail));
+            self.store = Some(tail);
+        } else {
+            for thread_id in thread_ids {
+                if let Some(prior) = self.threads.insert(*thread_id, tail.clone()) {
+                    previous.push(prior);
+                }
+            }
+        }
+        previous
+    }
+}
+
+impl RemoteHttpThreadStore {
+    pub(super) async fn enqueue_operation<T: Send + 'static>(
+        &self,
+        mut thread_ids: Vec<ThreadId>,
+        operation: impl FnOnce(Self) -> ThreadStoreFuture<'static, T> + Send + 'static,
+    ) -> ThreadStoreResult<T> {
+        let mut unique = std::collections::HashSet::new();
+        thread_ids.retain(|id| unique.insert(*id));
+        let store = self.clone();
+        let queued_at = std::time::Instant::now();
+        let (done, receiver) = watch::channel(false);
+        let previous = store
+            .operation_queue
+            .lock()
+            .unwrap_or_else(std::sync::PoisonError::into_inner)
+            .enqueue(&thread_ids, receiver);
+        // The dependency ticket and work survive cancellation together. Dropping a
+        // queued caller must neither lose a write nor let its successor overtake it.
+        tokio::spawn(async move {
+            let result = AssertUnwindSafe(async {
+                for mut prior in previous {
+                    prior.wait_for(|finished| *finished).await.map_err(|_| ThreadStoreError::Internal {
+                        message: "remote thread-store operation stopped before acknowledgement".to_string(),
+                    })?;
+                }
+                // Acquire capacity only after dependencies: a busy thread cannot
+                // consume every permit with operations waiting on its own tail.
+                let _permit = store.operation_gate.acquire().await.map_err(|_| operation_gate_closed())?;
+                let waited = queued_at.elapsed();
+                if waited >= std::time::Duration::from_secs(1) {
+                    tracing::warn!(thread_ids = ?thread_ids, wait_ms = waited.as_millis(), "remote thread-store operation waited for predecessors or capacity");
+                }
+                let started = std::time::Instant::now();
+                let result = operation(store.clone()).await;
+                let elapsed = started.elapsed();
+                if elapsed >= std::time::Duration::from_secs(1) {
+                    tracing::warn!(thread_ids = ?thread_ids, elapsed_ms = elapsed.as_millis(), failed = result.is_err(), "remote thread-store operation completed slowly");
+                }
+                result
+            }).catch_unwind().await;
+            let result = match result {
+                Ok(result) => result,
+                Err(_) => {
+                    let error = ThreadStoreError::Internal { message: "remote thread-store write worker failed".to_string() };
+                    store.record_write_error(&error, &[]);
+                    Err(error)
+                }
+            };
+            done.send_replace(true);
+            result
+        }).await.map_err(|_| ThreadStoreError::Internal {
+            message: "remote thread-store write worker failed".to_string(),
+        })?
+    }
+}
diff --git a/codex-rs/thread-store/src/remote_http/retry.rs b/codex-rs/thread-store/src/remote_http/retry.rs
new file mode 100644
index 000000000..5c174f3f8
--- /dev/null
+++ b/codex-rs/thread-store/src/remote_http/retry.rs
@@ -0,0 +1,89 @@
+use std::time::Duration;
+
+use reqwest::RequestBuilder;
+use reqwest::StatusCode;
+use serde::de::DeserializeOwned;
+
+use crate::ThreadStoreError;
+use crate::ThreadStoreResult;
+
+/// Retries transport failures with the exact same request, including the commit UUID and body.
+/// A request timeout bounds each attempt, not the lifetime of an unacknowledged write.
+pub(super) async fn request_json<T: DeserializeOwned>(
+    request: RequestBuilder,
+) -> ThreadStoreResult<T> {
+    let mut attempt = 0_u32;
+    loop {
+        let next = request
+            .try_clone()
+            .ok_or_else(|| ThreadStoreError::Internal {
+                message: "remote thread-store request is not replayable".to_string(),
+            })?;
+        let mut retry_after = None;
+        let result = match next.send().await {
+            Ok(response) => {
+                let status = response.status();
+                if status.is_success() {
+                    match response.bytes().await {
+                        Ok(bytes) => {
+                            return serde_json::from_slice(&bytes).map_err(|_| {
+                                ThreadStoreError::Internal {
+                                    message: "remote thread-store returned an invalid response"
+                                        .to_string(),
+                                }
+                            });
+                        }
+                        Err(error) => Err(error),
+                    }
+                } else if status.is_server_error()
+                    || matches!(
+                        status,
+                        StatusCode::TOO_MANY_REQUESTS | StatusCode::REQUEST_TIMEOUT
+                    )
+                {
+                    retry_after = response
+                        .headers()
+                        .get(reqwest::header::RETRY_AFTER)
+                        .and_then(|value| value.to_str().ok())
+                        .and_then(|value| value.parse::<u64>().ok())
+                        .map(|seconds| Duration::from_secs(seconds.min(60)));
+                    Ok(status.as_u16())
+                } else {
+                    // Do not retry authorization, validation or optimistic concurrency failures.
+                    // Never include a response body, URL or credential in a user-visible error.
+                    let message = format!("remote thread-store returned HTTP {status}");
+                    return Err(if status == StatusCode::CONFLICT {
+                        ThreadStoreError::Conflict { message }
+                    } else if matches!(
+                        status,
+                        StatusCode::PAYLOAD_TOO_LARGE | StatusCode::NOT_FOUND | StatusCode::GONE
+                    ) {
+                        ThreadStoreError::InvalidRequest { message }
+                    } else {
+                        ThreadStoreError::Internal { message }
+                    });
+                }
+            }
+            Err(error) if error.is_builder() => {
+                return Err(ThreadStoreError::Internal {
+                    message: "remote thread-store request could not be constructed".to_string(),
+                });
+            }
+            Err(error) => Err(error),
+        };
+        attempt = attempt.saturating_add(1);
+        if attempt == 1 || attempt.is_multiple_of(10) {
+            tracing::warn!(
+                attempt,
+                http_status = result.ok(),
+                "remote thread-store unavailable; retaining operation and retrying until acknowledged"
+            );
+        }
+        let delay = Duration::from_millis(250 * (1_u64 << attempt.min(5)));
+        tokio::time::sleep(retry_after.unwrap_or(delay)).await;
+    }
+}
+
+#[cfg(test)]
+#[path = "retry_tests.rs"]
+pub(super) mod tests;
