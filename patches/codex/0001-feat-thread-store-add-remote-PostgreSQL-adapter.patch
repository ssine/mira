+
+/// Experimental HTTP thread store backed by a server-owned durable event log.
+///
+/// Thread semantics remain delegated to the in-memory implementation, while the adapter caches a
+/// materialized view and submits per-thread append, replace, or delete deltas with optimistic
+/// concurrency control. PostgreSQL remains the only durable source of truth.
+#[derive(Clone)]
+pub struct RemoteHttpThreadStore {
+    client: reqwest::Client,
+    store_url: String,
+    bearer_token: String,
+    operation_gate: Arc<tokio::sync::Semaphore>,
+    cache: Arc<std::sync::Mutex<Option<CachedStore>>>,
+    write_error: Arc<std::sync::Mutex<Option<String>>>,
+    thread_write_errors: Arc<std::sync::Mutex<HashMap<ThreadId, String>>>,
+    write_tail: Arc<std::sync::Mutex<Option<tokio::sync::watch::Receiver<bool>>>>,
+}
+
+impl RemoteHttpThreadStore {
+    pub fn new(
+        endpoint: impl Into<String>,
+        store_id: impl Into<String>,
+        bearer_token: impl Into<String>,
+    ) -> Self {
+        let endpoint = endpoint.into();
+        let store_id = store_id.into();
+        Self {
+            client: reqwest::Client::new(),
+            store_url: format!("{}/v2/stores/{store_id}", endpoint.trim_end_matches('/')),
+            bearer_token: bearer_token.into(),
+            operation_gate: Arc::new(tokio::sync::Semaphore::new(1)),
+            cache: Arc::new(std::sync::Mutex::new(None)),
+            write_error: Arc::new(std::sync::Mutex::new(None)),
+            thread_write_errors: Arc::new(std::sync::Mutex::new(HashMap::new())),
+            write_tail: Arc::new(std::sync::Mutex::new(None)),
+        }
+    }
+
+    fn take_cache(&self) -> Option<CachedStore> {
+        self.cache
+            .lock()
+            .unwrap_or_else(std::sync::PoisonError::into_inner)
+            .take()
+    }
+
+    fn replace_cache(&self, cache: Option<CachedStore>) {
+        *self
+            .cache
+            .lock()
+            .unwrap_or_else(std::sync::PoisonError::into_inner) = cache;
+    }
+
+    async fn head(&self) -> ThreadStoreResult<HeadResponse> {
+        request_json(
+            self.client
+                .get(&self.store_url)
+                .bearer_auth(&self.bearer_token)
+                .timeout(Duration::from_secs(10)),
+        )
+        .await
+    }
+
+    async fn load(&self, head: HeadResponse) -> ThreadStoreResult<CachedStore> {
+        let HeadResponse {
+            version,
+            state,
+            mut history_manifest,
+        } = head;
+        let mut snapshot = match state.clone() {
+            serde_json::Value::Object(state) => state,
+            _ => {
+                return Err(ThreadStoreError::Internal {
+                    message: "remote thread-store state is not a JSON object".to_string(),
+                });
+            }
+        };
+        let incompatible = filter_incompatible_threads(&mut snapshot, cfg!(windows));
+        for thread_id in incompatible {
+            history_manifest.remove(&thread_id);
+        }
+        snapshot.insert("histories".to_string(), serde_json::json!({}));
+        Ok(CachedStore {
+            version,
+            canonical_state: state,
+            history_manifest,
+            loaded_histories: HashSet::new(),
+            store: InMemoryThreadStore::from_snapshot(Some(serde_json::Value::Object(snapshot)))?,
+        })
+    }
+
+    async fn ensure_history(
+        &self,
+        cached: &mut CachedStore,
+        thread_id: ThreadId,
+    ) -> ThreadStoreResult<()> {
+        if cached.loaded_histories.contains(&thread_id) {
+            return Ok(());
+        }
+        let thread_id_text = thread_id.to_string();
+        if let Some(entry) = cached.history_manifest.get(&thread_id_text) {
+            let history: HistoryResponse = request_json(
+                self.client
+                    .get(format!(
+                        "{}/threads/{thread_id_text}/history?generation={}&throughVersion={}",
+                        self.store_url, entry.generation, cached.version
+                    ))
+                    .bearer_auth(&self.bearer_token)
+                    .timeout(Duration::from_secs(120)),
+            )
+            .await?;
+            if history.generation != entry.generation || history.item_count != entry.item_count {
+                return Err(ThreadStoreError::Conflict {
+                    message: format!("remote history changed while loading thread {thread_id}"),
+                });
+            }
+            cached
+                .store
+                .install_history(thread_id, history.items)
+                .await?;
+        }
+        cached.loaded_histories.insert(thread_id);
+        Ok(())
+    }
+
+    async fn refresh(&self, cache: &mut Option<CachedStore>) -> ThreadStoreResult<()> {
+        let head = self.head().await?;
+        if cache
+            .as_ref()
+            .is_some_and(|cached| cached.version == head.version)
+        {
+            return Ok(());
+        }
+        *cache = Some(self.load(head).await?);
+        Ok(())
+    }
+
+    async fn save(
+        &self,
+        version: u64,
+        manifest: &HashMap<String, HistoryManifestEntry>,
+        canonical_state: &mut serde_json::Value,
+        before: serde_json::Value,
+        after: serde_json::Value,
+    ) -> ThreadStoreResult<Option<CommitResponse>> {
+        let (before_state, before_histories) = split_snapshot(before)?;
+        let (after_state, after_histories) = split_snapshot(after)?;
+        let state_changes = canonical_changes(&before_state, &after_state, canonical_state)?;
+        let thread_ids = before_histories
+            .keys()
+            .chain(after_histories.keys())
+            .cloned()
+            .collect::<HashSet<_>>();
+        let mut history_changes = Vec::new();
+        for thread_id in thread_ids {
+            let before_items = before_histories.get(&thread_id);
+            let after_items = after_histories.get(&thread_id);
+            if before_items == after_items {
+                continue;
+            }
+            let current = manifest.get(&thread_id);
+            let expected_generation = current.map_or(0, |entry| entry.generation);
+            let expected_item_count = current.map_or(0, |entry| entry.item_count);
+            let (mode, items) = match (before_items, after_items) {
+                (_, None) => ("delete", None),
+                (Some(before), Some(after)) if is_prefix(before, after) => {
+                    ("append", Some(after[before.len()..].to_vec()))
+                }
+                (None, Some(after)) => ("append", Some(after.clone())),
+                (Some(_), Some(after)) => ("replace", Some(after.clone())),
+            };
+            history_changes.push(HistoryChange {
+                thread_id,
+                mode,
+                expected_generation,
+                expected_item_count,
+                items,
+            });
+        }
+        if state_changes.is_empty() && history_changes.is_empty() {
+            return Ok(None);
+        }
+        let operation_id = ThreadId::new().to_string();
+        let request = CommitRequest {
+            expected_version: version,
+            state_changes,
+            history_changes,
+        };
+        let committed = request_json(
+            self.client
+                .post(format!("{}/commits", self.store_url))
+                .bearer_auth(&self.bearer_token)
+                .header("x-codex-operation-id", operation_id)
+                .header("x-codex-version", env!("CARGO_PKG_VERSION"))
+                .timeout(Duration::from_secs(10))
+                .json(&request),
+        )
+        .await?;
+        apply_canonical_changes(canonical_state, &request.state_changes)?;
+        Ok(Some(committed))
+    }
+
+    async fn read<T: Send>(
+        &self,
+        thread_ids: Vec<ThreadId>,
+        operation: impl for<'a> FnOnce(&'a InMemoryThreadStore) -> ThreadStoreFuture<'a, T> + Send,
+    ) -> ThreadStoreResult<T> {
+        let _permit = self
+            .operation_gate
+            .acquire()
+            .await
+            .map_err(|_| operation_gate_closed())?;
+        self.check_write_error()?;
+        let mut cache = self.take_cache();
+        let result = async {
+            self.refresh(&mut cache).await?;
+            let cached = cache.as_mut().ok_or_else(cache_missing)?;
+            for thread_id in thread_ids {
+                self.ensure_history(cached, thread_id).await?;
+            }
+            operation(&cached.store).await
+        }
+        .await;
+        self.replace_cache(cache);
+        result
+    }
+}
+
+fn cwd_is_compatible(cwd: &str, windows: bool) -> bool {
+    if cwd.is_empty() {
+        return true;
+    }
+    if windows {
+        let bytes = cwd.as_bytes();
+        return cwd.starts_with("\\\\")
+            || bytes.get(1).is_some_and(|separator| *separator == b':')
+                && bytes
+                    .get(2)
+                    .is_some_and(|separator| *separator == b'\\' || *separator == b'/')
+                && bytes.first().is_some_and(u8::is_ascii_alphabetic);
+    }
+    cwd.starts_with('/')
+}
+
+fn filter_incompatible_threads(
+    state: &mut serde_json::Map<String, serde_json::Value>,
+    windows: bool,
+) -> HashSet<String> {
+    let incompatible = state
+        .get("created_threads")
+        .and_then(serde_json::Value::as_object)
+        .into_iter()
+        .flat_map(|threads| threads.iter())
+        .filter_map(|(thread_id, created)| {
+            let cwd = created
+                .pointer("/metadata/cwd")
+                .and_then(serde_json::Value::as_str)
+                .unwrap_or_default();
+            (!cwd_is_compatible(cwd, windows)).then(|| thread_id.clone())
+        })
+        .collect::<HashSet<_>>();
+    for field in [
+        "created_threads",
+        "metadata_updates",
+        "sections",
+        "section_positions",
+        "section_entered_at",
+        "names",
+    ] {
+        if let Some(values) = state
+            .get_mut(field)
+            .and_then(serde_json::Value::as_object_mut)
+        {
+            values.retain(|thread_id, _| !incompatible.contains(thread_id));
+        }
+    }
+    if let Some(paths) = state
+        .get_mut("rollout_paths")
+        .and_then(serde_json::Value::as_object_mut)
+    {
+        paths.retain(|_, thread_id| {
+            thread_id
+                .as_str()
+                .is_none_or(|thread_id| !incompatible.contains(thread_id))
+        });
+    }
+    incompatible
+}
+
+fn split_snapshot(
+    snapshot: serde_json::Value,
+) -> ThreadStoreResult<(serde_json::Value, HashMap<String, Vec<serde_json::Value>>)> {
+    let mut state = match snapshot {
+        serde_json::Value::Object(state) => state,
+        _ => {
+            return Err(ThreadStoreError::Internal {
+                message: "thread-store snapshot is not a JSON object".to_string(),
+            });
+        }
+    };
+    let histories = state
+        .remove("histories")
+        .unwrap_or_else(|| serde_json::json!({}));
+    let histories =
+        serde_json::from_value(histories).map_err(|error| ThreadStoreError::Internal {
+            message: format!("thread-store histories are invalid: {error}"),
+        })?;
+    Ok((serde_json::Value::Object(state), histories))
+}
+
+fn is_prefix(before: &[serde_json::Value], after: &[serde_json::Value]) -> bool {
+    before.len() <= after.len() && before.iter().zip(after).all(|(left, right)| left == right)
+}
+
+fn state_changes(
+    before: &serde_json::Value,
+    after: &serde_json::Value,
+) -> ThreadStoreResult<Vec<StateChange>> {
+    let before = before
+        .as_object()
+        .ok_or_else(|| ThreadStoreError::Internal {
+            message: "thread-store state is not a JSON object".to_string(),
+        })?;
+    let after = after
+        .as_object()
+        .ok_or_else(|| ThreadStoreError::Internal {
+            message: "thread-store state is not a JSON object".to_string(),
+        })?;
+    let mut changes = Vec::new();
+    diff_state_objects(Vec::new(), before, after, &mut changes);
+    Ok(changes)
+}
+
+fn diff_state_objects(
+    path: Vec<String>,
+    before: &serde_json::Map<String, serde_json::Value>,
+    after: &serde_json::Map<String, serde_json::Value>,
+    changes: &mut Vec<StateChange>,
+) {
+    let keys = before
+        .keys()
+        .chain(after.keys())
+        .cloned()
+        .collect::<HashSet<_>>();
+    for key in keys {
+        let before_value = before.get(&key);
+        let after_value = after.get(&key);
+        if before_value == after_value {
+            continue;
+        }
+        let mut child_path = path.clone();
+        child_path.push(key);
+        if let (Some(before_map), Some(after_map)) = (
+            before_value.and_then(serde_json::Value::as_object),
+            after_value.and_then(serde_json::Value::as_object),
+        ) {
+            diff_state_objects(child_path, before_map, after_map, changes);
+            continue;
+        }
+        changes.push(StateChange {
+            conflict_policy: state_conflict_policy(&child_path),
+            path: child_path,
+            mode: if after_value.is_some() {
+                "set"
+            } else {
+                "remove"
+            },
+            expected: StateExpectation {
+                exists: before_value.is_some(),
+                value: before_value.cloned(),
+            },
+            value: after_value.cloned(),
+        });
+    }
+}
+
+fn canonical_changes(
+    before: &serde_json::Value,
+    after: &serde_json::Value,
+    canonical: &serde_json::Value,
+) -> ThreadStoreResult<Vec<StateChange>> {
+    let mut changes = state_changes(before, after)?;
+    for change in &mut changes {
+        let raw = change
+            .path
+            .iter()
+            .try_fold(canonical, |value, key| value.get(key));
+        change.expected = StateExpectation {
+            exists: raw.is_some(),
+            value: raw.cloned(),
+        };
+    }
+    Ok(changes)
+}
+
+fn apply_canonical_changes(
+    canonical: &mut serde_json::Value,
+    changes: &[StateChange],
+) -> ThreadStoreResult<()> {
+    // Apply only explicitly changed leaves. Keep unknown fields and platform-filtered threads.
+    for change in changes {
+        let (key, parents) = change.path.split_last().ok_or_else(cache_missing)?;
+        let mut target = &mut *canonical;
+        for parent in parents {
+            target = target
+                .as_object_mut()
+                .ok_or_else(cache_missing)?
+                .entry(parent.clone())
+                .or_insert_with(|| serde_json::json!({}));
+        }
+        let object = target.as_object_mut().ok_or_else(cache_missing)?;
+        if let Some(value) = &change.value {
+            object.insert(key.clone(), value.clone());
+        } else {
+            object.remove(key);
+        }
+    }
+    Ok(())
+}
+
+fn state_conflict_policy(path: &[String]) -> &'static str {
+    if path
+        .first()
+        .is_some_and(|field| field == "metadata_updates")
+        && path.get(2).is_some_and(|field| {
+            matches!(
+                field.as_str(),
+                "updated_at" | "advance_recency_at" | "token_usage"
+            )
+        })
+    {
+        "lastWriteWins"
+    } else {
+        "compareAndSwap"
+    }
+}
+
+impl ThreadStore for RemoteHttpThreadStore {
+    fn as_any(&self) -> &dyn std::any::Any {
+        self
+    }
+
+    fn create_thread(&self, params: CreateThreadParams) -> ThreadStoreFuture<'_, ()> {
+        let thread_id = params.thread_id;
+        Box::pin(self.mutate(vec![thread_id], move |store| {
+            ThreadStore::create_thread(store, params)
+        }))
+    }
+
+    fn resume_thread(&self, params: ResumeThreadParams) -> ThreadStoreFuture<'_, ()> {
+        let thread_id = params.thread_id;
+        Box::pin(self.mutate(vec![thread_id], move |store| {
+            ThreadStore::resume_thread(store, params)
+        }))
+    }
+
+    fn append_items(&self, params: AppendThreadItemsParams) -> ThreadStoreFuture<'_, ()> {
+        // Streaming deltas are transient in both history modes. Filtering only
+        // inside InMemoryThreadStore is too late: mutate has already downloaded
+        // the head/history and cloned snapshots, once for every displayed token.
+        // Check both modes without reading metadata; any potentially durable
+        // item still follows the ordered, acknowledged writer unchanged.
+        if params.items.iter().all(|item| {
+            !is_persisted_rollout_item(item, ThreadHistoryMode::Legacy)
+                && !is_persisted_rollout_item(item, ThreadHistoryMode::Paginated)
+        }) {
+            return Box::pin(async move { self.check_thread_write_errors(&[params.thread_id]) });
+        }
+        let thread_id = params.thread_id;
+        Box::pin(self.mutate(vec![thread_id], move |store| {
+            ThreadStore::append_items(store, params)
+        }))
+    }
+
+    fn persist_thread(
+        &self,
+        thread_id: ThreadId,
+        context: PersistContext,
+    ) -> ThreadStoreFuture<'_, ()> {
+        Box::pin(self.read(Vec::new(), move |store| {
+            ThreadStore::persist_thread(store, thread_id, context)
+        }))
+    }
+
+    fn flush_thread(&self, thread_id: ThreadId) -> ThreadStoreFuture<'_, ()> {
+        Box::pin(async move {
+            // Mutations are acknowledged synchronously. This is a cheap ordered durability
+            // barrier, including writes whose callers were cancelled, not another head download.
+            let pending = self
+                .write_tail
+                .lock()
+                .unwrap_or_else(std::sync::PoisonError::into_inner)
+                .clone();
+            if let Some(mut pending) = pending {
+                pending.wait_for(|finished| *finished).await.map_err(|_| {
+                    ThreadStoreError::Internal {
+                        message: "remote thread-store write worker stopped before acknowledgement"
+                            .to_string(),
+                    }
+                })?;
+            }
+            let _permit = self
+                .operation_gate
+                .acquire()
+                .await
+                .map_err(|_| operation_gate_closed())?;
+            self.check_thread_write_errors(&[thread_id])
+        })
+    }
+
+    fn shutdown_thread(&self, thread_id: ThreadId) -> ThreadStoreFuture<'_, ()> {
+        Box::pin(self.read(Vec::new(), move |store| {
+            ThreadStore::shutdown_thread(store, thread_id)
+        }))
+    }
+
+    fn discard_thread(&self, thread_id: ThreadId) -> ThreadStoreFuture<'_, ()> {
+        Box::pin(self.read(Vec::new(), move |store| {
+            ThreadStore::discard_thread(store, thread_id)
+        }))
+    }
+
+    fn load_history(
+        &self,
+        params: LoadThreadHistoryParams,
+    ) -> ThreadStoreFuture<'_, StoredThreadHistory> {
+        let thread_id = params.thread_id;
+        Box::pin(self.read(vec![thread_id], move |store| {
+            ThreadStore::load_history(store, params)
+        }))
+    }
+
+    fn load_latest_model_context(
+        &self,
+        params: LoadThreadHistoryParams,
+    ) -> ThreadStoreFuture<'_, StoredModelContext> {
+        let thread_id = params.thread_id;
+        Box::pin(self.read(vec![thread_id], move |store| {
+            ThreadStore::load_latest_model_context(store, params)
+        }))
+    }
+
+    fn read_thread(&self, params: ReadThreadParams) -> ThreadStoreFuture<'_, StoredThread> {
+        let histories = params
+            .include_history
+            .then_some(params.thread_id)
+            .into_iter()
+            .collect();
+        Box::pin(self.read(histories, move |store| {
+            ThreadStore::read_thread(store, params)
+        }))
+    }
+
+    fn read_thread_by_rollout_path(
+        &self,
+        params: ReadThreadByRolloutPathParams,
+    ) -> ThreadStoreFuture<'_, StoredThread> {
+        Box::pin(async move {
+            if !params.include_history {
+                return self
+                    .read(Vec::new(), move |store| {
+                        ThreadStore::read_thread_by_rollout_path(store, params)
+                    })
+                    .await;
+            }
+            let mut metadata_params = params.clone();
+            metadata_params.include_history = false;
+            let thread = self
+                .read(Vec::new(), move |store| {
+                    ThreadStore::read_thread_by_rollout_path(store, metadata_params)
+                })
+                .await?;
+            self.read(vec![thread.thread_id], move |store| {
+                ThreadStore::read_thread_by_rollout_path(store, params)
+            })
+            .await
+        })
+    }
+
+    fn list_threads(&self, params: ListThreadsParams) -> ThreadStoreFuture<'_, ThreadPage> {
+        Box::pin(self.read(Vec::new(), move |store| {
+            ThreadStore::list_threads(store, params)
+        }))
+    }
+
+    fn update_thread_metadata(
+        &self,
+        params: UpdateThreadMetadataParams,
+    ) -> ThreadStoreFuture<'_, Option<StoredThread>> {
+        Box::pin(self.mutate_metadata(params.thread_id, move |store| {
+            ThreadStore::update_thread_metadata(store, params)
+        }))
+    }
+
+    fn move_thread_to_section(
+        &self,
+        params: MoveThreadToSectionParams,
+    ) -> ThreadStoreFuture<'_, ()> {
+        Box::pin(self.mutate_metadata(params.thread_id, move |store| {
+            ThreadStore::move_thread_to_section(store, params)
+        }))
+    }
+
+    fn archive_thread(&self, params: ArchiveThreadParams) -> ThreadStoreFuture<'_, ()> {
+        Box::pin(self.read(Vec::new(), move |store| {
+            ThreadStore::archive_thread(store, params)
+        }))
+    }
+
+    fn unarchive_thread(&self, params: ArchiveThreadParams) -> ThreadStoreFuture<'_, StoredThread> {
+        Box::pin(self.read(Vec::new(), move |store| {
+            ThreadStore::unarchive_thread(store, params)
+        }))
+    }
+
+    fn delete_thread(&self, params: DeleteThreadParams) -> ThreadStoreFuture<'_, ()> {
+        let thread_id = params.thread_id;
+        Box::pin(self.mutate(vec![thread_id], move |store| {
+            ThreadStore::delete_thread(store, params)
+        }))
+    }
+}
+
+fn cache_missing() -> ThreadStoreError {
+    ThreadStoreError::Internal {
+        message: "remote thread-store cache was not initialized".to_string(),
+    }
+}
+
+fn operation_gate_closed() -> ThreadStoreError {
+    ThreadStoreError::Internal {
+        message: "remote thread-store operation gate was closed".to_string(),
+    }
+}
