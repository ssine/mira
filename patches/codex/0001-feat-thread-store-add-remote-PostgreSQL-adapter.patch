+++ b/codex-rs/thread-store/src/remote_http/writer.rs
@@ -0,0 +1,330 @@
+use std::collections::HashSet;
+use std::panic::AssertUnwindSafe;
+
+use codex_protocol::ThreadId;
+use futures::FutureExt;
+
+use super::CommitRequest;
+use super::CommitResponse;
+use super::HistoryChange;
+use super::RemoteHttpThreadStore;
+use super::cache_missing;
+use super::operation_gate_closed;
+use super::request_json;
+use crate::AppendThreadItemsParams;
+use crate::InMemoryThreadStore;
+use crate::ThreadStoreError;
+use crate::ThreadStoreFuture;
+use crate::ThreadStoreResult;
+use codex_protocol::protocol::ThreadHistoryMode;
+use codex_rollout::persisted_rollout_items;
+use std::time::Duration;
+
+// The serialized writer outlives cancelled callers, but has no local durable outbox.
+impl RemoteHttpThreadStore {
+    /// Graph mutations share the history writer queue and survive caller cancellation.
+    pub async fn write_agent_graph(
+        &self,
+        thread_ids: Vec<ThreadId>,
+        body: serde_json::Value,
+    ) -> ThreadStoreResult<()> {
+        self.enqueue_write(thread_ids.clone(), move |store| {
+            Box::pin(async move {
+                store
+                    .request_agent_graph(body)
+                    .await
+                    .map(|_| ())
+                    .inspect_err(|error| store.record_write_error(error, &thread_ids))
+            })
+        })
+        .await
+    }
+
+    pub(super) async fn mutate<T: Send + 'static>(
+        &self,
+        thread_ids: Vec<ThreadId>,
+        operation: impl for<'a> FnOnce(&'a InMemoryThreadStore) -> ThreadStoreFuture<'a, T>
+        + Send
+        + 'static,
+    ) -> ThreadStoreResult<T> {
+        self.mutate_scoped(thread_ids, true, operation).await
+    }
+
+    pub(super) async fn mutate_metadata<T: Send + 'static>(
+        &self,
+        thread_id: ThreadId,
+        operation: impl for<'a> FnOnce(&'a InMemoryThreadStore) -> ThreadStoreFuture<'a, T>
+        + Send
+        + 'static,
+    ) -> ThreadStoreResult<T> {
+        self.mutate_scoped(vec![thread_id], false, operation).await
+    }
+
+    async fn mutate_scoped<T: Send + 'static>(
+        &self,
+        thread_ids: Vec<ThreadId>,
+        load_histories: bool,
+        operation: impl for<'a> FnOnce(&'a InMemoryThreadStore) -> ThreadStoreFuture<'a, T>
+        + Send
+        + 'static,
+    ) -> ThreadStoreResult<T> {
+        self.enqueue_write(thread_ids.clone(), move |store| {
+            Box::pin(async move {
+                store
+                    .mutate_inner(thread_ids, load_histories, operation)
+                    .await
+            })
+        })
+        .await
+    }
+
+    async fn enqueue_write<T: Send + 'static>(
+        &self,
+        thread_ids: Vec<ThreadId>,
+        operation: impl FnOnce(Self) -> ThreadStoreFuture<'static, T> + Send + 'static,
+    ) -> ThreadStoreResult<T> {
+        let store = self.clone();
+        let (done, receiver) = tokio::sync::watch::channel(false);
+        let previous = store
+            .write_tail
+            .lock()
+            .unwrap_or_else(std::sync::PoisonError::into_inner)
+            .replace(receiver);
+        // Dropping the caller (e.g. turn/interrupt) must not drop a completed tool's result.
+        // Only process shutdown can abandon this in-memory, unacknowledged operation.
+        tokio::spawn(async move {
+            if let Some(mut previous) = previous {
+                let _ = previous.wait_for(|finished| *finished).await;
+            }
+            let _permit = store
+                .operation_gate
+                .acquire()
+                .await
+                .map_err(|_| operation_gate_closed())?;
+            let result = match AssertUnwindSafe(async {
+                store.check_thread_write_errors(&thread_ids)?;
+                operation(store.clone()).await
+            })
+            .catch_unwind()
+            .await
+            {
+                Ok(result) => result,
+                Err(_) => {
+                    let error = ThreadStoreError::Internal {
+                        message: "remote thread-store write worker failed".to_string(),
+                    };
+                    store.record_write_error(&error, &[]);
+                    Err(error)
+                }
+            };
+            done.send_replace(true);
+            result
+        })
+        .await
+        .map_err(|_| ThreadStoreError::Internal {
+            message: "remote thread-store write worker failed".to_string(),
+        })?
+    }
+
+    pub(super) async fn append_records(
+        &self,
+        params: AppendThreadItemsParams,
+    ) -> ThreadStoreResult<()> {
+        let thread_id = params.thread_id;
+        self.enqueue_write(vec![thread_id], move |store| {
+            Box::pin(async move {
+                let result = async {
+                    let head = store.head_for_thread(Some(thread_id)).await?;
+                    let key = thread_id.to_string();
+                    let entry = head
+                        .history_manifest
+                        .get(&key)
+                        .ok_or(ThreadStoreError::ThreadNotFound { thread_id })?;
+                    let mode = head
+                        .state
+                        .pointer(&format!("/created_threads/{key}/history_mode"))
+                        .cloned()
+                        .and_then(|value| serde_json::from_value::<ThreadHistoryMode>(value).ok())
+                        .unwrap_or(ThreadHistoryMode::Legacy);
+                    let items = persisted_rollout_items(&params.items, mode);
+                    if items.is_empty() {
+                        return Ok(());
+                    }
+                    let values = items
+                        .iter()
+                        .map(serde_json::to_value)
+                        .collect::<Result<Vec<_>, _>>()
+                        .map_err(|error| ThreadStoreError::Internal {
+                            message: error.to_string(),
+                        })?;
+                    let mut request = CommitRequest {
+                        expected_version: head.version,
+                        state_changes: Vec::new(),
+                        history_changes: vec![HistoryChange {
+                            thread_id: key.clone(),
+                            mode: "append",
+                            expected_generation: entry.generation,
+                            expected_item_count: entry.item_count,
+                            items: Some(values),
+                            items_upload_id: None,
+                        }],
+                    };
+                    store.stage_large_histories(&mut request).await?;
+                    let _: CommitResponse = request_json(
+                        store
+                            .client
+                            .post(format!("{}/commits", store.store_url))
+                            .headers(store.account_headers.clone())
+                            .bearer_auth(&store.bearer_token)
+                            .header("x-codex-operation-id", ThreadId::new().to_string())
+                            .header("x-codex-version", env!("CARGO_PKG_VERSION"))
+                            .header("x-mira-thread-scope", key)
+                            .timeout(Duration::from_secs(120))
+                            .json(&request),
+                    )
+                    .await?;
+                    Ok(())
+                }
+                .await;
+                // Metadata/history caches may describe the prefix before this commit.
+                store.replace_cache(None);
+                if let Err(error) = &result {
+                    store.record_write_error(error, &[thread_id]);
+                }
+                result
+            })
+        })
+        .await
+    }
+
+    fn record_write_error(&self, error: &ThreadStoreError, thread_ids: &[ThreadId]) {
+        if matches!(
+            error,
+            ThreadStoreError::Conflict { .. } | ThreadStoreError::InvalidRequest { .. }
+        ) && !thread_ids.is_empty()
+        {
+            let mut failures = self
+                .thread_write_errors
+                .lock()
+                .unwrap_or_else(std::sync::PoisonError::into_inner);
+            for thread_id in thread_ids {
+                failures
+                    .entry(*thread_id)
+                    .or_insert_with(|| error.to_string());
+            }
+            return;
+        }
+        let mut failure = self
+            .write_error
+            .lock()
+            .unwrap_or_else(std::sync::PoisonError::into_inner);
+        if failure.is_none() {
+            *failure = Some(error.to_string());
+        }
+    }
+
+    pub(super) fn check_write_error(&self) -> ThreadStoreResult<()> {
+        match self
+            .write_error
+            .lock()
+            .unwrap_or_else(std::sync::PoisonError::into_inner)
+            .as_ref()
+        {
+            Some(message) => Err(ThreadStoreError::Internal {
+                message: format!(
+                    "conversation storage failed; fix the connection/permissions and restart the runtime: {message}"
+                ),
+            }),
+            None => Ok(()),
+        }
+    }
+
+    pub(super) fn check_thread_write_errors(
+        &self,
+        thread_ids: &[ThreadId],
+    ) -> ThreadStoreResult<()> {
+        self.check_write_error()?;
+        let failures = self
+            .thread_write_errors
+            .lock()
+            .unwrap_or_else(std::sync::PoisonError::into_inner);
+        for thread_id in thread_ids {
+            if let Some(message) = failures.get(thread_id) {
+                return Err(ThreadStoreError::Conflict {
+                    message: format!(
+                        "conversation {thread_id} storage write failed; this conversation is paused to protect history; resolve the error and restart the runtime: {message}"
+                    ),
+                });
+            }
+        }
+        Ok(())
+    }
+
+    async fn mutate_inner<T: Send>(
+        &self,
+        thread_ids: Vec<ThreadId>,
+        load_histories: bool,
+        operation: impl for<'a> FnOnce(&'a InMemoryThreadStore) -> ThreadStoreFuture<'a, T> + Send,
+    ) -> ThreadStoreResult<T> {
+        let mut cache = self.take_cache();
+        let mut invalidate_cache = false;
+        let result = async {
+            self.refresh_scoped(&mut cache, (thread_ids.len() == 1).then(|| thread_ids[0]))
+                .await
+                .inspect_err(|error| self.record_write_error(error, &thread_ids))?;
+            let cached = cache.as_mut().ok_or_else(cache_missing)?;
+            let selected = if load_histories {
+                thread_ids.iter().copied().collect::<HashSet<_>>()
+            } else {
+                HashSet::new()
+            };
+            for thread_id in &selected {
+                self.ensure_history(cached, *thread_id)
+                    .await
+                    .inspect_err(|error| self.record_write_error(error, &thread_ids))?;
+            }
+            let before = cached.store.snapshot_for_threads(&selected).await?;
+            let output = match operation(&cached.store).await {
+                Ok(output) => output,
+                Err(error) => {
+                    invalidate_cache = true;
+                    return Err(error);
+                }
+            };
+            let after = cached.store.snapshot_for_threads(&selected).await?;
+            match self
+                .save(
+                    cached.version,
+                    cached.scope,
+                    &cached.history_manifest,
+                    &mut cached.canonical_state,
+                    before,
+                    after,
+                )
+                .await
+            {
+                Ok(Some(committed)) => {
+                    if committed.rebased {
+                        invalidate_cache = true;
+                    } else {
+                        cached.version = committed.version;
+                        cached.history_manifest = committed.history_manifest;
+                    }
+                }
+                Ok(None) => {}
+                Err(error) => {
+                    invalidate_cache = true;
+                    self.record_write_error(&error, &thread_ids);
+                    return Err(error);
+                }
+            }
+            Ok(output)
+        }
+        .await;
+        if invalidate_cache {
+            cache = None;
+        }
+        self.replace_cache(cache);
+        result
+    }
+}
