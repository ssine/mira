+                .json(&json!({"items": ["one tool result"]})),
+        ),
+    )
+    .await
+    .unwrap()
+    .unwrap();
+    assert_eq!(response, json!({"version": 1}));
+    handle.await.unwrap();
+    let first = requests.recv().await.unwrap();
+    for _ in 0..3 {
+        assert_eq!(requests.recv().await.unwrap(), first);
+    }
+}
+
+#[tokio::test]
+async fn does_not_retry_or_disclose_authorization_or_conflict_response_bodies() {
+    for status in [400, 401, 403, 409] {
+        let (url, mut requests, handle) =
+            server(vec![Some((status, "secret diagnostic".to_string()))]).await;
+        let error = request_json::<serde_json::Value>(reqwest::Client::new().post(url))
+            .await
