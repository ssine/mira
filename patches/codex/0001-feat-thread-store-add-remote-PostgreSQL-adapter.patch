+use std::time::Duration;
+
+use codex_protocol::ThreadId;
+use pretty_assertions::assert_eq;
+use serde_json::json;
+use tokio::io::AsyncReadExt;
+use tokio::io::AsyncWriteExt;
+use tokio::sync::mpsc;
+use tokio::sync::oneshot;
+
+use super::RemoteHttpThreadStore;
+use super::retry::tests::create;
+use crate::ReadThreadParams;
+use crate::ThreadStore;
+
+struct Request {
+    raw: String,
+    reply: oneshot::Sender<serde_json::Value>,
+}
+
+struct Server {
+    requests: mpsc::UnboundedReceiver<Request>,
+    task: tokio::task::JoinHandle<()>,
+}
+
+impl Drop for Server {
+    fn drop(&mut self) {
+        self.task.abort();
+    }
+}
+
+impl Server {
+    async fn new() -> (RemoteHttpThreadStore, Self) {
+        let listener = tokio::net::TcpListener::bind("127.0.0.1:0").await.unwrap();
+        let store = RemoteHttpThreadStore::new(
+            format!("http://{}", listener.local_addr().unwrap()),
+            "test",
+            "test-token",
+        );
+        let (tx, requests) = mpsc::unbounded_channel();
+        let task = tokio::spawn(async move {
+            let mut connections = tokio::task::JoinSet::new();
+            loop {
+                let (mut stream, _) = listener.accept().await.unwrap();
+                let tx = tx.clone();
+                connections.spawn(async move {
+                    let mut bytes = Vec::new();
+                    loop {
+                        let mut buffer = [0; 4096];
+                        let count = stream.read(&mut buffer).await.unwrap();
+                        assert!(count > 0);
+                        bytes.extend_from_slice(&buffer[..count]);
+                        if let Some(end) = bytes.windows(4).position(|part| part == b"\r\n\r\n") {
+                            let header = String::from_utf8_lossy(&bytes[..end]).to_lowercase();
+                            let length = header.lines()
+                                .find_map(|line| line.strip_prefix("content-length: "))
+                                .map(|value| value.parse::<usize>().unwrap()).unwrap_or(0);
+                            if bytes.len() >= end + 4 + length { break; }
+                        }
+                    }
+                    let (reply, result) = oneshot::channel();
+                    if tx.send(Request { raw: String::from_utf8(bytes).unwrap(), reply }).is_err() { return; }
+                    let Ok(body) = result.await else { return; };
+                    let body = body.to_string();
+                    let response = format!("HTTP/1.1 200 OK\r\nContent-Type: application/json\r\nContent-Length: {}\r\nConnection: close\r\n\r\n{body}", body.len());
+                    let _ = stream.write_all(response.as_bytes()).await;
+                });
+                while connections.try_join_next().is_some() {}
+            }
+        });
+        (store, Self { requests, task })
+    }
+
+    async fn next(&mut self, prefix: &str) -> Request {
+        let request = tokio::time::timeout(Duration::from_secs(2), self.requests.recv())
+            .await
+            .expect("unrelated operation was blocked")
+            .unwrap();
+        assert!(
+            request.raw.starts_with(prefix),
+            "unexpected request: {}",
+            request.raw.lines().next().unwrap()
+        );
+        request
+    }
+
+    async fn create(&mut self, id: ThreadId, version: u64) {
+        self.next(&format!("GET /v2/stores/test?threadId={id} "))
+            .await
+            .reply
+            .send(json!({"version":version,"state":{},"historyManifest":{}}))
+            .unwrap();
+        self.next("POST /v2/stores/test/commits ")
+            .await
+            .reply
+            .send(json!({"version":version+1,"historyManifest":{}}))
+            .unwrap();
+    }
+}
+
+#[tokio::test]
+async fn slow_history_does_not_block_unrelated_creation_or_flush() {
+    let (store, mut server) = Server::new().await;
+    let large = ThreadId::new();
+    let reader = {
+        let store = store.clone();
+        tokio::spawn(async move {
+            store
+                .read_thread(ReadThreadParams {
+                    thread_id: large,
+                    include_archived: true,
+                    include_history: true,
+                })
+                .await
+        })
+    };
+    server
+        .next("GET ")
+        .await
+        .reply
+        .send(json!({"version":1,
+        "state":{"created_threads":{large.to_string():create(large, None)}},
+        "historyManifest":{large.to_string():{"generation":1,"itemCount":0}}}))
+        .unwrap();
+    let history = server
+        .next(&format!("GET /v2/stores/test/threads/{large}/history?"))
+        .await;
+    let fresh = ThreadId::new();
+    let writer = {
+        let store = store.clone();
+        tokio::spawn(async move {
+            store.create_thread(create(fresh, None)).await?;
+            store.flush_thread(fresh).await
+        })
+    };
+    server.create(fresh, 1).await;
+    tokio::time::timeout(Duration::from_secs(2), writer)
+        .await
+        .unwrap()
+        .unwrap()
+        .unwrap();
+    assert!(!reader.is_finished());
+    history
+        .reply
+        .send(json!({"generation":1,"itemCount":0,"items":[]}))
+        .unwrap();
+    reader.await.unwrap().unwrap();
+}
+
+#[tokio::test]
+async fn cancelled_parent_write_blocks_its_child_but_not_another_root() {
+    let (store, mut server) = Server::new().await;
+    let parent = ThreadId::new();
+    let writer = {
+        let store = store.clone();
+        tokio::spawn(async move { store.create_thread(create(parent, None)).await })
+    };
+    server
+        .next("GET ")
+        .await
+        .reply
+        .send(json!({"version":0,"state":{},"historyManifest":{}}))
+        .unwrap();
+    let pending = server.next("POST ").await;
+    writer.abort();
+    let child = ThreadId::new();
+    let child_writer = {
+        let store = store.clone();
+        tokio::spawn(async move { store.create_thread(create(child, Some(parent))).await })
+    };
+    let fresh = ThreadId::new();
+    let other = {
+        let store = store.clone();
+        tokio::spawn(async move {
+            store.create_thread(create(fresh, None)).await?;
+            store.flush_thread(fresh).await
+        })
+    };
+    server.create(fresh, 0).await;
+    tokio::time::timeout(Duration::from_secs(2), other)
+        .await
+        .unwrap()
+        .unwrap()
+        .unwrap();
+    assert!(!child_writer.is_finished());
+    assert!(
+        tokio::time::timeout(Duration::from_millis(50), store.flush_thread(parent))
+            .await
+            .is_err()
+    );
+    pending
+        .reply
+        .send(json!({"version":2,"historyManifest":{}}))
+        .unwrap();
+    server.create(child, 2).await;
+    child_writer.await.unwrap().unwrap();
+    store.flush_thread(parent).await.unwrap();
+    assert!(server.requests.try_recv().is_err());
+}
+
+fn head(id: ThreadId, version: u64, generation: u64, count: usize) -> serde_json::Value {
+    json!({"version":version,"state":{"created_threads":{id.to_string():create(id, None)}},
+        "historyManifest":{id.to_string():{"generation":generation,"itemCount":count}}})
+}
+
+fn message(text: &str) -> serde_json::Value {
+    json!({"type":"response_item","payload":{"type":"message","role":"assistant",
+        "content":[{"type":"output_text","text":text}]}})
+}
+
+async fn read(
+    store: RemoteHttpThreadStore,
+    id: ThreadId,
+) -> crate::ThreadStoreResult<crate::StoredThreadHistory> {
+    store
+        .load_history(crate::LoadThreadHistoryParams {
+            thread_id: id,
+            include_archived: true,
+        })
+        .await
+}
+
+#[tokio::test]
+async fn shutdown_revalidates_input_recovery_without_invalidating_other_threads() {
+    let (store, mut server) = Server::new().await;
+    let a = ThreadId::new();
+    let b = ThreadId::new();
+    let reasoning = json!({"type":"response_item","payload":{"type":"reasoning",
+        "id":"rs-old","summary":[],"content":null,"encrypted_content":"old-reasoning"}});
+    let items = json!([reasoning, message("preserved")]);
+    for id in [a, b] {
+        let reader = tokio::spawn(read(store.clone(), id));
+        server
+            .next("GET ")
+            .await
+            .reply
+            .send(head(id, 1, 1, 2))
+            .unwrap();
+        server
+            .next(&format!("GET /v2/stores/test/threads/{id}/history?"))
+            .await
+            .reply
+            .send(json!({"generation":1,"itemCount":2,"items":items}))
+            .unwrap();
+        assert_eq!(reader.await.unwrap().unwrap().items.len(), 2);
+    }
+    store.shutdown_thread(a).await.unwrap();
+    let reader = tokio::spawn(read(store.clone(), b));
+    server
+        .next("GET ")
+        .await
+        .reply
+        .send(head(b, 1, 1, 2))
+        .unwrap();
+    assert_eq!(reader.await.unwrap().unwrap().items.len(), 2);
+    assert!(server.requests.try_recv().is_err());
+
+    let reader = {
+        let store = store.clone();
+        tokio::spawn(async move {
+            store
+                .load_latest_model_context(crate::LoadThreadHistoryParams {
+                    thread_id: a,
+                    include_archived: true,
+                })
+                .await
+        })
+    };
+    // Consent is account metadata: canonical version and boundary are unchanged.
+    server
+        .next("GET ")
+        .await
+        .reply
+        .send(head(a, 1, 1, 2))
+        .unwrap();
+    server
+        .next(&format!("GET /v2/stores/test/threads/{a}/history?"))
+        .await
+        .reply
+        .send(json!({"generation":1,"itemCount":2,"items":items,
+            "inputRecovery":{"throughItemSeq":2,"policy":"omitReasoning"}}))
+        .unwrap();
+    let context = reader.await.unwrap().unwrap();
+    assert_eq!(
+        serde_json::to_value(context.items).unwrap(),
+        json!([message("preserved")])
+    );
+    let reader = tokio::spawn(read(store.clone(), a));
+    server
+        .next("GET ")
+        .await
+        .reply
+        .send(head(a, 1, 1, 2))
+        .unwrap();
+    assert_eq!(
+        serde_json::to_value(reader.await.unwrap().unwrap().items).unwrap(),
+        items
+    );
+    assert!(server.requests.try_recv().is_err());
+}
+
+#[tokio::test]
+async fn cached_history_survives_other_scopes_metadata_and_acknowledged_appends() {
+    let (store, mut server) = Server::new().await;
+    let a = ThreadId::new();
+    let b = ThreadId::new();
+    let heads = [head(a, 1, 1, 1), head(b, 2, 1, 1)];
+    for (id, head) in [a, b].into_iter().zip(&heads) {
+        let reader = tokio::spawn(read(store.clone(), id));
+        server.next("GET ").await.reply.send(head.clone()).unwrap();
+        server
+            .next(&format!("GET /v2/stores/test/threads/{id}/history?"))
+            .await
+            .reply
+            .send(json!({"generation":1,"itemCount":1,"items":[message("original")]}))
+            .unwrap();
+        assert_eq!(reader.await.unwrap().unwrap().items.len(), 1);
+    }
+    // Change metadata and global version, retaining the exact history boundary.
+    let mut changed = heads[0].clone();
+    changed["version"] = json!(3);
+    changed["state"]["names"] = json!({a.to_string():"renamed"});
+    let reader = tokio::spawn(read(store.clone(), a));
+    server
+        .next("GET ")
+        .await
+        .reply
+        .send(changed.clone())
+        .unwrap();
+    assert_eq!(
+        tokio::time::timeout(Duration::from_secs(2), reader)
+            .await
+            .unwrap()
+            .unwrap()
+            .unwrap()
+            .items
+            .len(),
+        1
+    );
+
+    let append = {
+        let store = store.clone();
+        tokio::spawn(async move {
+            store
+                .append_items(crate::AppendThreadItemsParams {
+                    thread_id: a,
+                    items: vec![serde_json::from_value(message("acknowledged")).unwrap()],
+                })
+                .await
+        })
+    };
+    server
+        .next("GET ")
+        .await
+        .reply
+        .send(changed.clone())
+        .unwrap();
+    let commit = server.next("POST ").await;
+    assert!(!append.is_finished());
+    commit
+        .reply
+        .send(json!({"version":4,"historyManifest":{a.to_string():{"generation":1,"itemCount":2}}}))
+        .unwrap();
+    append.await.unwrap().unwrap();
+    changed["version"] = json!(4);
+    changed["historyManifest"][a.to_string()]["itemCount"] = json!(2);
+    let reader = tokio::spawn(read(store.clone(), a));
+    server.next("GET ").await.reply.send(changed).unwrap();
+    let history = tokio::time::timeout(Duration::from_secs(2), reader)
+        .await
+        .unwrap()
+        .unwrap()
+        .unwrap();
+    assert_eq!(
+        serde_json::to_value(history.items).unwrap(),
+        json!([message("original"), message("acknowledged")])
+    );
+    assert!(server.requests.try_recv().is_err());
+}
+
+#[tokio::test]
+async fn cache_never_combines_generations_or_returns_a_deleted_thread() {
+    let (store, mut server) = Server::new().await;
+    let id = ThreadId::new();
+    let mut current = head(id, 1, 1, 1);
+    for generation in [1, 2] {
+        current["version"] = json!(generation);
+        current["historyManifest"][id.to_string()]["generation"] = json!(generation);
