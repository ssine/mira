+    let directory = tempfile::tempdir().unwrap();
+    let native_id = ThreadId::new();
+    let foreign_id = ThreadId::new();
+    let mut native = create(native_id, None);
+    native.metadata.cwd = Some(directory.path().to_path_buf());
+    native.runtime_workspace_roots = Some(vec![directory.path().abs()]);
