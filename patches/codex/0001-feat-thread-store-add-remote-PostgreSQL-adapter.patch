+    #[test]
+    fn state_diff_uses_leaf_paths_and_server_compatible_policies() {
+        let thread_id = "018f0000-0000-7000-8000-000000000001";
+        let before = serde_json::json!({
+            "metadata_updates": {
+                (thread_id): {
+                    "title": "old",
+                    "updated_at": 1,
+                    "token_usage": {"total_tokens": 10}
+                }
+            }
+        });
+        let after = serde_json::json!({
+            "metadata_updates": {
+                (thread_id): {
+                    "title": "new",
+                    "updated_at": 2,
+                    "token_usage": {"total_tokens": 11}
+                }
+            }
+        });
+
+        let changes = state_changes(&before, &after).expect("diff state");
+        assert_eq!(changes.len(), 3);
+        let find = |field: &str| {
+            changes
+                .iter()
+                .find(|change| change.path.get(2).is_some_and(|part| part == field))
+                .expect("field change")
+        };
+        assert_eq!(find("title").path, ["metadata_updates", thread_id, "title"]);
+        assert_eq!(find("title").conflict_policy, "compareAndSwap");
+        assert_eq!(find("updated_at").conflict_policy, "lastWriteWins");
+        assert_eq!(find("token_usage").conflict_policy, "lastWriteWins");
+        assert_eq!(
+            find("token_usage").path,
+            ["metadata_updates", thread_id, "token_usage", "total_tokens"]
+        );
+    }
+
+    #[test]
+    fn array_values_are_atomic_state_leaves() {
+        let before = serde_json::json!({"sections": {"thread": ["a", "b"]}});
+        let after = serde_json::json!({"sections": {"thread": ["a", "c"]}});
+
+        let changes = state_changes(&before, &after).expect("diff state");
+        assert_eq!(changes.len(), 1);
+        assert_eq!(changes[0].path, ["sections", "thread"]);
+        assert_eq!(
+            changes[0].expected.value,
+            Some(serde_json::json!(["a", "b"]))
+        );
+        assert_eq!(changes[0].value, Some(serde_json::json!(["a", "c"])));
+        assert_eq!(changes[0].conflict_policy, "compareAndSwap");
+    }
+
+    #[test]
+    fn platform_projection_keeps_foreign_cwds_canonical_but_not_executable() {
+        let unix_id = "018f0000-0000-7000-8000-000000000001";
+        let windows_id = "018f0000-0000-7000-8000-000000000002";
+        let mut state = serde_json::json!({
+            "created_threads": {
+                (unix_id): {"metadata": {"cwd": "/home/sine/project"}},
+                (windows_id): {"metadata": {"cwd": "C:\\Users\\Sine\\project"}}
+            },
+            "metadata_updates": {(unix_id): {"title": "unix"}, (windows_id): {"title": "windows"}},
+            "names": {(unix_id): "unix", (windows_id): "windows"},
+            "rollout_paths": {"/tmp/unix": unix_id, "C:\\tmp\\windows": windows_id}
+        })
+        .as_object()
+        .expect("state object")
+        .clone();
+
+        let removed = filter_incompatible_threads(&mut state, true);
+        assert_eq!(removed, HashSet::from([unix_id.to_string()]));
+        assert!(state["created_threads"].get(unix_id).is_none());
+        assert!(state["metadata_updates"].get(unix_id).is_none());
+        assert!(state["names"].get(unix_id).is_none());
+        assert_eq!(state["rollout_paths"].as_object().expect("paths").len(), 1);
+        assert!(state["created_threads"].get(windows_id).is_some());
+
+        assert!(cwd_is_compatible("C:\\Users\\Sine", true));
+        assert!(cwd_is_compatible("C:/Users/Sine", true));
+        assert!(!cwd_is_compatible("/home/sine", true));
+        assert!(cwd_is_compatible("/home/sine", false));
+        assert!(!cwd_is_compatible("C:\\Users\\Sine", false));
+    }
