+        .await?;
+    let root = client
+        .start_thread(ThreadStartParams::default())
+        .await?
+        .thread
+        .id;
+    let _: TurnStartResponse = client
+        .request(|request_id| ClientRequest::TurnStart {
+            request_id,
+            params: TurnStartParams {
