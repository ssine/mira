+    let item = json!({"type":"response_item", "payload":"x".repeat(9 * 1024 * 1024)});
+    let mut request = CommitRequest {
+        expected_version: 2,
+        state_changes: vec![],
+        history_changes: vec![HistoryChange {
+            thread_id: ThreadId::new().to_string(),
+            mode: "append",
+            expected_generation: 1,
+            expected_item_count: 1,
+            items: Some(vec![item.clone()]),
+            items_upload_id: None,
+        }],
+    };
+    store.stage_large_histories(&mut request).await.unwrap();
+    handle.await.unwrap();
+    let mut received = vec![];
+    while let Some(request) = requests.recv().await {
+        received.push(request);
+    }
+    assert_eq!(received.len(), 6);
+    assert_eq!(
+        received[1], received[2],
+        "a lost chunk response must replay identical bytes and offset"
+    );
+    let body = |index: usize| received[index].split_once("\r\n\r\n").unwrap().1;
+    for index in [1, 3, 4] {
+        assert!(body(index).len() <= 4 * 1024 * 1024);
+    }
+    let joined = format!("{}{}{}", body(1), body(3), body(4));
+    assert_eq!(
+        serde_json::from_str::<serde_json::Value>(&joined).unwrap(),
+        item
+    );
+    assert!(received[5].lines().next().unwrap().contains("/seal"));
+    assert!(request.history_changes[0].items.is_none());
+    assert!(request.history_changes[0].items_upload_id.is_some());
+    assert!(serde_json::to_vec(&request).unwrap().len() < 1024);
+}
