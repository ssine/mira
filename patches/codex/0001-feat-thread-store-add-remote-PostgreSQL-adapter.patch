+use std::sync::Arc;
+use std::time::Duration;
+
+use pretty_assertions::assert_eq;
+use serde_json::json;
+use tokio::io::AsyncReadExt;
+use tokio::io::AsyncWriteExt;
+
+use super::request_json;
+use crate::AppendThreadItemsParams;
+use crate::CreateThreadParams;
+use crate::RemoteHttpThreadStore;
+use crate::ThreadStore;
+use crate::ThreadStoreError;
+use codex_protocol::ThreadId;
+use codex_protocol::protocol::AgentMessageContentDeltaEvent;
+use codex_protocol::protocol::EventMsg;
+use codex_rollout::RolloutItem;
+
+#[tokio::test]
+async fn streamed_text_bypasses_remote_reads_and_pending_storage() {
+    let (url, mut requests, handle) = server(vec![Some((403, String::new()))]).await;
+    let store = RemoteHttpThreadStore::new(url, "test", "test-token");
+    let thread = ThreadId::new();
+    let append = || AppendThreadItemsParams {
+        thread_id: thread,
+        items: vec![RolloutItem::EventMsg(EventMsg::AgentMessageContentDelta(
+            AgentMessageContentDeltaEvent {
+                thread_id: thread.to_string(),
+                turn_id: "stream-turn".to_string(),
+                item_id: "stream-item".to_string(),
+                delta: "字".to_string(),
+            },
+        ))],
+    };
+    let permit = store.operation_gate.acquire().await.unwrap();
+    tokio::time::timeout(Duration::from_secs(1), async {
+        for _ in 0..2_000 {
+            store.append_items(append()).await.unwrap();
+        }
+    })
+    .await
+    .expect("transient output must not wait for the storage gate or HTTP");
+    assert!(requests.try_recv().is_err());
+    drop(permit);
+    // Durable work still reaches the server, and its failure also stops the
+    // transient fast path instead of falsely reporting a healthy runtime.
+    assert!(store.create_thread(create(thread, None)).await.is_err());
+    assert!(store.append_items(append()).await.is_err());
+    handle.await.unwrap();
+    assert!(requests.recv().await.unwrap().starts_with("GET "));
+    assert!(requests.recv().await.is_none());
+}
+
+// None means the server accepted a complete request but lost its response.
+async fn server(
+    replies: Vec<Option<(u16, String)>>,
+) -> (
+    String,
+    tokio::sync::mpsc::UnboundedReceiver<String>,
+    tokio::task::JoinHandle<()>,
+) {
+    let listener = tokio::net::TcpListener::bind("127.0.0.1:0").await.unwrap();
+    let url = format!("http://{}", listener.local_addr().unwrap());
+    let (tx, rx) = tokio::sync::mpsc::unbounded_channel();
+    let handle = tokio::spawn(async move {
+        for reply in replies {
+            let (mut stream, _) = listener.accept().await.unwrap();
+            let mut bytes = Vec::new();
+            loop {
+                let mut buffer = [0; 4096];
+                let count = stream.read(&mut buffer).await.unwrap();
+                assert!(count > 0);
+                bytes.extend_from_slice(&buffer[..count]);
+                if let Some(end) = bytes.windows(4).position(|chunk| chunk == b"\r\n\r\n") {
+                    let header = String::from_utf8_lossy(&bytes[..end]).to_lowercase();
+                    let length = header
+                        .lines()
+                        .find_map(|line| line.strip_prefix("content-length: "))
+                        .map(|length| length.parse::<usize>().unwrap())
+                        .unwrap_or(0);
+                    if bytes.len() >= end + 4 + length {
+                        break;
+                    }
+                }
+            }
+            tx.send(String::from_utf8(bytes).unwrap()).unwrap();
+            if let Some((status, body)) = reply {
+                let response = format!(
+                    "HTTP/1.1 {status} Test\r\nContent-Type: application/json\r\nContent-Length: {}\r\nConnection: close\r\n\r\n{body}",
+                    body.len()
+                );
+                stream.write_all(response.as_bytes()).await.unwrap();
+            }
+        }
+    });
+    (url, rx, handle)
+}
+
+fn create(thread_id: ThreadId, parent_thread_id: Option<ThreadId>) -> CreateThreadParams {
+    use codex_protocol::models::BaseInstructions;
+    use codex_protocol::protocol::SessionSource;
+    use codex_protocol::protocol::ThreadHistoryMode;
+    use codex_protocol::protocol::ThreadMemoryMode;
+    CreateThreadParams {
+        session_id: parent_thread_id.unwrap_or(thread_id).into(),
+        thread_id,
+        parent_thread_id,
+        extra_config: None,
+        forked_from_id: None,
+        source: SessionSource::Exec,
+        thread_source: None,
+        originator: "retry-test".to_string(),
+        base_instructions: BaseInstructions::default(),
+        dynamic_tools: Vec::new(),
+        selected_capability_roots: Vec::new(),
+        multi_agent_version: None,
+        history_mode: ThreadHistoryMode::Legacy,
+        history_base: None,
+        subagent_history_start_ordinal: None,
+        initial_window_id: ThreadId::new().to_string(),
+        metadata: crate::ThreadPersistenceMetadata {
+            cwd: None,
+            model_provider: "test".to_string(),
+            memory_mode: ThreadMemoryMode::Disabled,
+        },
+    }
+}
+
+#[tokio::test]
+async fn retries_transient_failures_with_identical_id_and_body() {
+    let (url, mut requests, handle) = server(vec![
+        Some((502, String::new())),
+        None,
+        Some((429, String::new())),
+        Some((200, json!({"version": 1}).to_string())),
