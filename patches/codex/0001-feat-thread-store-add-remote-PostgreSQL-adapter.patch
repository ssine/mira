+#[tokio::test]
+async fn managed_provider_projection_keeps_canonical_metadata_unchanged() {
+    let memory = crate::InMemoryThreadStore::default();
+    let id = ThreadId::new();
+    memory
+        .create_thread(create(id, Some(ThreadId::new())))
+        .await
+        .unwrap();
+    let mut snapshot = memory
+        .snapshot_for_threads(&[id].into_iter().collect())
+        .await
+        .unwrap();
+    snapshot["metadata_updates"][id.to_string()] = json!({
+        "model":"original-child-model",
+        "created_at":"2026-01-01T00:00:00Z",
+        "updated_at":"2026-01-01T00:00:00Z",
+        "advance_recency_at":"2026-01-01T00:00:00Z"
+    });
+    let memory = crate::InMemoryThreadStore::from_snapshot(Some(snapshot.clone())).unwrap();
+    let (state, _) = crate::remote_http::split_snapshot(snapshot).unwrap();
+    let head = json!({"version":1,"state":state,"historyManifest":{}}).to_string();
+    let (url, mut requests, handle) = server(vec![Some((200, head))]).await;
+    let mut remote = RemoteHttpThreadStore::new(url, "test", "test-token");
+    remote
+        .account_headers
+        .insert("x-mira-codex-account", "account-b".parse().unwrap());
+    remote
+        .account_headers
+        .insert("x-mira-codex-runtime", "runtime-b".parse().unwrap());
+    let remote = remote.with_execution_provider("provider-b".to_string());
+    let params = crate::ReadThreadParams {
+        thread_id: id,
+        include_archived: true,
+        include_history: false,
+    };
+    let original = memory.read_thread(params.clone()).await.unwrap();
+    let projected = remote.read_thread(params.clone()).await.unwrap();
+    assert_eq!(projected.model_provider, "provider-b");
+    let mut expected = serde_json::to_value(original).unwrap();
+    expected["model_provider"] = json!("provider-b");
+    assert_eq!(serde_json::to_value(projected).unwrap(), expected);
+    let cached = remote.take_cache().unwrap();
+    assert_eq!(cached.canonical_state, state);
+    assert_eq!(
+        cached
+            .store
+            .read_thread(params)
+            .await
+            .unwrap()
+            .model_provider,
+        "test"
+    );
+    handle.await.unwrap();
+    let request = requests.recv().await.unwrap().to_lowercase();
+    assert!(request.contains("x-mira-accounts-version: 2"));
+    assert!(
+        requests.recv().await.is_none(),
+        "a provider projection must never write history"
+    );
+}
