+use std::time::Duration;
+
+use super::RemoteHttpThreadStore;
+use super::request_json;
+use crate::ThreadStoreResult;
+
+impl RemoteHttpThreadStore {
+    /// Storage transport for the separate upstream AgentGraphStore boundary.
+    /// Mutations must use `write_agent_graph` to retain cancellation and failure fencing.
+    pub async fn read_agent_graph(
+        &self,
+        body: serde_json::Value,
+    ) -> ThreadStoreResult<serde_json::Value> {
+        self.request_agent_graph(body).await
+    }
+
+    pub(super) async fn request_agent_graph(
+        &self,
+        body: serde_json::Value,
+    ) -> ThreadStoreResult<serde_json::Value> {
+        request_json(
+            self.client
+                .post(format!("{}/agent-graph", self.store_url))
+                .headers(self.account_headers.clone())
+                .bearer_auth(&self.bearer_token)
+                .header(
+                    "X-Codex-Operation-Id",
+                    codex_protocol::ThreadId::new().to_string(),
+                )
+                .timeout(Duration::from_secs(10))
+                .json(&body),
+        )
+        .await
+    }
+}
diff --git a/codex-rs/thread-store/src/remote_http/cache.rs b/codex-rs/thread-store/src/remote_http/cache.rs
new file mode 100644
index 000000000..53704b89b
--- /dev/null
+++ b/codex-rs/thread-store/src/remote_http/cache.rs
@@ -0,0 +1,82 @@
+use std::collections::VecDeque;
+use std::io::Write;
+
+use codex_protocol::ThreadId;
+use serde::Serialize;
+
+use super::CachedStore;
+
+const MAX_CACHED_SCOPES: usize = 8;
+// Serialized payload budget, not a limit on canonical history or downloads.
+const MAX_CACHED_BYTES: usize = 2 * 1024 * 1024 * 1024;
+
+#[derive(Default)]
+pub(super) struct StoreCaches {
+    entries: VecDeque<(CachedStore, usize)>,
+    bytes: usize,
+}
+
+impl StoreCaches {
+    pub(super) fn invalidate_thread(&mut self, thread_id: ThreadId) {
+        self.entries.retain(|(cache, size)| {
+            if cache.scope == Some(thread_id) || cache.loaded_histories.contains(&thread_id) {
+                self.bytes -= size;
+                false
+            } else {
+                true
+            }
+        });
+    }
+
+    pub(super) fn take(&mut self, scope: Option<ThreadId>) -> Option<CachedStore> {
+        let index = self
+            .entries
+            .iter()
+            .position(|(cache, _)| cache.scope == scope)?;
+        let (cache, size) = self.entries.remove(index)?;
+        self.bytes -= size;
+        Some(cache)
+    }
+
+    pub(super) fn put(&mut self, cache: CachedStore) {
+        self.take(cache.scope);
+        let size = cache
+            .history_bytes
+            .values()
+            .fold(serialized_size(&cache.canonical_state), |total, bytes| {
+                total.saturating_add(*bytes)
+            });
+        if size > MAX_CACHED_BYTES {
+            return;
+        }
+        while self.entries.len() >= MAX_CACHED_SCOPES
+            || self.bytes.saturating_add(size) > MAX_CACHED_BYTES
+        {
+            let Some((_, bytes)) = self.entries.pop_front() else {
+                break;
+            };
+            self.bytes -= bytes;
+        }
+        self.bytes += size;
+        self.entries.push_back((cache, size));
+    }
+}
+
+// Count without allocating another serialized copy of a potentially large history.
+pub(super) fn serialized_size(value: &impl Serialize) -> usize {
+    struct Counter(usize);
+    impl Write for Counter {
+        fn write(&mut self, bytes: &[u8]) -> std::io::Result<usize> {
+            self.0 = self.0.saturating_add(bytes.len());
+            Ok(bytes.len())
+        }
+        fn flush(&mut self) -> std::io::Result<()> {
+            Ok(())
+        }
+    }
+    let mut counter = Counter(0);
+    match serde_json::to_writer(&mut counter, value) {
+        Ok(()) => counter.0,
+        Err(_) => usize::MAX,
+    }
+}
