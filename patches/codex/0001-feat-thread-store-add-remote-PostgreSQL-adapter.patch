+        server
+            .next("GET ")
+            .await
+            .reply
+            .send(current.clone())
+            .unwrap();
+        server.next(&format!("GET /v2/stores/test/threads/{id}/history?generation={generation}&")).await.reply
+            .send(json!({"generation":generation,"itemCount":1,"items":[message(&generation.to_string())]})).unwrap();
+        assert_eq!(
+            serde_json::to_value(reader.await.unwrap().unwrap().items).unwrap(),
+            json!([message(&generation.to_string())])
