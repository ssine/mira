+        })
+        .await
+        .unwrap();
+    let projection = cached
+        .store
+        .snapshot_for_threads(&HashSet::new())
+        .await
+        .unwrap();
+    assert_eq!(cached.canonical_state, canonical);
+    assert!(cached.history_manifest.is_empty());
+    assert_eq!(
+        projection["created_threads"],
+        json!({(native_id.to_string()): native})
+    );
+    assert_eq!(projection["metadata_updates"], json!({}));
