+    Mock::given(method("POST"))
+        .and(path("/v1/responses"))
+        .respond_with(
+            ResponseTemplate::new(429)
+                .insert_header("Retry-After", "1")
+                .set_body_json(json!({"error":{"code":"insufficient_quota"}})),
+        )
+        .expect(1)
+        .mount(&server)
+        .await;
+    let test = test_codex().build_with_auto_env(&server).await?;
+    test.codex
+        .start_or_steer_turn(TurnInputRequest::user_input(vec![UserInput::Text {
+            text: "check quota handling".into(),
+            text_elements: vec![],
+        }]))
+        .await?;
+    let EventMsg::TurnComplete(event) =
+        wait_for_event(&test.codex, |e| matches!(e, EventMsg::TurnComplete(_))).await
+    else {
+        unreachable!()
+    };
+    assert_eq!(
+        event.error.and_then(|error| error.codex_error_info),
+        Some(CodexErrorInfo::UsageLimitExceeded)
+    );
+    Ok(())
+}
