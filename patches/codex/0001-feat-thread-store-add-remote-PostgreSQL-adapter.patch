+            .request(|request_id| ClientRequest::ThreadUnsubscribe {
+                request_id,
+                params: ThreadUnsubscribeParams {
+                    thread_id: id.clone(),
+                },
+            })
+            .await?;
+    }
+    tokio::time::sleep(Duration::from_millis(50)).await;
+    let candidate = residency(&mut client, None)
+        .await?
+        .oldest
+        .expect("unrelated idle root");
+    assert_eq!(candidate.thread_id, unrelated);
+    assert!(
+        residency(&mut client, Some(candidate))
+            .await?
+            .eviction_scheduled
+    );
+    assert_eq!(residency(&mut client, None).await?.oldest, None);
+    Ok(())
+}
