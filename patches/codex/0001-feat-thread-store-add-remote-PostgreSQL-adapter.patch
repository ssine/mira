+++ b/codex-rs/core/tests/suite/plaintext_compaction.rs
@@ -0,0 +1,92 @@
+use anyhow::Result;
+use codex_core::compact::SUMMARY_PREFIX;
+use codex_features::Feature;
+use codex_protocol::protocol::EventMsg;
+use codex_protocol::protocol::Op;
+use core_test_support::responses::*;
+use core_test_support::test_codex::test_codex;
+use core_test_support::wait_for_event;
+use pretty_assertions::assert_eq;
+use test_case::test_case;
+
+#[test_case("OpenAI"; "builtin_openai")]
+#[test_case("Azure"; "azure")]
+#[test_case("Custom API"; "custom")]
+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+async fn plaintext_compaction_overrides_provider_and_token_budget(provider: &str) -> Result<()> {
+    let server = start_mock_server().await;
+    let mut builder = test_codex().with_config({
+        let provider = provider.to_string();
+        move |config| {
+            config
+                .features
+                .enable(Feature::MiraPlaintextContext)
+                .expect("plaintext");
+            config
+                .features
+                .enable(Feature::TokenBudget)
+                .expect("budget");
+            config.model_provider.name = provider;
+        }
+    });
+    let test = builder.build_with_auto_env(&server).await?;
+    let first = mount_sse_once(
+        &server,
+        sse(vec![
+            ev_assistant_message("initial", "remember this work"),
+            ev_completed("initial"),
+        ]),
+    )
+    .await;
+    test.submit_turn("Keep the task state across compaction")
+        .await?;
+    first.single_request();
+    let compact = mount_sse_once(
+        &server,
+        sse(vec![
+            ev_assistant_message("summary", "portable task summary"),
+            ev_completed("summary"),
+        ]),
+    )
+    .await;
+    test.codex.submit(Op::Compact).await?;
+    wait_for_event(&test.codex, |event| {
+        matches!(event, EventMsg::TurnComplete(_))
+    })
+    .await;
+    let request = compact.single_request();
+    assert_eq!(request.body_json()["tools"], serde_json::json!([]));
+    assert!(
+        !request
+            .input()
+            .iter()
+            .any(|item| item["type"] == "compaction_trigger")
+    );
+
+    let followup = mount_sse_once(
+        &server,
+        sse(vec![
+            ev_assistant_message("after", "continued"),
+            ev_completed("after"),
+        ]),
+    )
+    .await;
+    test.submit_turn("Continue from the summary").await?;
+    let request = followup.single_request();
+    let summaries: Vec<_> = request
+        .message_input_texts("user")
+        .into_iter()
+        .filter(|text| text.starts_with(SUMMARY_PREFIX))
+        .collect();
+    assert_eq!(
+        summaries,
+        vec![format!("{SUMMARY_PREFIX}\nportable task summary")]
+    );
+    assert!(
+        !request
+            .input()
+            .iter()
+            .any(|item| item["type"] == "compaction")
+    );
+    Ok(())
+}
diff --git a/codex-rs/core/tests/suite/rate_limit_retry.rs b/codex-rs/core/tests/suite/rate_limit_retry.rs
new file mode 100644
index 0000000..3442dcc
--- /dev/null
+++ b/codex-rs/core/tests/suite/rate_limit_retry.rs
@@ -0,0 +1,257 @@
+use anyhow::Result;
+use codex_core::StartThreadOptions;
+use codex_protocol::dynamic_tools::DynamicToolCallOutputContentItem;
+use codex_protocol::dynamic_tools::DynamicToolFunctionSpec;
+use codex_protocol::dynamic_tools::DynamicToolNamespaceSpec;
+use codex_protocol::dynamic_tools::DynamicToolNamespaceTool;
+use codex_protocol::dynamic_tools::DynamicToolResponse;
+use codex_protocol::dynamic_tools::DynamicToolSpec;
+use codex_protocol::protocol::CodexErrorInfo;
+use codex_protocol::protocol::EventMsg;
+use codex_protocol::protocol::Op;
+use codex_protocol::protocol::SessionSource;
+use codex_protocol::protocol::SubAgentSource;
+use codex_protocol::turn_input::TurnInputRequest;
+use codex_protocol::user_input::UserInput;
+use core_test_support::responses;
+use core_test_support::skip_if_no_network;
+use core_test_support::test_codex::test_codex;
+use core_test_support::wait_for_event;
+use pretty_assertions::assert_eq;
+use serde_json::json;
+use std::time::Duration;
+use std::time::Instant;
+use wiremock::Mock;
+use wiremock::ResponseTemplate;
+use wiremock::matchers::method;
+use wiremock::matchers::path;
+
+#[derive(Clone, Copy)]
+enum RateLimitWire {
+    Http,
+    HttpTpmTimeout,
+    NestedEvent,
+    FlatEvent,
+    FailedResponse,
+}
+
+fn limited_response(wire: RateLimitWire, retry_after: &str) -> ResponseTemplate {
+    let error = json!({"code":"rate_limit_exceeded", "message":format!("Please try again in {retry_after}s.")});
+    let event = match wire {
+        RateLimitWire::Http => {
+            return ResponseTemplate::new(429)
+                .insert_header("Retry-After", retry_after)
+                .set_body_json(json!({"error":error}));
+        }
+        RateLimitWire::HttpTpmTimeout => {
+            return ResponseTemplate::new(401)
+                .insert_header("Retry-After", retry_after)
+                .set_body_string("ratelimiter: tpm acquire project: tpm peek tpm:project:test-model:42: context deadline exceeded");
+        }
+        RateLimitWire::NestedEvent => json!({"type":"error", "error":error}),
+        RateLimitWire::FlatEvent => {
+            json!({"type":"error", "code":error["code"],"message":error["message"]})
+        }
+        RateLimitWire::FailedResponse => {
+            json!({"type":"response.failed", "response":{"error":error}})
+        }
+    };
+    responses::sse_response(responses::sse(vec![
+        responses::ev_response_created("limited"),
+        event,
+    ]))
+}
+
+#[test_case::test_case(SessionSource::Mcp, RateLimitWire::Http; "root_http")]
+#[test_case::test_case(SessionSource::Mcp, RateLimitWire::HttpTpmTimeout; "root_tpm_401")]
+#[test_case::test_case(SessionSource::Mcp, RateLimitWire::NestedEvent; "root_nested")]
+#[test_case::test_case(SessionSource::Mcp, RateLimitWire::FlatEvent; "root_flat")]
+#[test_case::test_case(SessionSource::Mcp, RateLimitWire::FailedResponse; "root_failed")]
+#[test_case::test_case(SessionSource::SubAgent(SubAgentSource::Other("rate-limit-test".into())), RateLimitWire::Http; "subagent_http")]
+#[test_case::test_case(SessionSource::SubAgent(SubAgentSource::Other("rate-limit-test".into())), RateLimitWire::HttpTpmTimeout; "subagent_tpm_401")]
+#[test_case::test_case(SessionSource::SubAgent(SubAgentSource::Other("rate-limit-test".into())), RateLimitWire::NestedEvent; "subagent_nested")]
+#[test_case::test_case(SessionSource::SubAgent(SubAgentSource::Other("rate-limit-test".into())), RateLimitWire::FlatEvent; "subagent_flat")]
+#[test_case::test_case(SessionSource::SubAgent(SubAgentSource::Other("rate-limit-test".into())), RateLimitWire::FailedResponse; "subagent_failed")]
+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+async fn rate_limit_preserves_completed_tool_and_outlives_retry_budget(
+    source: SessionSource,
+    wire: RateLimitWire,
+) -> Result<()> {
+    skip_if_no_network!(Ok(()));
+    let server = responses::start_mock_server().await;
+    let mock = responses::mount_response_sequence(
+        &server,
+        vec![
+            responses::sse_response(responses::sse(vec![
+                responses::ev_response_created("tool"),
+                responses::ev_function_call_with_namespace("write-once", "fixture", "write", "{}"),
+                responses::ev_completed("tool"),
+            ])),
+            limited_response(wire, "0"),
+            limited_response(wire, "7"),
+            responses::sse_response(responses::sse(vec![
+                responses::ev_response_created("recovered"),
+                responses::ev_assistant_message("answer", "done"),
+                responses::ev_completed("recovered"),
+            ])),
+        ],
+    )
+    .await;
+    let base = test_codex()
+        .with_config(|config| {
+            config.model_provider.request_max_retries = Some(0);
+            config.model_provider.stream_max_retries = Some(0);
+        })
+        .build_with_auto_env(&server)
+        .await?;
+    let created = base
+        .thread_manager
+        .start_thread(StartThreadOptions {
+            session_source: Some(source),
+            dynamic_tools: vec![DynamicToolSpec::Namespace(DynamicToolNamespaceSpec {
+                name: "fixture".into(),
+                description: "Test tools".into(),
+                tools: vec![DynamicToolNamespaceTool::Function(
+                    DynamicToolFunctionSpec {
+                        name: "write".into(),
+                        description: "Perform one write".into(),
+                        input_schema: json!({"type":"object","properties":{}}),
+                        defer_loading: false,
+                    },
+                )],
+            })],
+            ..StartThreadOptions::new(base.config.clone())
+        })
+        .await?;
+    let codex = created.thread;
+    codex
+        .start_or_steer_turn(TurnInputRequest::user_input(vec![UserInput::Text {
+            text: "write once then finish".into(),
+            text_elements: vec![],
+        }]))
+        .await?;
+    let mut calls = 0;
+    let mut waits = Vec::new();
+    tokio::time::timeout(Duration::from_secs(35), async {
+        loop {
+            match wait_for_event(&codex, |_| true).await {
+                EventMsg::DynamicToolCallRequest(request) => {
+                    calls += 1;
+                    codex
+                        .submit(Op::DynamicToolResponse {
+                            id: request.call_id,
+                            response: DynamicToolResponse {
+                                success: true,
+                                content_items: vec![DynamicToolCallOutputContentItem::InputText {
+                                    text: "WRITE_COMMITTED".into(),
+                                }],
+                            },
+                        })
+                        .await
+                        .expect("submit completed tool result");
+                }
+                EventMsg::StreamError(error) => {
+                    assert_eq!(
+                        error.codex_error_info,
+                        Some(CodexErrorInfo::ResponseStreamDisconnected {
+                            http_status_code: match wire {
+                                RateLimitWire::Http => Some(429),
+                                RateLimitWire::HttpTpmTimeout
+                                | RateLimitWire::NestedEvent
+                                | RateLimitWire::FlatEvent
+                                | RateLimitWire::FailedResponse => None,
+                            },
+                        })
+                    );
+                    assert!(error.message.starts_with("Rate limited; retrying in "));
+                    waits.push(Instant::now());
+                }
+                EventMsg::Error(error) => panic!("unexpected terminal error: {error:?}"),
+                EventMsg::TurnComplete(event) => {
+                    assert_eq!(event.error, None);
+                    break;
+                }
+                _ => {}
+            }
+        }
+    })
+    .await?;
+    assert_eq!((calls, waits.len(), mock.requests().len()), (1, 2, 4));
+    assert!(waits[1].duration_since(waits[0]) >= Duration::from_secs(5));
+    assert!(waits[1].elapsed() >= Duration::from_secs(7));
+    let requests = mock.requests();
+    let output = requests[1].function_call_output("write-once");
+    assert_eq!(requests[2].function_call_output("write-once"), output);
+    assert_eq!(requests[3].function_call_output("write-once"), output);
+    assert!(output.to_string().contains("WRITE_COMMITTED"));
+    Ok(())
+}
+
+#[test_case::test_case(RateLimitWire::Http; "http")]
+#[test_case::test_case(RateLimitWire::HttpTpmTimeout; "tpm_401")]
+#[test_case::test_case(RateLimitWire::NestedEvent; "nested_sse")]
+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+async fn rate_limit_long_wait_is_cancellable(wire: RateLimitWire) -> Result<()> {
+    skip_if_no_network!(Ok(()));
+    let server = responses::start_mock_server().await;
+    Mock::given(method("POST"))
+        .and(path("/v1/responses"))
+        .respond_with(limited_response(wire, "3600"))
+        .expect(1)
+        .mount(&server)
+        .await;
+    let test = test_codex().build_with_auto_env(&server).await?;
+    test.codex
+        .start_or_steer_turn(TurnInputRequest::user_input(vec![UserInput::Text {
+            text: "wait for capacity".into(),
+            text_elements: vec![],
+        }]))
+        .await?;
+    let EventMsg::StreamError(error) =
+        wait_for_event(&test.codex, |e| matches!(e, EventMsg::StreamError(_))).await
+    else {
+        unreachable!()
+    };
+    let message = regex_lite::Regex::new(r"in \d+s")?.replace_all(&error.message, "in <delay>s");
+    insta::assert_snapshot!("http_429_wait", message);
+    test.codex.submit(Op::Interrupt).await?;
+    tokio::time::timeout(
+        Duration::from_secs(3),
+        wait_for_event(&test.codex, |e| matches!(e, EventMsg::TurnAborted(_))),
+    )
+    .await?;
+    Ok(())
+}
+
+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+async fn http_429_quota_failure_finishes_without_retry() -> Result<()> {
+    skip_if_no_network!(Ok(()));
+    let server = responses::start_mock_server().await;
+    Mock::given(method("POST"))
+        .and(path("/v1/responses"))
+        .respond_with(
+            ResponseTemplate::new(429)
+                .insert_header("Retry-After", "1")
+                .set_body_json(json!({"error":{"code":"insufficient_quota"}})),
+        )
+        .expect(1)
+        .mount(&server)
+        .await;
+    let test = test_codex().build_with_auto_env(&server).await?;
+    test.codex
+        .start_or_steer_turn(TurnInputRequest::user_input(vec![UserInput::Text {
+            text: "check quota handling".into(),
+            text_elements: vec![],
+        }]))
+        .await?;
+    let EventMsg::TurnComplete(event) =
+        wait_for_event(&test.codex, |e| matches!(e, EventMsg::TurnComplete(_))).await
+    else {
+        unreachable!()
+    };
+    assert_eq!(
+        event.error.and_then(|error| error.codex_error_info),
+        Some(CodexErrorInfo::UsageLimitExceeded)
+    );
+    Ok(())
+}
