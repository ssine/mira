@@ -0,0 +1,29 @@
+//! One compaction policy for manual, pre-turn, mid-turn and model-downshift requests.
+//! Keep provider capabilities separate: Mira prefers portable summaries even when
+//! a provider supports encrypted checkpoints or token-budget context resets.
+
+use crate::session::turn_context::TurnContext;
+use codex_features::Feature;
+use codex_model_provider::RemoteCompactionSupport;
+
+#[derive(Clone, Copy, PartialEq, Eq)]
+pub(crate) enum CompactionMode {
+    Plaintext,
+    RemoteV2,
+    TokenBudget,
+}
+
+impl CompactionMode {
+    pub(crate) fn for_turn(turn: &TurnContext) -> Self {
+        if turn.config.features.enabled(Feature::MiraPlaintextContext) {
+            Self::Plaintext
+        } else if turn.config.features.enabled(Feature::TokenBudget) {
+            Self::TokenBudget
+        } else {
+            match turn.provider.capabilities().remote_compaction {
+                RemoteCompactionSupport::V2 => Self::RemoteV2,
+                RemoteCompactionSupport::Unsupported => Self::Plaintext,
+            }
+        }
+    }
+}
