+#[tokio::test]
+async fn missing_thread_append_fences_only_that_thread() {
+    let missing = ThreadId::new();
+    let existing = ThreadId::new();
+    let new_root = ThreadId::new();
+    let child = ThreadId::new();
+    let empty_head = |version| {
+        Some((
+            200,
+            json!({"version": version, "state": {}, "historyManifest": {}}).to_string(),
+        ))
+    };
+    let existing_head = Some((
+        200,
+        json!({"version": 40, "state": {
+        "created_threads": {existing.to_string(): create(existing, /*parent_thread_id*/ None)}
+    }, "historyManifest": {existing.to_string(): {"generation": 3, "itemCount": 8}}})
+        .to_string(),
+    ));
+    let commit = |version| {
+        Some((
+            200,
+            json!({"version": version, "historyManifest": {}}).to_string(),
+        ))
+    };
+    // A successful scoped head read omits a deleted thread. This produces a
+    // typed ThreadNotFound locally, unlike the HTTP 404 rejection tests above.
+    let (url, mut requests, handle) = server(vec![
+        empty_head(40),
+        existing_head.clone(),
+        existing_head,
+        commit(41),
+        empty_head(41),
+        commit(42),
+        empty_head(42),
+        commit(43),
+    ])
+    .await;
+    let store = RemoteHttpThreadStore::new(url, "test", "test-token");
+    let item: RolloutItem = serde_json::from_value(json!({
+        "type": "response_item", "payload": {"type": "message", "role": "assistant",
+            "content": [{"type": "output_text", "text": "durable result"}]}
+    }))
+    .unwrap();
+    let append = |thread_id| AppendThreadItemsParams {
+        thread_id,
+        items: vec![item.clone()],
+    };
+    let error = store.append_items(append(missing)).await.unwrap_err();
+    assert!(
+        matches!(error, ThreadStoreError::ThreadNotFound { thread_id } if thread_id == missing)
+    );
+    assert!(
+        store
+            .flush_thread(missing)
+            .await
+            .unwrap_err()
+            .to_string()
+            .contains("paused")
+    );
+    assert!(store.append_items(append(missing)).await.is_err());
+    assert!(store.shutdown_thread(missing).await.is_err());
+    // Failed writes stay fenced even when their items take the transient path.
+    assert!(
+        store
+            .append_items(AppendThreadItemsParams {
+                thread_id: missing,
+                items: Vec::new(),
+            })
+            .await
+            .is_err()
+    );
+
+    store
+        .read_thread(crate::ReadThreadParams {
+            thread_id: existing,
+            include_archived: true,
+            include_history: false,
+        })
+        .await
+        .unwrap();
+    store.append_items(append(existing)).await.unwrap();
+    store
+        .create_thread(create(new_root, /*parent_thread_id*/ None))
+        .await
+        .unwrap();
+    store
+        .create_thread(create(child, Some(new_root)))
+        .await
+        .unwrap();
+    for thread in [existing, new_root, child] {
+        store.flush_thread(thread).await.unwrap();
+        store.shutdown_thread(thread).await.unwrap();
+    }
+    assert!(store.flush_thread(missing).await.is_err());
+    handle.await.unwrap();
+    let first = requests.recv().await.unwrap();
+    assert!(first.starts_with(&format!("GET /v2/stores/test?threadId={missing} ")));
+    let mut commits = Vec::new();
+    while let Some(request) = requests.recv().await {
+        assert!(
+            !request.contains(&missing.to_string()),
+            "deleted thread must never be retried or recreated"
+        );
+        if request.starts_with("POST ") {
+            commits.push(request);
+        }
+    }
+    assert_eq!(commits.len(), 3);
+    assert!(commits[0].contains(&existing.to_string()));
+    assert!(commits[1].contains(&new_root.to_string()));
+    assert!(commits[2].contains(&format!("\"parent_thread_id\":\"{new_root}\"")));
+}
