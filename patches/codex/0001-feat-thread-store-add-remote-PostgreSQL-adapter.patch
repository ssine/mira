+#[tokio::test]
+async fn foreign_workspace_roots_leave_other_threads_and_canonical_state_intact() {
+    let directory = tempfile::tempdir().unwrap();
+    let native_id = ThreadId::new();
+    let foreign_id = ThreadId::new();
+    let mut native = create(native_id, None);
+    native.metadata.cwd = Some(directory.path().to_path_buf());
+    native.runtime_workspace_roots = Some(vec![directory.path().abs()]);
+    let mut foreign = serde_json::to_value(create(foreign_id, None)).unwrap();
+    foreign["metadata"]["cwd"] = json!(directory.path());
+    foreign["runtime_workspace_roots"] = json!([if cfg!(windows) {
+        "/srv/foreign"
+    } else {
+        "C:\\foreign"
+    }]);
+    let canonical = json!({
+        "created_threads": {(native_id.to_string()): native, (foreign_id.to_string()): foreign},
+        "metadata_updates": {(foreign_id.to_string()): {"title": "foreign thread"}},
+        "future_metadata": {"preserve": true}
+    });
+    let store = RemoteHttpThreadStore::new("http://127.0.0.1:1", "test", "test-token");
+    let cached = store
+        .load(HeadResponse {
+            version: 1,
+            state: canonical.clone(),
+            history_manifest: HashMap::from([(
+                foreign_id.to_string(),
+                HistoryManifestEntry {
+                    generation: 1,
+                    item_count: 0,
+                },
+            )]),
+        })
+        .await
+        .unwrap();
+    let projection = cached
+        .store
+        .snapshot_for_threads(&HashSet::new())
+        .await
+        .unwrap();
+    assert_eq!(cached.canonical_state, canonical);
+    assert!(cached.history_manifest.is_empty());
+    assert_eq!(
+        projection["created_threads"],
+        json!({(native_id.to_string()): native})
+    );
+    assert_eq!(projection["metadata_updates"], json!({}));
+}
