diff --git a/codex-rs/core/tests/suite/mira_image_compaction.rs b/codex-rs/core/tests/suite/mira_image_compaction.rs
new file mode 100644
index 0000000000..47ebef4763
--- /dev/null
+++ b/codex-rs/core/tests/suite/mira_image_compaction.rs
@@ -0,0 +1,298 @@
+use anyhow::Result;
+use codex_core::StartThreadOptions;
+use codex_core::TurnInputRequest;
+use codex_protocol::dynamic_tools::DynamicToolCallOutputContentItem;
+use codex_protocol::dynamic_tools::DynamicToolFunctionSpec;
+use codex_protocol::dynamic_tools::DynamicToolNamespaceSpec;
+use codex_protocol::dynamic_tools::DynamicToolNamespaceTool;
+use codex_protocol::dynamic_tools::DynamicToolResponse;
+use codex_protocol::dynamic_tools::DynamicToolSpec;
+use codex_protocol::models::ImageReference;
+use codex_protocol::protocol::EventMsg;
+use codex_protocol::protocol::Op;
+use codex_protocol::user_input::UserInput;
+use core_test_support::responses::*;
+use core_test_support::test_codex::test_codex;
+use core_test_support::wait_for_event;
+use pretty_assertions::assert_eq;
+use serde_json::json;
+
+const IMAGE: &str = "data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAADUlEQVR4nGP4z8DwHwAFAAH/iZk9HQAAAABJRU5ErkJggg==";
+
+fn input(count: usize, text: &str) -> TurnInputRequest {
+    let mut images: Vec<_> = (0..count)
+        .map(|_| UserInput::Image {
+            image: ImageReference::Inline {
+                image_url: IMAGE.into(),
+            },
+            detail: None,
+        })
+        .collect();
+    images.push(UserInput::Text {
+        text: text.into(),
+        text_elements: vec![],
+    });
+    TurnInputRequest::user_input(images)
+}
+
+fn reply(id: &str, text: &str) -> String {
+    sse(vec![ev_assistant_message(id, text), ev_completed(id)])
+}
+
+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+async fn threshold_compacts_once_preserving_fresh_images_and_append_only_prefix() -> Result<()> {
+    let server = start_mock_server().await;
+    let requests = mount_sse_sequence(
+        &server,
+        vec![
+            reply("a", "old work"),
+            reply("summary", "summarized old screenshots"),
+            reply("b", "fresh screenshot read"),
+            reply("c", "continue"),
+            reply("d", "restored"),
+        ],
+    )
+    .await;
+    let test = test_codex()
+        .with_config(|config| config.mira_auto_compact_image_limit = Some(3))
+        .build_with_auto_env(&server)
+        .await?;
+    test.codex
+        .start_or_steer_turn(input(2, "OLD_INPUT"))
+        .await?;
+    wait_for_event(&test.codex, |event| {
+        matches!(event, EventMsg::TurnComplete(_))
+    })
+    .await;
+    let path = test.session_configured.rollout_path.as_ref().unwrap();
+    let original = std::fs::read(path)?;
+    test.codex
+        .start_or_steer_turn(input(1, "FRESH_INPUT"))
+        .await?;
+    wait_for_event(&test.codex, |event| {
+        matches!(event, EventMsg::TurnComplete(_))
+    })
+    .await;
+    test.submit_turn("Continue without more images").await?;
+    let recorded = requests.requests();
+    assert_eq!(recorded.len(), 4);
+    assert_eq!(recorded[1].body_json()["tools"], json!([]));
+    assert_eq!(recorded[1].message_input_image_urls("user").len(), 2);
+    assert!(
+        !recorded[1]
+            .message_input_texts("user")
+            .iter()
+            .any(|text| text.contains("FRESH_INPUT"))
+    );
+    assert_eq!(recorded[2].message_input_image_urls("user").len(), 1);
+    assert!(
+        recorded[2]
+            .message_input_texts("user")
+            .iter()
+            .any(|text| text.contains("FRESH_INPUT"))
+    );
+    let prefix = recorded[2].input();
+    assert_eq!(&recorded[3].input()[..prefix.len()], prefix.as_slice());
+    let saved = std::fs::read(path)?;
+    assert!(saved.starts_with(&original));
+    assert_eq!(
+        String::from_utf8(saved.clone())?
+            .lines()
+            .filter(
+                |line| serde_json::from_str::<serde_json::Value>(line).unwrap()["type"]
+                    == "compacted"
+            )
+            .count(),
+        1
+    );
+    let resumed = test_codex()
+        .with_config(|config| config.mira_auto_compact_image_limit = Some(3))
+        .restart(&server, &test)
+        .await?;
+    resumed.submit_turn("Continue after cold resume").await?;
+    assert_eq!(
+        requests.requests()[4]
+            .message_input_image_urls("user")
+            .len(),
+        1
+    );
+    assert!(std::fs::read(path)?.starts_with(&saved));
+    Ok(())
+}
+
+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+async fn new_tool_images_survive_compaction_without_reexecuting_tools() -> Result<()> {
+    let server = start_mock_server().await;
+    let requests = mount_sse_sequence(
+        &server,
+        vec![
+            sse(vec![
+                ev_response_created("a"),
+                ev_function_call_with_namespace("screen_once", "codex_app", "screen", "{}"),
+                ev_completed("a"),
+            ]),
+            reply("summary", "prior task summarized"),
+            reply("done", "tool screenshot read"),
+        ],
+    )
+    .await;
+    let base = test_codex()
+        .with_config(|config| config.mira_auto_compact_image_limit = Some(3))
+        .build_with_auto_env(&server)
+        .await?;
+    let tool = DynamicToolSpec::Namespace(DynamicToolNamespaceSpec {
+        name: "codex_app".into(),
+        description: "screen tools".into(),
+        tools: vec![DynamicToolNamespaceTool::Function(
+            DynamicToolFunctionSpec {
+                name: "screen".into(),
+                description: "returns screenshots".into(),
+                input_schema: json!({"type":"object","properties":{}}),
+                defer_loading: false,
+            },
+        )],
+    });
+    let new = base
+        .thread_manager
+        .start_thread(StartThreadOptions {
+            dynamic_tools: vec![tool],
+            ..StartThreadOptions::new(base.config.clone())
+        })
+        .await?;
+    new.thread
+        .start_or_steer_turn(input(2, "Inspect these and take one more screenshot"))
+        .await?;
+    let call = wait_for_event(&new.thread, |event| {
+        matches!(event, EventMsg::DynamicToolCallRequest(_))
+    })
+    .await;
+    let EventMsg::DynamicToolCallRequest(call) = call else {
+        panic!("tool")
+    };
+    new.thread
+        .submit(Op::DynamicToolResponse {
+            id: call.call_id,
+            response: DynamicToolResponse {
+                content_items: vec![DynamicToolCallOutputContentItem::InputImage {
+                    image_url: IMAGE.into(),
+                }],
+                success: true,
+            },
+        })
+        .await?;
+    wait_for_event(&new.thread, |event| {
+        matches!(event, EventMsg::TurnComplete(_))
+    })
+    .await;
+    let recorded = requests.requests();
+    assert_eq!(recorded.len(), 3);
+    assert_eq!(recorded[1].body_json()["tools"], json!([]));
+    assert_eq!(recorded[2].inputs_of_type("function_call").len(), 1);
+    let output = recorded[2].function_call_output("screen_once");
+    assert_eq!(output["output"][0]["type"], "input_image");
+    assert_eq!(recorded[2].message_input_image_urls("user").len(), 0);
+    let rollout = std::fs::read_to_string(new.session_configured.rollout_path.unwrap())?;
+    assert_eq!(
+        rollout
+            .lines()
+            .filter(|line| {
+                let line: serde_json::Value = serde_json::from_str(line).unwrap();
+                line["type"] == "response_item" && line["payload"]["type"] == "function_call"
+            })
+            .count(),
+        1
+    );
+    Ok(())
+}
+
+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+async fn fresh_batch_above_threshold_is_sampled_without_silent_image_loss() -> Result<()> {
