+    pub(crate) async fn snapshot_for_threads(
+        &self,
+        thread_ids: &HashSet<ThreadId>,
+    ) -> ThreadStoreResult<serde_json::Value> {
+        let state = self.state.lock().await;
+        let view = InMemoryThreadStoreStateView {
+            created_threads: &state.created_threads,
+            metadata_updates: &state.metadata_updates,
+            sections: &state.sections,
+            section_positions: &state.section_positions,
+            section_entered_at: &state.section_entered_at,
+            names: &state.names,
+            rollout_paths: &state.rollout_paths,
