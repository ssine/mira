+                developer_instructions: Some("Residency test instructions".into()),
+                ..Default::default()
+            },
+        })
+        .await?;
+    assert_eq!(resumed.thread.session_id, started.thread.session_id);
+    assert_eq!(
+        residency(&mut client, Some(candidate.clone())).await?,
+        MiraThreadResidencyResponse {
+            oldest: None,
