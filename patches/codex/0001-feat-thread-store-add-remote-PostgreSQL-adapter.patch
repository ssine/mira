 impl InMemoryThreadStore {
+    pub(crate) fn from_snapshot(snapshot: Option<serde_json::Value>) -> ThreadStoreResult<Self> {
+        let state = snapshot
+            .map(serde_json::from_value)
+            .transpose()
+            .map_err(|err| ThreadStoreError::Internal {
+                message: format!("failed to deserialize remote thread-store snapshot: {err}"),
+            })?
+            .unwrap_or_default();
+        Ok(Self {
+            state: tokio::sync::Mutex::new(state),
