@@ -0,0 +1,189 @@
+//! Opt-in recovery of precisely identified, rejected reasoning inputs.
+//!
+//! The provider's normal reasoning protocol and the canonical response items stay
+//! unchanged. Exclusions are durable thread settings, applied only to model input.
+
+use super::session::Session;
+use super::turn_context::TurnContext;
+use codex_history::InitialHistory;
+use codex_history::RolloutItem;
+use codex_protocol::ThreadId;
+use codex_protocol::error::CodexErr;
+use codex_protocol::error::CodexErrorDetails;
+use codex_protocol::error::Result;
+use codex_protocol::models::ResponseItem;
+use codex_protocol::protocol::EventMsg;
+use codex_protocol::protocol::MiraReasoningRecovery;
+use codex_protocol::protocol::ThreadSettingsAppliedEvent;
+use codex_protocol::protocol::WarningEvent;
+use std::collections::HashSet;
+
+pub(crate) const MAX_RECOVERIES_PER_REQUEST: usize = 8;
+const MAX_REJECTED_ITEMS: usize = 128;
+
+fn valid_item_id(id: &str) -> bool {
+    !id.is_empty()
+        && id.len() <= 256
+        && id
+            .bytes()
+            .all(|c| c.is_ascii_alphanumeric() || c == b'_' || c == b'-')
+}
+
+pub(super) fn restore(
+    history: &InitialHistory,
+    forked_from: Option<ThreadId>,
+    configured: Option<bool>,
+) -> Result<Option<MiraReasoningRecovery>> {
+    let owner = match history {
+        InitialHistory::Resumed(resumed) => Some(resumed.conversation_id),
+        InitialHistory::Forked(_) => forked_from,
+        InitialHistory::New | InitialHistory::Cleared => None,
+    };
+    let mut saved = owner.and_then(|owner| {
+        history.get_rollout_items().iter().rev().find_map(|item| {
+            if let RolloutItem::EventMsg(EventMsg::ThreadSettingsApplied(event)) = item
+                && event.thread_id.is_none_or(|id| id == owner)
+            {
+                event.thread_settings.mira_reasoning_recovery.clone()
+            } else {
+                None
+            }
+        })
+    });
+    if let Some(enabled) = configured {
+        saved.get_or_insert_default().enabled = enabled;
+    }
+    if let Some(saved) = &saved
+        && (saved.rejected_item_ids.len() > MAX_REJECTED_ITEMS
+            || saved.rejected_item_ids.iter().any(|id| !valid_item_id(id)))
+    {
+        return Err(CodexErr::InvalidRequest(
+            "Invalid saved reasoning recovery settings".to_string(),
+        ));
+    }
+    Ok(saved)
+}
+
+fn rejected_reasoning_id(error: &CodexErr, input: &[ResponseItem]) -> Option<String> {
+    let CodexErrorDetails::InvalidRequest(body) = error.details() else {
+        return None;
+    };
+    if body.len() > 32_768 {
+        return None;
+    }
+    let envelope: serde_json::Value = serde_json::from_str(body).ok()?;
+    let detail = envelope.get("error").unwrap_or(&envelope);
+    if detail.get("code")?.as_str()? != "invalid_encrypted_content" {
+        return None;
+    }
+    let message = detail.get("message")?.as_str()?;
+    let (id, _) = message
+        .strip_prefix("The encrypted content for item ")?
+        .split_once(" could not be verified.")?;
+    if !valid_item_id(id) {
+        return None;
+    }
+    let mut matching = input
+        .iter()
+        .filter(|item| item.id().is_some_and(|value| value.to_string() == id));
+    let item = matching.next()?;
+    if matching.next().is_some() {
+        return None;
+    }
+    matches!(item, ResponseItem::Reasoning { encrypted_content: Some(value), .. } if !value.is_empty())
+        .then(|| id.to_string())
+}
+
+impl Session {
+    pub(crate) async fn filter_rejected_reasoning(&self, input: &mut Vec<ResponseItem>) {
+        let state = self.state.lock().await;
+        let Some(recovery) = &state.session_configuration.mira_reasoning_recovery else {
+            return;
+        };
+        if recovery.rejected_item_ids.is_empty() {
+            return;
+        }
+        input.retain(|item| {
+            !matches!(item, ResponseItem::Reasoning { .. })
+                || !item
+                    .id()
+                    .is_some_and(|id| recovery.rejected_item_ids.contains(&id.to_string()))
+        });
+    }
+
+    pub(crate) async fn recover_rejected_reasoning(
+        &self,
+        error: &CodexErr,
+        input: &[ResponseItem],
+        turn: &TurnContext,
+    ) -> Result<bool> {
+        let Some(id) = rejected_reasoning_id(error, input) else {
+            return Ok(false);
+        };
+        let _settings_guard = super::thread_settings::acquire_persistence_lock(self).await;
+        let recovery = {
+            let state = self.state.lock().await;
+            let active_ids: HashSet<String> = state
+                .history
+                .raw_items()
+                .filter(|item| matches!(item, ResponseItem::Reasoning { .. }))
+                .filter_map(ResponseItem::id)
+                .map(ToString::to_string)
+                .collect();
+            if !active_ids.contains(&id) {
+                return Ok(false);
+            }
+            let Some(mut recovery) = state.session_configuration.mira_reasoning_recovery.clone()
+            else {
+                return Ok(false);
+            };
+            if !recovery.enabled || recovery.rejected_item_ids.contains(&id) {
+                return Ok(false);
+            }
+            // Completed compaction windows no longer need individual exclusions.
+            recovery
+                .rejected_item_ids
+                .retain(|id| active_ids.contains(id));
+            if recovery.rejected_item_ids.len() >= MAX_REJECTED_ITEMS {
+                return Ok(false);
+            }
+            recovery.rejected_item_ids.push(id);
+            recovery
+        };
+        // A lost/failed write must never allow another model sample. The existing
+        // live-thread writer owns operation UUID reuse, cancellation, and flush.
+        if let Some(live_thread) = self.live_thread() {
+            let mut snapshot = self.thread_settings_snapshot().await;
+            snapshot.mira_reasoning_recovery = Some(recovery.clone());
+            let checkpoint = RolloutItem::EventMsg(EventMsg::ThreadSettingsApplied(
+                ThreadSettingsAppliedEvent {
+                    thread_id: Some(self.thread_id()),
+                    thread_settings: snapshot,
+                },
+            ));
+            let persisted = async {
+                live_thread.append_items(&[checkpoint]).await?;
+                live_thread.flush().await
+            }
+            .await;
+            persisted.map_err(|error| {
+                CodexErr::Fatal(format!(
+                    "Failed to save reasoning recovery before continuing: {error}"
+                ))
+            })?;
+        }
+        self.state
+            .lock()
+            .await
+            .session_configuration
+            .mira_reasoning_recovery = Some(recovery);
+        self.send_event(turn, EventMsg::Warning(WarningEvent {
+            message: "Automatically excluded one rejected reasoning item from model input; continuing this turn. Original history and completed tool results are preserved.".to_string(),
+        })).await;
+        Ok(true)
+    }
+}
+
