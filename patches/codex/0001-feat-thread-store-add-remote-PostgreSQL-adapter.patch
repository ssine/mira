+        retry_state.rate_limit_retries = retry_state.rate_limit_retries.saturating_add(1);
+        retry_state.rate_limit_retry_delay = retry_state
+            .rate_limit_retry_delay
+            .saturating_mul(2)
+            .min(MAX_CONNECTION_RETRY_DELAY);
+        warn!(turn_id = %turn_context.sub_id, error = %err, ?delay,
+            "rate limited; waiting to retry the model request");
+        sess.notify_stream_error(
+            turn_context,
+            format!(
+                "Rate limited; retrying in {}s (attempt {}). Stop to cancel",
+                delay.as_secs().saturating_add(1),
+                retry_state.rate_limit_retries
+            ),
+            err,
+        )
+        .await;
+        codex_client::record_retry!(retry_state.rate_limit_retries, delay, operation);
+        // Chunk unusually long server hints so Instant arithmetic stays bounded.
+        // Cancelling the turn drops this future, including the active sleep.
+        let mut remaining = delay;
+        while !remaining.is_zero() {
+            let chunk = remaining.min(MAX_CONNECTION_RETRY_DELAY);
+            tokio::time::sleep(chunk).await;
+            remaining -= chunk;
+        }
+        return Ok(());
