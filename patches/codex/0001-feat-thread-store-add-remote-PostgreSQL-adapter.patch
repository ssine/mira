index 0000000..28ed006
--- /dev/null
+++ b/codex-rs/core/src/tasks/failure_tests.rs
@@ -0,0 +1,61 @@
+use super::*;
+use crate::session::tests::make_session_and_context_with_rx;
+use pretty_assertions::assert_eq;
+
+struct PanickingTask;
+
+impl SessionTask for PanickingTask {
+    fn kind(&self) -> TaskKind {
+        TaskKind::Regular
+    }
+    fn span_name(&self) -> &'static str {
+        "session_task.panic_test"
+    }
+    async fn run(
+        self: Arc<Self>,
+        _session: Arc<Session>,
+        _ctx: Arc<TurnContext>,
+        _input: Vec<TurnInput>,
+        _cancellation_token: CancellationToken,
+    ) -> SessionTaskResult {
+        panic!("private panic payload must not appear in user-visible error")
+    }
+}
+
+#[tokio::test]
+async fn panic_emits_error_and_completion_for_the_same_turn_and_clears_task() {
+    let (session, context, events) = make_session_and_context_with_rx().await;
+    session
+        .spawn_task(Arc::clone(&context), Vec::new(), PanickingTask)
+        .await;
+    let mut saw_error = false;
+    tokio::time::timeout(Duration::from_secs(10), async {
+        loop {
+            let event = events.recv().await.unwrap();
+            match event.msg {
+                EventMsg::Error(error) => {
+                    assert_eq!(event.id, context.sub_id);
+                    assert!(error.message.contains("internal error"));
+                    assert!(!error.message.contains("private panic payload"));
+                    saw_error = true;
+                }
+                EventMsg::TurnComplete(_) => {
+                    assert!(saw_error);
+                    assert_eq!(event.id, context.sub_id);
+                    break;
+                }
+                _ => {}
+            }
+        }
+    })
+    .await
+    .unwrap();
+    assert!(
+        session
+            .active_turn
+            .lock()
+            .await
+            .as_ref()
+            .is_none_or(|turn| turn.task.is_none())
+    );
+}
