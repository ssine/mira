+
+        assert!(cwd_is_compatible("C:\\Users\\Sine", true));
+        assert!(cwd_is_compatible("C:/Users/Sine", true));
+        assert!(!cwd_is_compatible("/home/sine", true));
+        assert!(cwd_is_compatible("/home/sine", false));
+        assert!(!cwd_is_compatible("C:\\Users\\Sine", false));
+    }
+}
