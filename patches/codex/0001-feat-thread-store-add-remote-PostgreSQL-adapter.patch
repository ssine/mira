+++ b/codex-rs/thread-store/src/remote_http/input_recovery.rs
@@ -0,0 +1,62 @@
+use codex_protocol::models::ResponseItem;
+use codex_rollout::RolloutItem;
+use serde::Deserialize;
+
+use crate::ThreadStoreError;
+use crate::ThreadStoreResult;
+
+/// An administrator-confirmed input projection supplied by the authoritative
+/// store. It applies to a frozen prefix, so newly generated encrypted items are
+/// preserved. The canonical cache and every persistence diff stay untouched.
+#[derive(Clone, Deserialize)]
+#[serde(rename_all = "camelCase")]
+pub(super) struct InputRecovery {
+    pub through_item_seq: usize,
+    pub policy: InputPolicy,
+}
+
+#[derive(Clone, Deserialize)]
+#[serde(rename_all = "camelCase")]
+pub(super) enum InputPolicy {
+    OmitReasoning,
+    RebuildContext,
+}
+
+impl InputRecovery {
+    pub(super) fn project(&self, items: &mut Vec<RolloutItem>) -> ThreadStoreResult<()> {
+        if self.through_item_seq > items.len() {
+            return Err(ThreadStoreError::Conflict {
+                message: "confirmed input recovery exceeds the canonical history".to_string(),
+            });
+        }
+        let mut ordinal = 0;
+        items.retain(|item| {
+            ordinal += 1;
+            if ordinal > self.through_item_seq {
+                return true;
+            }
+            match item {
+                RolloutItem::ResponseItem(envelope) => match &envelope.item {
+                    ResponseItem::Reasoning {
+                        encrypted_content: Some(_),
+                        ..
+                    } => false,
+                    ResponseItem::Compaction { .. } | ResponseItem::ContextCompaction { .. } => {
+                        !matches!(self.policy, InputPolicy::RebuildContext)
+                    }
+                    _ => true,
+                },
+                // The full pre-compaction history is still in PostgreSQL.
+                // Omitting these checkpoints rebuilds context from those
+                // original response items; it never substitutes a lossy summary.
+                RolloutItem::Compacted(_) => !matches!(self.policy, InputPolicy::RebuildContext),
+                _ => true,
+            }
+        });
+        Ok(())
+    }
+}
+
+#[cfg(test)]
+#[path = "input_recovery_tests.rs"]
+mod tests;
