+        let changes = state_changes(&before, &after).expect("diff state");
+        assert_eq!(changes.len(), 1);
+        assert_eq!(changes[0].path, ["sections", "thread"]);
+        assert_eq!(
+            changes[0].expected.value,
+            Some(serde_json::json!(["a", "b"]))
+        );
+        assert_eq!(changes[0].value, Some(serde_json::json!(["a", "c"])));
+        assert_eq!(changes[0].conflict_policy, "compareAndSwap");
+    }
