+    };
+    let message = regex_lite::Regex::new(r"in \d+s")?.replace_all(&error.message, "in <delay>s");
+    insta::assert_snapshot!("http_429_wait", message);
+    test.codex.submit(Op::Interrupt).await?;
+    tokio::time::timeout(
+        Duration::from_secs(3),
+        wait_for_event(&test.codex, |e| matches!(e, EventMsg::TurnAborted(_))),
+    )
+    .await?;
+    Ok(())
+}
