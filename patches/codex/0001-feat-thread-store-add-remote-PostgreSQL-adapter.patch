+    );
+    handle.await.unwrap();
+    let request = requests.recv().await.unwrap().to_lowercase();
+    assert!(request.contains("x-mira-accounts-version: 2"));
+    assert!(
+        requests.recv().await.is_none(),
+        "a provider projection must never write history"
+    );
