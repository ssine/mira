+    assert_eq!(requests.recv().await.unwrap(), first_commit);
+    let _head = requests.recv().await.unwrap();
+    let child_commit = requests.recv().await.unwrap();
+    assert!(child_commit.contains(&format!("\"parent_thread_id\":\"{parent}\"")));
+    assert!(child_commit.contains("\"expectedVersion\":1"));
+    handle.await.unwrap();
