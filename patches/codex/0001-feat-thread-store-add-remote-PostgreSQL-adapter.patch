+                message: format!("failed to serialize remote thread-store state: {err}"),
+            })?;
+        let histories = thread_ids
+            .iter()
+            .filter_map(|thread_id| {
+                state
+                    .histories
+                    .get(thread_id)
+                    .map(|history| (*thread_id, history))
+            })
+            .collect::<HashMap<_, _>>();
+        snapshot
+            .as_object_mut()
+            .ok_or_else(|| ThreadStoreError::Internal {
+                message: "serialized thread-store state is not an object".to_string(),
+            })?
+            .insert(
+                "histories".to_string(),
+                serde_json::to_value(histories).map_err(|err| ThreadStoreError::Internal {
+                    message: format!("failed to serialize selected thread histories: {err}"),
+                })?,
+            );
