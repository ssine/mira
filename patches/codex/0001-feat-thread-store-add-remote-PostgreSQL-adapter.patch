+use codex_app_server_protocol::MiraThreadUnloadParams;
+use codex_app_server_protocol::MiraThreadUnloadResponse;
+
+impl ThreadRequestProcessor {
+    pub(crate) async fn mira_thread_unload(
+        &self,
+        params: MiraThreadUnloadParams,
+    ) -> Result<MiraThreadUnloadResponse, JSONRPCErrorError> {
+        if params.thread_ids.is_empty() || params.thread_ids.len() > 4096 {
+            return Err(invalid_request("invalid thread handoff scope".to_string()));
+        }
+        let root = ThreadId::from_string(&params.thread_id)
+            .map_err(|err| invalid_request(format!("invalid thread id: {err}")))?;
+        let ids = params
+            .thread_ids
+            .iter()
+            .map(|id| ThreadId::from_string(id))
+            .collect::<Result<HashSet<_>, _>>()
+            .map_err(|err| invalid_request(format!("invalid thread id: {err}")))?;
+        let family = self
+            .thread_manager
+            .list_agent_subtree_thread_ids(root)
+            .await
+            .map_err(|err| internal_error(format!("cannot inspect conversation tree: {err}")))?;
+        if !ids.contains(&root) || family.iter().any(|id| !ids.contains(id)) {
+            return Err(invalid_request(
+                "conversation tree changed; reopen the root conversation".to_string(),
+            ));
+        }
+        {
+            let mut pending = self.pending_thread_unloads.lock().await;
+            if ids.iter().any(|id| pending.contains(id)) {
+                return Err(invalid_request(
+                    "conversation teardown is already in progress".to_string(),
+                ));
+            }
+            pending.extend(ids.iter().copied());
+        }
+        // Other threads retain their listeners, tasks, credentials and process.
+        // Never acknowledge removal before both shutdown and durable writes finish.
+        let result = async {
+            let mut loaded = Vec::new();
+            for id in &ids {
+                if let Ok(thread) = self.thread_manager.get_thread(*id).await {
+                    let status = self
+                        .thread_watch_manager
+                        .loaded_status_for_thread(&id.to_string())
+                        .await;
+                    if matches!(thread.agent_status().await, AgentStatus::Running)
+                        || matches!(
+                            status,
+                            codex_app_server_protocol::ThreadStatus::Active { .. }
+                        )
+                    {
+                        return Err(invalid_request(format!(
+                            "对话或子任务 {id} 仍在运行，请等待结束后重试"
+                        )));
+                    }
+                    loaded.push((*id, thread));
+                }
+            }
+            for (id, thread) in &loaded {
+                let state = self.thread_state_manager.thread_state(*id).await;
+                let drain = {
+                    let mut state = state.lock().await;
+                    state
+                        .listener_matches(thread)
+                        .then(|| state.register_shutdown_drain_waiter())
+                };
+                tokio::time::timeout(Duration::from_secs(30), thread.shutdown_and_wait())
+                    .await
+                    .map_err(|_| internal_error(format!("对话 {id} 尚未完成退出，请稍后重试")))?
+                    .map_err(|err| {
+                        internal_error(format!("cannot shut down thread {id}: {err}"))
+                    })?;
+                if let Some(drain) = drain {
+                    tokio::time::timeout(Duration::from_secs(10), drain)
+                        .await
+                        .map_err(|_| {
+                            internal_error(format!("thread {id} shutdown events have not drained"))
+                        })?
+                        .map_err(|_| {
+                            internal_error(format!(
+                                "thread {id} listener closed before shutdown drained"
+                            ))
+                        })?;
+                }
+                self.thread_store
+                    .flush_thread(*id)
+                    .await
+                    .map_err(|err| internal_error(format!("cannot flush thread {id}: {err}")))?;
+                if self
+                    .thread_manager
+                    .remove_thread_if_matches(id, thread)
+                    .await
+                    .is_none()
+                {
+                    return Err(internal_error(format!(
+                        "thread {id} changed during teardown; retry the handoff"
+                    )));
+                }
+                self.outgoing
+                    .cancel_requests_for_thread(*id, /*error*/ None)
+                    .await;
+                self.thread_state_manager.remove_thread_state(*id).await;
+                self.thread_watch_manager
+                    .remove_thread(&id.to_string())
+                    .await;
+                self.outgoing
+                    .send_server_notification(ServerNotification::ThreadClosed(
+                        ThreadClosedNotification {
+                            thread_id: id.to_string(),
+                        },
+                    ))
+                    .await;
+            }
+            Ok(MiraThreadUnloadResponse {
+                thread_ids: params.thread_ids,
+            })
+        }
+        .await;
+        let mut pending = self.pending_thread_unloads.lock().await;
+        for id in &ids {
+            pending.remove(id);
+        }
+        result
+    }
+}
