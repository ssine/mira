@@ -0,0 +1,95 @@
+//! Adapt the upstream graph boundary to the same authoritative remote store as history.
+use codex_agent_graph_store::AgentGraphStore;
+use codex_agent_graph_store::AgentGraphStoreError;
+use codex_agent_graph_store::AgentGraphStoreFuture;
+use codex_agent_graph_store::ThreadSpawnEdgeStatus;
+use codex_protocol::ThreadId;
+use codex_thread_store::RemoteHttpThreadStore;
+use serde::Deserialize;
+use serde_json::json;
+
+pub(super) struct RemoteAgentGraphStore(pub(super) RemoteHttpThreadStore);
+
+#[derive(Deserialize)]
+#[serde(rename_all = "camelCase")]
+struct GraphResponse {
+    thread_ids: Vec<ThreadId>,
+}
+
+fn graph_error(error: impl std::fmt::Display) -> AgentGraphStoreError {
+    AgentGraphStoreError::Internal {
+        message: error.to_string(),
+    }
+}
+
+impl AgentGraphStore for RemoteAgentGraphStore {
+    fn upsert_thread_spawn_edge(
+        &self,
+        parent_thread_id: ThreadId,
+        child_thread_id: ThreadId,
+        status: ThreadSpawnEdgeStatus,
+    ) -> AgentGraphStoreFuture<'_, ()> {
+        Box::pin(async move {
+            self.0
+                .write_agent_graph(
+                    vec![parent_thread_id, child_thread_id],
+                    json!({"operation":"upsert", "parentThreadId":parent_thread_id,
+                        "childThreadId":child_thread_id, "status":status}),
+                )
+                .await
+                .map_err(graph_error)
+        })
+    }
+
+    fn set_thread_spawn_edge_status(
+        &self,
+        child_thread_id: ThreadId,
+        status: ThreadSpawnEdgeStatus,
+    ) -> AgentGraphStoreFuture<'_, ()> {
+        Box::pin(async move {
+            self.0
+                .write_agent_graph(
+                    vec![child_thread_id],
+                    json!({"operation":"status", "childThreadId":child_thread_id, "status":status}),
+                )
+                .await
+                .map_err(graph_error)
+        })
+    }
+
+    fn list_thread_spawn_children(
+        &self,
+        parent_thread_id: ThreadId,
+        status_filter: Option<ThreadSpawnEdgeStatus>,
+    ) -> AgentGraphStoreFuture<'_, Vec<ThreadId>> {
+        self.list("children", parent_thread_id, status_filter)
+    }
+
+    fn list_thread_spawn_descendants(
+        &self,
+        root_thread_id: ThreadId,
+        status_filter: Option<ThreadSpawnEdgeStatus>,
+    ) -> AgentGraphStoreFuture<'_, Vec<ThreadId>> {
+        self.list("descendants", root_thread_id, status_filter)
+    }
+}
+
+impl RemoteAgentGraphStore {
+    fn list(
+        &self,
+        operation: &'static str,
+        parent_thread_id: ThreadId,
+        status_filter: Option<ThreadSpawnEdgeStatus>,
+    ) -> AgentGraphStoreFuture<'_, Vec<ThreadId>> {
+        Box::pin(async move {
+            let mut body = json!({"operation":operation,"parentThreadId":parent_thread_id});
+            if let Some(status) = status_filter {
+                body["status"] = json!(status);
+            }
+            let response = self.0.read_agent_graph(body).await.map_err(graph_error)?;
+            serde_json::from_value::<GraphResponse>(response)
+                .map(|response| response.thread_ids)
+                .map_err(graph_error)
+        })
+    }
+}
