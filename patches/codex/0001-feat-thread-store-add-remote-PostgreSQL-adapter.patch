new file mode 100644
index 0000000..3381cd8
--- /dev/null
+++ b/codex-rs/core/src/tools/plaintext_agent_messages.rs
@@ -0,0 +1,111 @@
+//! Portable agent messages, enabled by default independently of the active provider.
+//! Only the three message-bearing v2 tools change identity. Raw calls and Code Mode
+//! provenance remain intact, and the existing collaboration handlers own execution.
+
+use super::context::ToolInvocation;
+use super::context::ToolPayload;
+use super::registry::CoreToolRuntime;
+use super::registry::ToolExecutor;
+use crate::session::turn_context::TurnContext;
+use codex_features::Feature;
+use codex_tools::ResponsesApiNamespaceTool;
+use codex_tools::ToolExposure;
+use codex_tools::ToolName;
+use codex_tools::ToolSpec;
+use std::sync::Arc;
+
+const NAMESPACE: &str = "mira_collaboration";
+
+fn carries_message(name: &str) -> bool {
+    matches!(name, "spawn_agent" | "send_message" | "followup_task")
+}
+
+pub(super) fn adapt_name(name: ToolName, turn: &TurnContext) -> ToolName {
+    if !carries_message(&name.name)
+        || !(turn.config.features.enabled(Feature::MiraPlaintextContext)
+            || turn.provider.info().plaintext_agent_messages)
+    {
+        return name;
+    }
+    match name.namespace {
+        Some(_) => ToolName::namespaced(NAMESPACE, name.name),
+        None => ToolName::plain(format!("mira_{}", name.name)),
+    }
+}
+
+pub(super) fn is_plaintext_tool(name: &ToolName) -> bool {
+    match name.namespace.as_deref() {
+        Some(NAMESPACE) => carries_message(&name.name),
+        None => name.name.strip_prefix("mira_").is_some_and(carries_message),
+        Some(_) => false,
+    }
+}
+
+pub(super) fn adapt(
+    handler: Arc<dyn CoreToolRuntime>,
+    turn: &TurnContext,
+) -> Arc<dyn CoreToolRuntime> {
+    let name = adapt_name(handler.tool_name(), turn);
+    if name == handler.tool_name() {
+        return handler;
+    }
+    Arc::new(PlaintextAgentMessageTool { handler, name })
+}
+
+struct PlaintextAgentMessageTool {
+    handler: Arc<dyn CoreToolRuntime>,
+    name: ToolName,
+}
+
+impl ToolExecutor<ToolInvocation> for PlaintextAgentMessageTool {
+    fn tool_name(&self) -> ToolName {
+        self.name.clone()
+    }
+
+    fn spec(&self) -> ToolSpec {
+        let mut spec = self.handler.spec();
+        let tool = match &mut spec {
+            ToolSpec::Function(tool) => tool,
+            ToolSpec::Namespace(namespace) => {
+                namespace.name = NAMESPACE.to_string();
+                let [ResponsesApiNamespaceTool::Function(tool)] = namespace.tools.as_mut_slice()
+                else {
+                    unreachable!("agent message runtime must contain one function");
+                };
+                tool
+            }
+            _ => unreachable!("agent message runtime must be a function"),
+        };
+        tool.name.clone_from(&self.name.name);
+        if let Some(message) = tool
+            .parameters
+            .properties
+            .as_mut()
+            .and_then(|properties| properties.get_mut("message"))
+        {
+            message.encrypted = None;
+        }
+        spec
+    }
+
+    fn exposure(&self) -> ToolExposure {
+        self.handler.exposure()
+    }
+
+    fn supports_parallel_tool_calls(&self) -> bool {
+        self.handler.supports_parallel_tool_calls()
+    }
+
+    fn handle<'a>(&'a self, invocation: ToolInvocation) -> codex_tools::ToolExecutorFuture<'a>
+    where
+        ToolInvocation: 'a,
+    {
+        self.handler.handle(invocation)
+    }
+}
+
+impl CoreToolRuntime for PlaintextAgentMessageTool {
+    fn matches_kind(&self, payload: &ToolPayload) -> bool {
+        self.handler.matches_kind(payload)
+    }
+}
