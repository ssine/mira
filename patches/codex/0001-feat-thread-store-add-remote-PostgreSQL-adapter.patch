@@ -0,0 +1,104 @@
+//! Short-lived Node leases replace the idle timer only while memory accounting is healthy.
+use std::collections::HashMap;
+use std::sync::Mutex;
+use std::time::Duration;
+use std::time::Instant;
+
+use codex_app_server_protocol::MiraThreadResidencyCandidate;
+use codex_protocol::ThreadId;
+
+#[derive(Default)]
+pub(crate) struct ThreadResidency(Mutex<State>);
+
+#[derive(Default)]
+struct State {
+    lease: Option<Instant>,
+    revision: u64,
+    owners: HashMap<ThreadId, u64>,
+    idle: HashMap<ThreadId, MiraThreadResidencyCandidate>,
+}
+
+impl ThreadResidency {
+    pub(crate) fn renew(&self) {
+        self.0
+            .lock()
+            .unwrap_or_else(std::sync::PoisonError::into_inner)
+            .lease = Some(Instant::now() + Duration::from_secs(60));
+    }
+
+    pub(crate) fn deadline(&self, idle_deadline: Instant) -> Instant {
+        self.0
+            .lock()
+            .unwrap_or_else(std::sync::PoisonError::into_inner)
+            .lease
+            .map_or(idle_deadline, |lease| lease.max(idle_deadline))
+    }
+
+    pub(crate) fn register(&self, id: ThreadId) -> u64 {
+        let mut state = self
+            .0
+            .lock()
+            .unwrap_or_else(std::sync::PoisonError::into_inner);
+        state.revision += 1;
+        let revision = state.revision;
+        state.owners.insert(id, revision);
+        state.idle.remove(&id);
+        revision
+    }
+
+    pub(crate) fn unregister(&self, id: ThreadId, registration: u64) {
+        let mut state = self
+            .0
+            .lock()
+            .unwrap_or_else(std::sync::PoisonError::into_inner);
+        if state.owners.get(&id) == Some(&registration) {
+            state.owners.remove(&id);
+            state.idle.remove(&id);
+        }
+    }
+
+    pub(crate) fn observe(&self, id: ThreadId, registration: u64, eligible: bool) {
+        let mut state = self
+            .0
+            .lock()
+            .unwrap_or_else(std::sync::PoisonError::into_inner);
+        if state.owners.get(&id) != Some(&registration) {
+            return;
+        }
+        if eligible {
+            state
+                .idle
+                .entry(id)
+                .or_insert_with(|| MiraThreadResidencyCandidate {
+                    thread_id: id.to_string(),
+                    // An old Node response cannot evict a new idle period or replacement process.
+                    revision: uuid::Uuid::new_v4().to_string(),
+                    idle_at: chrono::Utc::now().timestamp(),
+                });
+        } else {
+            state.idle.remove(&id);
+        }
+    }
+
+    pub(crate) fn touch(&self, id: ThreadId) {
+        self.0
+            .lock()
+            .unwrap_or_else(std::sync::PoisonError::into_inner)
+            .idle
+            .remove(&id);
+    }
+
+    pub(crate) fn candidates(&self) -> Vec<MiraThreadResidencyCandidate> {
+        let state = self
+            .0
+            .lock()
+            .unwrap_or_else(std::sync::PoisonError::into_inner);
+        let mut candidates: Vec<_> = state.idle.values().cloned().collect();
+        candidates.sort_by(|a, b| (a.idle_at, &a.revision).cmp(&(b.idle_at, &b.revision)));
+        candidates
+    }
+}
+
