+                attempts.fetch_add(1, Ordering::SeqCst);
+                let body = body.clone();
+                async move {
+                    Err(TransportError::Http {
+                        status: StatusCode::INTERNAL_SERVER_ERROR,
+                        url: None,
+                        headers: None,
+                        body: Some(body),
+                    })
+                }
+            },
+        )
+        .await;
+        let Err(TransportError::Http {
+            status,
+            body: Some(actual),
+            ..
+        }) = result
+        else {
+            panic!("expected original HTTP error");
+        };
+        assert_eq!(
+            (attempts.load(Ordering::SeqCst), status, actual),
+            (1, StatusCode::INTERNAL_SERVER_ERROR, body)
+        );
+    }
+}
+
+#[test]
+fn retry_policy_keeps_transient_errors_and_does_not_match_message_text() {
+    let retry = RetryOn {
+        retry_429: true,
+        retry_5xx: true,
+        retry_transport: true,
+    };
+    for status in [
+        StatusCode::TOO_MANY_REQUESTS,
+        StatusCode::INTERNAL_SERVER_ERROR,
+        StatusCode::BAD_GATEWAY,
+        StatusCode::SERVICE_UNAVAILABLE,
+    ] {
+        for body in [
+            None,
+            Some(r#"{"error":{"code":"server_error","message":"invalid_encrypted_content"}}"#),
+            Some(r#"{"code":"invalid_encrypted_content"}"#),
+            Some(r#"{"error":{"code":500}}"#),
+            Some("invalid_encrypted_content"),
+        ] {
+            let err = TransportError::Http {
+                status,
+                url: None,
+                headers: None,
+                body: body.map(str::to_owned),
+            };
+            assert!(retry.should_retry(&err, /*attempt*/ 0, /*max_attempts*/ 4));
+            assert!(!retry.should_retry(&err, /*attempt*/ 4, /*max_attempts*/ 4));
+        }
+    }
+}
