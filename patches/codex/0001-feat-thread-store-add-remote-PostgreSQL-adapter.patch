+use super::*;
+use pretty_assertions::assert_eq;
+
+#[test]
+fn lease_defers_idle_deadline_and_expiry_restores_it() {
+    let residency = ThreadResidency::default();
+    let idle = Instant::now() - Duration::from_secs(1);
+    assert_eq!(residency.deadline(idle), idle);
+    residency.renew();
+    assert!(residency.deadline(idle) > Instant::now());
+    let expired = Instant::now() - Duration::from_secs(2);
+    residency.0.lock().unwrap().lease = Some(expired);
+    assert_eq!(residency.deadline(idle), idle);
+}
+
+#[test]
+fn stale_listener_and_idle_period_cannot_replace_current_candidate() {
+    let residency = ThreadResidency::default();
+    let id = ThreadId::new();
+    let old = residency.register(id);
+    residency.observe(id, old, /*eligible*/ true);
+    let first = residency.candidates();
+    residency.observe(id, old, /*eligible*/ true);
+    assert_eq!(residency.candidates(), first);
+    residency.observe(id, old, /*eligible*/ false);
+    assert!(residency.candidates().is_empty());
+    residency.observe(id, old, /*eligible*/ true);
+    assert_ne!(residency.candidates(), first);
+    let current = residency.register(id);
+    residency.observe(id, current, /*eligible*/ true);
+    let expected = residency.candidates();
+    residency.observe(id, old, /*eligible*/ true);
+    residency.unregister(id, old);
+    assert_eq!(residency.candidates(), expected);
+    residency.unregister(id, current);
+    assert!(residency.candidates().is_empty());
+}
