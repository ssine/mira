+use super::*;
+use crate::session::tests::make_session_and_context_with_rx;
+use crate::state::ActiveTurn;
+use codex_protocol::AgentPath;
+use codex_protocol::protocol::InterAgentCommunication;
+use pretty_assertions::assert_eq;
+
+#[tokio::test]
+async fn input_recovery_cannot_replace_an_active_or_queued_parent_task() {
+    let (session, _, _events) = make_session_and_context_with_rx().await;
+    *session.active_turn.lock().await = Some(ActiveTurn::default());
+    assert_eq!(
+        recover(&session, "failed".into(), "decision".into(), "retry".into())
+            .await
+            .unwrap(),
+        TurnInputSubmission::NotSubmitted {
+            reason: NotSubmittedReason::NotIdle
+        },
+    );
+    session.active_turn.lock().await.take();
+    session
+        .input_queue
+        .enqueue_mailbox_communication(
+            InterAgentCommunication::new(
+                AgentPath::root(),
+                AgentPath::try_from("/root/worker").unwrap(),
+                Vec::new(),
+                "new parent task".into(),
+                /*trigger_turn*/ true,
+            ),
+            Default::default(),
+        )
+        .await;
+    assert_eq!(
+        recover(&session, "failed".into(), "decision".into(), "retry".into())
+            .await
+            .unwrap(),
+        TurnInputSubmission::NotSubmitted {
+            reason: NotSubmittedReason::PendingTriggerTurn
+        },
+    );
+    assert!(session.input_queue.has_trigger_turn_mailbox_items().await);
+    assert!(session.active_turn.lock().await.is_none());
+}
