+#[tokio::test]
+async fn memory_eviction_protects_family_with_running_child() -> Result<()> {
+    use core_test_support::responses;
+    use wiremock::Mock;
+    use wiremock::ResponseTemplate;
+    use wiremock::matchers::body_string_contains;
+    use wiremock::matchers::method;
+    use wiremock::matchers::path;
+
+    let server = responses::start_mock_server().await;
+    responses::mount_sse_once_match(
+        &server,
+        |request: &wiremock::Request| {
+            let body = String::from_utf8_lossy(&request.body);
+            body.contains("spawn residency worker") && !body.contains("residency-spawn-call")
+        },
+        responses::sse(vec![
+            responses::ev_response_created("spawn"),
+            responses::ev_function_call_with_namespace(
+                "residency-spawn-call",
+                "collaboration",
+                "spawn_agent",
+                r#"{"task_name":"worker","message":"residency child work","fork_turns":"none"}"#,
+            ),
+            responses::ev_completed("spawn"),
+        ]),
+    )
+    .await;
+    responses::mount_sse_once_match(
+        &server,
+        |request: &wiremock::Request| {
+            String::from_utf8_lossy(&request.body).contains("residency-spawn-call")
+        },
+        responses::sse(vec![
+            responses::ev_response_created("parent-done"),
+            responses::ev_assistant_message("parent-msg", "Waiting for worker."),
+            responses::ev_completed("parent-done"),
+        ]),
+    )
+    .await;
+    Mock::given(method("POST"))
+        .and(path("/v1/responses"))
+        .and(body_string_contains("residency child work"))
+        .and(|request: &wiremock::Request| {
+            !String::from_utf8_lossy(&request.body).contains("residency-spawn-call")
+        })
+        .respond_with(
+            ResponseTemplate::new(200)
+                .insert_header("content-type", "text/event-stream")
+                .set_body_string(responses::sse(vec![responses::ev_completed("child-done")]))
+                .set_delay(Duration::from_secs(60)),
+        )
+        .with_priority(1)
+        .mount(&server)
+        .await;
+    let home = TempDir::new()?;
+    MockResponsesConfig::new(&server.uri())
+        .with_model("gpt-5.4")
+        .with_sandbox_mode("danger-full-access")
+        .with_extra_config("[features.multi_agent_v2]\nenabled = true")
+        .write(home.path())?;
+    app_test_support::write_models_cache(home.path()).await?;
+    let mut client = TestAppServer::builder()
+        .with_codex_home(home.path())
+        .build_initialized()
+        .await?;
+    let root = client
+        .start_thread(ThreadStartParams::default())
+        .await?
+        .thread
+        .id;
+    let _: TurnStartResponse = client
+        .request(|request_id| ClientRequest::TurnStart {
+            request_id,
+            params: TurnStartParams {
+                thread_id: root.clone(),
+                input: vec![UserInput::Text {
+                    text: "spawn residency worker".into(),
+                    text_elements: Vec::new(),
+                }],
+                ..Default::default()
+            },
+        })
+        .await?;
+    let child = tokio::time::timeout(Duration::from_secs(10), async {
+        loop {
+            let loaded: ThreadLoadedListResponse = client
+                .request(|request_id| ClientRequest::ThreadLoadedList {
+                    request_id,
+                    params: ThreadLoadedListParams::default(),
+                })
+                .await?;
+            if let Some(child) = loaded.data.iter().find(|id| *id != &root) {
+                let read: ThreadReadResponse = client
+                    .request(|request_id| ClientRequest::ThreadRead {
+                        request_id,
+                        params: ThreadReadParams {
+                            thread_id: child.clone(),
+                            include_turns: false,
+                        },
+                    })
+                    .await?;
+                if matches!(read.thread.status, ThreadStatus::Active { .. }) {
+                    break Ok::<_, anyhow::Error>(child.clone());
+                }
+            }
+            tokio::time::sleep(Duration::from_millis(20)).await;
+        }
+    })
+    .await??;
+    // An unrelated idle root remains reclaimable while the worker is running.
+    let unrelated = client
+        .start_thread(ThreadStartParams::default())
+        .await?
+        .thread
+        .id;
+    for id in [&root, &child, &unrelated] {
+        let _: ThreadUnsubscribeResponse = client
+            .request(|request_id| ClientRequest::ThreadUnsubscribe {
+                request_id,
+                params: ThreadUnsubscribeParams {
+                    thread_id: id.clone(),
+                },
+            })
+            .await?;
+    }
+    tokio::time::sleep(Duration::from_millis(50)).await;
+    let candidate = residency(&mut client, None)
+        .await?
+        .oldest
+        .expect("unrelated idle root");
+    assert_eq!(candidate.thread_id, unrelated);
+    assert!(
+        residency(&mut client, Some(candidate))
+            .await?
+            .eviction_scheduled
+    );
+    assert_eq!(residency(&mut client, None).await?.oldest, None);
+    Ok(())
+}
