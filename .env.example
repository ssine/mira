# Pin a released unified Mira image in production instead of following latest.
MIRA_VERSION=1.0.3

# Mira does not own or update PostgreSQL. Use a separately backed-up database.
DATABASE_URL=postgresql://mira:replace-with-a-long-random-password@postgres.example.internal:5432/mira

# Public HTTPS origin received by remote Node/Codex clients through Caddy.
MIRA_CODEX_STORE_ENDPOINT=https://mira.example.com
