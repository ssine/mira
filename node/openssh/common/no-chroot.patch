+int
+mira_same_identity(void)
+{
+	const char *enabled = getenv("MIRA_OPENSSH_SAME_IDENTITY");
+
+	return enabled != NULL && strcmp(enabled, "1") == 0;
+}
+
+/* Construct display/session metadata without looking up another OS account.
+ * The kernel credentials of the Node worker remain authoritative. */
+struct passwd *
+mira_same_identity_passwd(const char *requested)
+{
+	const char *username, *home, *shell;
+	struct passwd *pw;
+
+	if (!mira_same_identity())
+		return NULL;
+	username = getenv("MIRA_OPENSSH_USERNAME");
+	home = getenv("MIRA_OPENSSH_HOME");
+	shell = getenv("MIRA_OPENSSH_SHELL");
+	if (username == NULL || *username == '\0' || home == NULL ||
+	    *home != '/' || shell == NULL || *shell != '/')
+		fatal("invalid Mira same-identity account environment");
+	if (getuid() != geteuid() || getgid() != getegid())
+		fatal("Mira same-identity worker has mismatched credentials");
+	if (strcmp(requested, username) != 0)
+		return NULL;
+	pw = xcalloc(1, sizeof(*pw));
+	pw->pw_name = xstrdup(username);
+	pw->pw_passwd = xstrdup("*");
+	pw->pw_uid = getuid();
+	pw->pw_gid = getgid();
+#ifdef HAVE_STRUCT_PASSWD_PW_GECOS
+	pw->pw_gecos = xstrdup("");
+#endif
+#ifdef HAVE_STRUCT_PASSWD_PW_CLASS
+	pw->pw_class = xstrdup("");
+#endif
+	pw->pw_dir = xstrdup(home);
+	pw->pw_shell = xstrdup(shell);
+	return pw;
+}
+
+/* Mira authorizes only the identity that already owns the Node process. */
+int
+mira_same_uid(struct passwd *pw)
+{
+	return mira_same_identity() && getuid() == pw->pw_uid &&
+	    geteuid() == pw->pw_uid && getgid() == pw->pw_gid &&
+	    getegid() == pw->pw_gid;
+}
